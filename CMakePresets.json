{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows — newest installed Visual Studio, x64",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos",
      "displayName": "macOS — Ninja, Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux",
      "displayName": "Linux — Ninja, Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-core",
      "displayName": "Windows — engine and tests only (no Slint, no Rust toolchain needed)",
      "inherits": "windows-msvc",
      "cacheVariables": { "TAKT4_BUILD_UI": "OFF" }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows — AddressSanitizer over the whole tree",
      "inherits": "windows-msvc",
      "cacheVariables": { "TAKT4_SANITIZE": "address" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux — AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TAKT4_SANITIZE": "address+undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux — ThreadSanitizer (the audio, output and UI threads)",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TAKT4_SANITIZE": "thread"
      }
    },
    {
      "name": "macos-core",
      "displayName": "macOS — engine and tests only (no Slint, no Rust toolchain needed)",
      "inherits": "macos",
      "cacheVariables": { "TAKT4_BUILD_UI": "OFF" }
    },
    {
      "name": "linux-core",
      "displayName": "Linux — engine and tests only (no Slint, no Rust toolchain needed)",
      "inherits": "linux",
      "cacheVariables": { "TAKT4_BUILD_UI": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Release" },
    { "name": "macos-core", "configurePreset": "macos-core" },
    { "name": "linux-core", "configurePreset": "linux-core" },
    { "name": "windows-asan", "configurePreset": "windows-asan", "configuration": "Release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    { "name": "macos", "configurePreset": "macos", "output": { "outputOnFailure": true } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    {
      "name": "windows-core",
      "configurePreset": "windows-core",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    { "name": "macos-core", "configurePreset": "macos-core", "output": { "outputOnFailure": true } },
    { "name": "linux-core", "configurePreset": "linux-core", "output": { "outputOnFailure": true } },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    { "name": "linux-asan", "configurePreset": "linux-asan", "output": { "outputOnFailure": true } },
    { "name": "linux-tsan", "configurePreset": "linux-tsan", "output": { "outputOnFailure": true } }
  ]
}
