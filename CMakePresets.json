{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows — newest installed Visual Studio, x64",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos",
      "displayName": "macOS — Ninja, Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux",
      "displayName": "Linux — Ninja, Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-core",
      "displayName": "Windows — engine and tests only (no Slint, no Rust toolchain needed)",
      "inherits": "windows-msvc",
      "cacheVariables": { "TAKT4_BUILD_UI": "OFF" }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows — AddressSanitizer over the whole tree",
      "inherits": "windows-msvc",
      "cacheVariables": { "TAKT4_SANITIZE": "address" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux — AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TAKT4_SANITIZE": "address+undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux — ThreadSanitizer (the audio, output and UI threads)",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TAKT4_SANITIZE": "thread"
      }
    },
    {
      "name": "macos-core",
      "displayName": "macOS — engine and tests only (no Slint, no Rust toolchain needed)",
      "inherits": "macos",
      "cacheVariables": { "TAKT4_BUILD_UI": "OFF" }
    },
    {
      "name": "linux-core",
      "displayName": "Linux — engine and tests only (no Slint, no Rust toolchain needed)",
      "inherits": "linux",
      "cacheVariables": { "TAKT4_BUILD_UI": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Release" },
    { "name": "macos-core", "configurePreset": "macos-core" },
    { "name": "linux-core", "configurePreset": "linux-core" },
    { "name": "windows-asan", "configurePreset": "windows-asan", "configuration": "Release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" }
  ],
  "testPresets": [
    {
      "name": "off-rig",
      "hidden": true,
      "description": "Leaves out the tests tagged [network] (Link, real sockets) and [hardware] (the audio interface and MIDI devices themselves), and gives the test binaries no ASIO: running these while Resolume or Live is up disturbs them (the audit's T2).",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^(network|hardware)$" } }
    },
    {
      "name": "all-tests",
      "hidden": true,
      "description": "Every test, on the network and the audio interface too. Close Resolume and Live first.",
      "output": { "outputOnFailure": true },
      "environment": { "TAKT4_TEST_HARDWARE": "1" }
    },
    { "name": "windows-msvc", "inherits": "off-rig", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-all", "inherits": "all-tests", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-debug", "inherits": "off-rig", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "windows-msvc-debug-all", "inherits": "all-tests", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "macos", "inherits": "off-rig", "configurePreset": "macos" },
    { "name": "macos-all", "inherits": "all-tests", "configurePreset": "macos" },
    { "name": "linux", "inherits": "off-rig", "configurePreset": "linux" },
    { "name": "linux-all", "inherits": "all-tests", "configurePreset": "linux" },
    { "name": "windows-core", "inherits": "off-rig", "configurePreset": "windows-core", "configuration": "Release" },
    { "name": "windows-core-all", "inherits": "all-tests", "configurePreset": "windows-core", "configuration": "Release" },
    { "name": "macos-core", "inherits": "off-rig", "configurePreset": "macos-core" },
    { "name": "macos-core-all", "inherits": "all-tests", "configurePreset": "macos-core" },
    { "name": "linux-core", "inherits": "off-rig", "configurePreset": "linux-core" },
    { "name": "linux-core-all", "inherits": "all-tests", "configurePreset": "linux-core" },
    { "name": "windows-asan", "inherits": "off-rig", "configurePreset": "windows-asan", "configuration": "Release" },
    { "name": "windows-asan-all", "inherits": "all-tests", "configurePreset": "windows-asan", "configuration": "Release" },
    { "name": "linux-asan", "inherits": "off-rig", "configurePreset": "linux-asan" },
    { "name": "linux-asan-all", "inherits": "all-tests", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "inherits": "off-rig", "configurePreset": "linux-tsan" },
    { "name": "linux-tsan-all", "inherits": "all-tests", "configurePreset": "linux-tsan" }
  ]
}
