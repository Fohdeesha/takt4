# Our own files are LF everywhere, whatever the platform's git defaults say.
* text=auto eol=lf

# The Steinberg ASIO SDK is committed byte-identical to the package it came from
# (CRLF and all), so it can be diffed against a fresh download.
third_party/asiosdk/** -text

*.pdf binary
*.png binary

# Golden test data (tests/data): audio excerpts and the numpy matrices computed from them.
*.wav binary
*.npy binary

# Converted model weights (assets/weights), written by tools/convert_weights.py.
*.bin binary

# The fonts the windows are set in (assets/fonts), embedded in takt4.exe.
*.ttf binary
