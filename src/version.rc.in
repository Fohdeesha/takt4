// The version resource: what Explorer's Properties > Details and a crash report's module list
// show for @TAKT4_RC_FILE@. Generated by CMake from src/version.rc.in; do not edit the copy.
//
// The audit found none, which made a crash from the field harder to place. FileVersion is the
// release number; ProductVersion is the commit, from `git describe --tags --dirty` written on
// every build (cmake/git_describe.cmake), so a binary says what it was built from even with
// no PDB beside it.

#include <winver.h>

#include "core/git_describe.hpp"

// takt4's icon: what Explorer shows for the file, and a shortcut or the taskbar for the program.
// The windows set their own as well (`icon` in src/ui/*.slint). From tools/make_icon.py.
1 ICON "@TAKT4_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "takt4"
            VALUE "FileDescription", "@TAKT4_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@TAKT4_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Jon Sands. Free software under the GNU GPL v3."
            VALUE "OriginalFilename", "@TAKT4_RC_FILE@"
            VALUE "ProductName", "takt4"
            VALUE "ProductVersion", TAKT4_GIT_DESCRIBE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
