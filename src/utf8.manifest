<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The process's ANSI code page is UTF-8 (Windows 10 1903 and later; ignored before).

  Everything takt4 hands to the window must be UTF-8, and a good deal of it arrives through
  the ANSI side of the Windows API: an ASIO driver's name and its channel names (PortAudio's
  ASIO host reads the registry with the A functions), RtMidi's port names, argv in the
  console, and std::filesystem::path::string(). Under the machine's legacy code page those
  come back as bytes that are not UTF-8, or, for a character the code page lacks, as '?' or a
  throw. With this they come back as UTF-8, so a driver whose name has an accent matches the
  name a settings file remembers, and takt4-cli can open a WAV whose name is not in the code
  page.

  io::validUtf8 and io::pathText still stand guard at the window's edge, for older Windows
  and for text that never went through the code page at all.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
