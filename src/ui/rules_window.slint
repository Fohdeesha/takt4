// The rule editor — HANDOFF §5.9's second half and Phase 6's exit criterion — in the Weltformat-dark
// look the operator locked on 2026-09-30 (HANDOFF §0.5, "The rule editor — locked"; the pictures
// are design/weltformat-dark/rules17.html and png/r17-*.png, and every size here is measured off
// them).
//
// §8: "A rule that fires a non-repeating random clip on every fourth downbeat can be built
// entirely by clicking, in under a minute, by someone who has not read the docs."
//
// **A window of its own**, by the user's call on 2026-09-06: the tracker and the rules are watched
// at the same time, and one screen holding both means either can be on a second monitor.
//
// **Master and detail**: the list of rules down the left, the one being edited on the right as four
// sheets that fold — A when, B only if, C send, D then send — and under both, the window's full
// width, the event log, folded to start. A card per rule reads beautifully at three rules and not
// at twenty.
//
// Nothing here talks to the trigger engine. `ui::RulesController` owns the rules, edits its own
// copy and posts the set whole — see its header for why the runner's copy cannot be the one being
// edited. **And nothing here sets its own value**: every control is weltformat.slint's, which says
// what the operator asked for and shows what the controller then holds (see that file). So no row
// of this window is ever built again to catch up with its model.

import { Btn, Count, Dashes, Entry, FoldArrow, Keycap, Pick, Reading, Scroller, Tick, Track, Wf } from "weltformat.slint";
import { FocusSink } from "theme.slint";
import { Band, Heading, Mark, Note, RowLabel, Section, Word } from "editor_parts.slint";

/// One row of the rule list. Everything the list shows without the editor being open.
export struct RuleRow {
  name: string,
  enabled: bool,
  /// Empty when the rule is fine; otherwise `Rule::problem()`, which is why it will not fire.
  /// §5.8's policy is that an invalid rule is held and shown rather than refused.
  problem: string,
  fires: int,
  /// Whether this row is part of the selection — which is a *set*, so that duplicating and
  /// deleting can act on several rules at once (ctrl-click, shift-click). The editor shows one of
  /// them, `RulesWindow::selected`; this is all of them.
  chosen: bool,
  /// §5.7's live per-rule mute, which the row's dot shows and switches: filled while the rule
  /// sends, a ring while it is muted (HANDOFF §0.5).
  muted: bool,
}

/// One editable `{...}` of the address, or the rule's value, or its MIDI note number — whatever
/// a `trigger::Generator` fills in. §5.9: "Template segments render as editable chips". Inline, as
/// bands under the address, each labelled with the placeholder it fills: a popover would hide the
/// one thing an operator is comparing against, the other segments of the same address.
export struct SlotRow {
  /// `{C}` for an address segment, "value" for the argument, "note" for MIDI.
  label: string,
  kind-index: int,
  /// Whether this generator draws from a range or from a list — only meaningful for shuffle,
  /// random and cycle, and hidden for the rest.
  takes-pool: bool,
  is-list: bool,
  low: int,
  high: int,
  /// The list as an operator writes it: "3, 7, 1, 12". Parsed leniently on the way in.
  values: string,
  no-repeat: int,
  /// `Fixed`'s literal, shown only for that kind.
  fixed: string,
  is-fixed: bool,
  /// A MIDI note or controller nobody has chosen yet: the box is empty and asks for one, and the
  /// rule does not fire until it has it (`Rule::Config::numberChosen`).
  wanting: bool,
  /// `Live`'s "BPM normalised", and the tempo range it maps onto 0 to 1 — "20 - 500", Resolume's.
  is-normalised: bool,
  normalise: string,
  /// `Weighted`, and its values with their weights — "7:3, 12:1".
  is-weighted: bool,
  weights: string,
  is-live: bool,
  live-index: int,
  /// `Ramp`'s shape and period. A ramp has a range and no pool, so it borrows `low`/`high` above
  /// and adds these.
  is-ramp: bool,
  shape-index: int,
  ramp-bars: int,
  ramp-float: bool,
  /// What this slot last produced, so an operator can see a sequence advancing.
  last: string,
  /// Whether this slot is a **color** — the one generator whose value nobody can read as text,
  /// so it gets a swatch and a picker where every other slot gets a box.
  is-color: bool,
  /// The color that slot is currently set to, for the swatch.
  swatch: color,
  /// And the same color as hue, saturation and value, which is what the picker's three sliders
  /// move. Held apart from `swatch` because a grey has no hue to read back out of it — see
  /// `dmx::toHsv` — so the picker would jump to red the moment the saturation reached zero.
  hue: float,
  sat: float,
  val: float,
  /// The value of an OSC rule, whose band carries the "send a value" tick (HANDOFF §0.5).
  is-osc-value: bool,
}

/// One color of a palette — `trigger::DmxSend::color`'s list, one entry. Its own model rather than
/// a field of `SlotRow`, because a repeater nested inside another repeater's struct is not a thing
/// Slint models do; `RulesWindow::palette` is the list and `palette-shown` says whether the rule in
/// front of the operator has one.
export struct PaletteEntry {
  swatch: color,
  /// The same color as text, for the box in the picker — how a color gets pasted in.
  hex: string,
  /// The picker's three sliders, held rather than re-derived for the reason `SlotRow::hue` gives.
  hue: float,
  sat: float,
  val: float,
}

/// One of the messages a rule sends *after* the one it fired — `trigger::FollowUp`. A rig asked for
/// what one "then send" value could not say — a note on to start a laser clip and a real note off
/// to stop it, from the one trigger — so each entry says *what* it sends as well as when.
export struct FollowRow {
  /// 0 is "release"; 1 and up index the kinds the rule's own send kind allows, which is what
  /// `RulesWindow::follow-kinds` holds. See `RulesController::followKinds_`.
  kind-index: int,
  /// Whether this entry puts a note or controller number of its own on the wire. False for a
  /// release, which inherits the number that fired — the whole point of one.
  takes-number: bool,
  /// What that number *is* on this kind — "note", "cc", "program".
  number-label: string,
  number: int,
  /// False for a program change, which has nowhere to put a value.
  takes-value: bool,
  /// And what the value *is* — "velocity", "bend", "value". *"theres an unlabled box next to it
  /// with 0 in the field? wtf is that?"* — a release velocity, and now it says so.
  value-label: string,
  value: string,
  /// 0 ms, 1 beats, 2 bars — `trigger::DelayUnit`.
  unit: int,
  /// The delay in whichever unit `unit` names; the controller keeps both numbers.
  delay: string,
  /// What this entry will really send, in words: "note off, same note".
  summary: string,
}

/// One line of the "send to" list, or of the "lights" list: an output (or a fixture, or a group)
/// this rule may be aimed at, and whether it is. The rig already knows what it has, so the list is
/// the rig's and the operator only ticks.
export struct OutputChoice {
  /// What the rule holds for this line and what a tick sends back: an id, or a group's label.
  /// Never shown — the name below is, and can change without moving this.
  key: string,
  name: string,
  chosen: bool,
  /// Held by the rule but reaching nothing here — since deleted, or a kind this rule cannot reach.
  /// Kept and shown rather than quietly dropped; it can be ticked off, not back.
  missing: bool,
}

/// One line of the event log: when, which rule, what went out — in three columns rather than one
/// string (HANDOFF §0.5), and whether it was muted, which is drawn apart.
export struct LogLine {
  when: string,
  rule: string,
  message: string,
  muted: bool,
}

/// What a slot last produced, in green at the end of its band: "→ 7". **With an arrow**, because a
/// bare value at the end of a row of settings reads as another setting — and the arrow is drawn,
/// 8 px long as the approved picture has it: Chivo Mono has no "→", and the one a fallback face
/// lends is a full em.
component Produced inherits HorizontalLayout {
  in property <string> value;

  horizontal-stretch: 0;
  spacing: 6px;

  VerticalLayout {
    alignment: center;
    Path {
      width: 8px;
      height: 6px;
      viewbox-width: 8;
      viewbox-height: 6;
      commands: "M 0 3 L 7.2 3 M 4.6 0.6 L 7.2 3 L 4.6 5.4";
      stroke: Wf.locked;
      stroke-width: 1.3px;
    }
  }
  Text {
    text: root.value;
    color: Wf.locked;
    font-family: Wf.code;
    font-size: 14px;
    vertical-alignment: center;
  }
}

/// One rule in the list: its dot — which is its mute switch — its name, and at the right its count,
/// "muted", or, on a picked row and the row under the pointer, copy and delete. A rule that will not
/// fire says why under its name, in amber, wrapping (HANDOFF §0.5).
component RuleLine inherits Rectangle {
  in property <RuleRow> entry;
  /// The one the editor is showing, which is edged; every chosen row is lit.
  in property <bool> shown;
  /// A click with its modifiers, on the down edge, where every list an operator has used selects.
  callback pressed(bool, bool);
  callback mute-clicked(bool);
  callback copy-clicked();
  callback kill-clicked();

  // All four hovers, or moving onto a mark would take the hover off the row and the mark with it.
  private property <bool> showing: root.entry.chosen || pick.has-hover || dot-touch.has-hover
    || copy-mark.has-hover || kill-mark.has-hover;
  private property <color> dot-color: !root.entry.enabled ? Wf.dot-off
    : root.entry.problem != "" ? Wf.holding : Wf.locked;

  height: root.entry.problem == "" ? 42px : 37px + why.preferred-height + 7px;
  background: root.entry.chosen ? Wf.row-picked : transparent;
  border-width: root.shown && root.entry.chosen ? 2px : 0px;
  border-color: Wf.edge;

  // **First, so it is underneath the dot and the marks**: a later sibling takes the pointer, and a
  // row-wide area declared after them would swallow every click on them.
  pick := TouchArea {
    pointer-event(event) => {
      if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
        root.pressed(event.modifiers.control, event.modifiers.shift);
      }
    }
  }

  // The dot: 14 px in a 28 px target that lights under the pointer. Filled while the rule sends, a
  // 2.5 px ring while it is muted; its colour says ready, switched off, or will not fire.
  dot-target := Rectangle {
    x: 3px;
    y: 7px;
    width: 28px;
    height: 28px;
    background: dot-touch.has-hover ? Wf.face-hover : transparent;

    Rectangle {
      x: 7px;
      y: 7px;
      width: 14px;
      height: 14px;
      border-radius: 7px;
      background: root.entry.muted ? transparent : root.dot-color;
      border-width: root.entry.muted ? 2.5px : 0px;
      border-color: root.dot-color;
    }

    dot-touch := TouchArea {
      clicked => {
        root.mute-clicked(!root.entry.muted);
      }
    }
  }

  name := Text {
    x: 35px;
    y: 7px;
    width: parent.width - self.x - 9px - (root.showing ? 48px : right.preferred-width + (right.text == "" ? 0px : 4px));
    height: 28px;
    text: root.entry.name == "" ? "(unnamed)" : root.entry.name;
    color: root.entry.enabled ? Wf.ink : Wf.ink-off;
    font-size: 14px;
    vertical-alignment: center;
    overflow: elide;
  }

  // At rest, the count — or "muted", which is the more useful thing to know about a muted rule.
  right := Text {
    x: parent.width - 9px - self.width;
    y: 7px;
    width: self.preferred-width;
    height: 28px;
    visible: !root.showing;
    text: root.entry.muted ? "muted" : root.entry.fires > 0 ? "" + root.entry.fires : "";
    color: Wf.ink2;
    font-family: root.entry.muted ? Wf.sans : Wf.code;
    font-size: 13px;
    vertical-alignment: center;
  }

  copy-mark := Mark {
    x: parent.width - 9px - 44px;
    y: 11px;
    copy: true;
    visible: root.showing;
    clicked => {
      root.copy-clicked();
    }
  }
  kill-mark := Mark {
    x: parent.width - 9px - 20px;
    y: 11px;
    visible: root.showing;
    clicked => {
      root.kill-clicked();
    }
  }

  // Why it will not fire, under the name, wrapping: a colour is not a reason.
  why := Text {
    x: 35px;
    y: 37px;
    width: parent.width - self.x - 9px;
    visible: root.entry.problem != "";
    text: root.entry.problem == "" ? "" : "will not fire: " + root.entry.problem;
    color: Wf.holding;
    font-size: 13px;
    wrap: word-wrap;
    // 17 px a line, as the approved picture sets it (CSS 1.3); Slint's own is 14.5 at 13 px.
    line-height-factor: 1.17;
  }
}

/// A closed list that opens a popup of ticks — the "send to" routing and the "lights" — and stays
/// open while ticking: a list that closed on the first tick would make three outputs three trips.
/// Laid out as a dropdown is, and opened as the main window's dropdown list opens: the sheet's
/// colour, a 1 px off-white edge, 30 px rows, 16 px ticks with 15 px words, the row under the
/// pointer filled off-white with dark text (HANDOFF §0.5).
component ChoiceField inherits Rectangle {
  in property <[OutputChoice]> choices;
  /// What the closed control says: "every output", "deck, old deck", "heads, lasers".
  in property <string> summary;
  in property <bool> enabled: true;
  /// Edged amber: a lighting rule that names no fixture, which reaches nothing.
  in property <bool> warn;
  /// The routing list's first row: "every output", a state rather than a tick — naming nothing is
  /// what reaching everything is — and whether it holds.
  in property <bool> all-row;
  in property <bool> all-ticked;
  /// The lights list's first line: "reaches 2 fixtures".
  in property <string> head-note;
  /// The lights list's last line: a divider and "none".
  in property <bool> none-row;
  /// Said in the list when it has nothing in it.
  in property <string> empty-note;
  out property <bool> open: list.is-open;
  callback chosen(string, bool);
  callback all-chosen();
  callback none-chosen();

  private property <length> row-height: 30px;
  private property <int> rows-shown: min(12, root.choices.length);

  height: 34px;
  horizontal-stretch: 0;
  background: root.enabled ? Wf.field : Wf.field-off;
  border-width: root.enabled ? 1px : 0px;
  border-color: root.warn ? Wf.holding : list.is-open || touch.has-hover ? Wf.edge : Wf.field-edge;

  if !root.enabled: Dashes {
    width: 100%;
    height: 100%;
    thickness: 1px;
    ink: Wf.off-edge;
  }

  Text {
    x: 10px;
    width: parent.width - 42px;
    height: parent.height;
    text: root.summary;
    color: root.enabled ? Wf.ink : Wf.ink-off;
    font-size: 15px;
    vertical-alignment: center;
    overflow: elide;
  }
  if root.enabled: Path {
    x: parent.width - 12px - self.width;
    y: (parent.height - self.height) / 2;
    width: 11px;
    height: 7px;
    viewbox-width: 11;
    viewbox-height: 7;
    commands: list.is-open ? "M 1 6 L 5.5 1.5 L 10 6" : "M 1 1 L 5.5 5.5 L 10 1";
    stroke: Wf.ink;
    stroke-width: 2px;
    stroke-line-cap: LineCap.square;
  }

  sink := FocusSink { }
  touch := TouchArea {
    enabled: root.enabled;
    mouse-cursor: pointer;
    clicked => {
      sink.take();
      list.show();
    }
  }

  list := PopupWindow {
    x: 0;
    y: root.height + 2px;
    width: max(root.width, 260px);
    close-policy: close-on-click-outside;
    forward-focus: list-keys;

    // Escape closes the list and goes no further: in this window it is PANIC.
    list-keys := FocusScope {
      key-pressed(event) => {
        if (event.text == Key.Escape) {
          list.close();
        }
        return accept;
      }

      Rectangle {
        background: Wf.sheet;
        border-width: 1px;
        border-color: Wf.edge;

        VerticalLayout {
          padding: 1px;
          spacing: 0px;

          if root.all-row: Rectangle {
            height: root.row-height;
            background: all-touch.has-hover ? Wf.ink : transparent;
            HorizontalLayout {
              padding-left: 10px;
              padding-right: 10px;
              spacing: 8px;
              // A state, not a tick box: ticked while the rule names nothing.
              Rectangle {
                width: 16px;
                if root.all-ticked: Path {
                  x: 3px;
                  y: (parent.height - 12px) / 2;
                  width: 10px;
                  height: 12px;
                  viewbox-width: 10;
                  viewbox-height: 12;
                  commands: "M 1 6.5 L 4 9.5 L 9 2";
                  stroke: all-touch.has-hover ? Wf.on-primary : Wf.ink;
                  stroke-width: 2.5px;
                  stroke-line-cap: LineCap.square;
                }
              }
              Text {
                text: "every output";
                color: all-touch.has-hover ? Wf.on-primary : Wf.ink;
                font-size: 15px;
                vertical-alignment: center;
                horizontal-stretch: 1;
              }
            }
            all-touch := TouchArea {
              clicked => {
                root.all-chosen();
              }
            }
          }
          if root.all-row: Rectangle {
            height: 7px;
            Rectangle {
              y: 3px;
              height: 1px;
              background: Wf.line;
            }
          }

          if root.head-note != "": Text {
            height: root.row-height;
            text: root.head-note;
            color: Wf.ink2;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
          }

          if root.choices.length == 0 && root.empty-note != "": Text {
            height: root.row-height;
            text: root.empty-note;
            color: Wf.ink2;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
          }

          Flickable {
            height: root.rows-shown * root.row-height;
            content-width: self.width;
            content-height: root.choices.length * root.row-height;
            VerticalLayout {
              spacing: 0px;
              for choice[i] in root.choices: Rectangle {
                height: root.row-height;
                background: row-touch.has-hover ? Wf.ink : transparent;
                private property <color> ink: row-touch.has-hover ? Wf.on-primary : Wf.ink;

                // The tick, drawn as the main window's 16 px one is, in whatever ink the row has.
                Rectangle {
                  x: 10px;
                  y: (parent.height - self.height) / 2;
                  width: 16px;
                  height: 16px;
                  border-width: 2px;
                  border-color: parent.ink;
                  background: choice.chosen ? parent.ink : transparent;
                  if choice.chosen: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 20;
                    viewbox-height: 20;
                    commands: "M 5.2 10.2 L 8.6 13.6 L 15 6.4";
                    stroke: row-touch.has-hover ? Wf.ink : Wf.field;
                    stroke-width: 2px;
                    stroke-line-cap: LineCap.square;
                  }
                }
                Text {
                  x: 34px;
                  width: parent.width - self.x - (choice.missing ? 110px : 10px);
                  height: parent.height;
                  text: choice.name;
                  color: parent.ink;
                  font-size: 15px;
                  vertical-alignment: center;
                  overflow: elide;
                }
                // Held and reaching nothing: an output since deleted, or one this kind cannot
                // reach. Ticking it off is the one thing that can be done with it.
                if choice.missing: Text {
                  x: parent.width - 10px - self.width;
                  height: parent.height;
                  text: "reaches nothing";
                  color: row-touch.has-hover ? Wf.on-primary : Wf.holding;
                  font-size: 13px;
                  vertical-alignment: center;
                }
                row-touch := TouchArea {
                  clicked => {
                    root.chosen(choice.key, !choice.chosen);
                  }
                }
              }
            }
          }

          if root.none-row: Rectangle {
            height: 7px;
            Rectangle {
              y: 3px;
              height: 1px;
              background: Wf.line;
            }
          }
          if root.none-row: HorizontalLayout {
            height: 40px;
            padding-left: 10px;
            alignment: start;
            VerticalLayout {
              alignment: center;
              Btn {
                text: "none";
                height: 28px;
                font-size: 14px;
                pad: 10px;
                clicked => {
                  root.none-chosen();
                }
              }
            }
          }
        }
      }
    }
  }
}

/// "select a preset": a menu that always says the same words, not a dropdown — a dropdown keeps
/// showing what was picked from it, and after adding the Resolume rig the pane read "Resolume:
/// clips on 3 layers" as though that were the state of something (reported from a rig).
component PresetMenu inherits Rectangle {
  in property <[string]> presets;
  out property <bool> open: list.is-open;
  callback picked(int);

  private property <length> row-height: 30px;

  height: 34px;
  background: Wf.field;
  border-width: 1px;
  border-color: list.is-open || touch.has-hover ? Wf.edge : Wf.field-edge;

  Text {
    x: 10px;
    width: parent.width - 42px;
    height: parent.height;
    text: "select a preset";
    color: Wf.ink;
    font-size: 15px;
    vertical-alignment: center;
    overflow: elide;
  }
  Path {
    x: parent.width - 12px - self.width;
    y: (parent.height - self.height) / 2;
    width: 11px;
    height: 7px;
    viewbox-width: 11;
    viewbox-height: 7;
    commands: list.is-open ? "M 1 6 L 5.5 1.5 L 10 6" : "M 1 1 L 5.5 5.5 L 10 1";
    stroke: Wf.ink;
    stroke-width: 2px;
    stroke-line-cap: LineCap.square;
  }

  sink := FocusSink { }
  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      sink.take();
      list.show();
    }
  }

  list := PopupWindow {
    x: 0;
    y: root.height + 2px;
    // Wider than the pane it hangs off, which a popup may be: these are sentences.
    width: max(root.width, widest.preferred-width + 24px);
    forward-focus: list-keys;

    widest := VerticalLayout {
      visible: false;
      for preset in root.presets: Text {
        text: preset;
        font-size: 15px;
      }
    }

    list-keys := FocusScope {
      key-pressed(event) => {
        if (event.text == Key.Escape) {
          list.close();
        }
        return accept;
      }
      Rectangle {
        background: Wf.sheet;
        border-width: 1px;
        border-color: Wf.edge;
        VerticalLayout {
          padding: 1px;
          for preset[i] in root.presets: Rectangle {
            height: root.row-height;
            background: item.has-hover ? Wf.ink : transparent;
            Text {
              x: 10px;
              width: parent.width - 20px;
              text: preset;
              color: item.has-hover ? Wf.on-primary : Wf.ink;
              font-size: 15px;
              vertical-alignment: center;
              overflow: elide;
            }
            item := TouchArea {
              clicked => {
                // One past the index: `RulesController::addRig` keeps 0 for "no preset". **Said
                // before the list is closed**, as `Pick` does: `i` belongs to an item of the popup,
                // which closing it destroys, and a pick said after the close was never said.
                root.picked(i + 1);
                list.close();
              }
            }
          }
        }
      }
    }
  }
}

/// What a colour picker holds: the colour over its three tracks, **each track drawn in its colours**
/// (the operator's choice) — the hue round the wheel, the saturation from white to the hue, the
/// brightness from black to the colour — and under them the line that says the picker sends as it is
/// dragged; for a palette's entry, the code box and "remove" too (HANDOFF §0.5).
component PickerBody inherits Rectangle {
  in property <color> swatch;
  in property <float> hue;
  in property <float> sat;
  in property <float> val;
  in property <bool> has-code;
  in property <string> hex;
  callback moved(float, float, float);
  callback hex-typed(string);
  callback hex-committed(string);
  callback remove-clicked();

  background: Wf.sheet;
  border-width: 1px;
  border-color: Wf.edge;

  VerticalLayout {
    padding: 11px;
    spacing: 8px;

    Rectangle {
      height: 34px;
      background: root.swatch;
      border-width: 1px;
      border-color: Wf.field-edge;
    }

    HorizontalLayout {
      height: 24px;
      spacing: 10px;
      Word {
        width: 46px;
        text: "hue";
      }
      Track {
        painted: true;
        paint: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
        minimum: 0;
        maximum: 359;
        value: root.hue;
        moved(v) => {
          root.moved(v, root.sat, root.val);
        }
      }
    }
    HorizontalLayout {
      height: 24px;
      spacing: 10px;
      Word {
        width: 46px;
        text: "sat";
      }
      Track {
        painted: true;
        paint: @linear-gradient(90deg, #ffffff 0%, hsv(root.hue, 1, 1) 100%);
        minimum: 0;
        maximum: 100;
        value: root.sat;
        moved(v) => {
          root.moved(root.hue, v, root.val);
        }
      }
    }
    HorizontalLayout {
      height: 24px;
      spacing: 10px;
      Word {
        // "bright", not "value": V is the letter in HSV, and every other slot's value is the
        // number it sends.
        width: 46px;
        text: "bright";
      }
      Track {
        painted: true;
        paint: @linear-gradient(90deg, #000000 0%, hsv(root.hue, root.sat / 100, 1) 100%);
        minimum: 0;
        maximum: 100;
        value: root.val;
        moved(v) => {
          root.moved(root.hue, root.sat, v);
        }
      }
    }

    // Said out loud, because a picker that sends is not what a picker usually does and an
    // operator should know the rig is about to move. See `RulesController::previewColor`.
    Text {
      text: "sent to this rule's lights as you drag";
      color: Wf.holding;
      font-size: 14px;
      wrap: word-wrap;
    }

    if root.has-code: HorizontalLayout {
      height: 34px;
      spacing: 8px;
      // How a colour gets in from anywhere else. Its keystrokes are kept (`hex-typed`) because this
      // box lives in a popup: a click outside drops the popup and the box with it, and a box that
      // no longer exists does not say it lost the focus. The controller commits what was typed
      // when the picker reports it closed.
      Entry {
        value: root.hex;
        placeholder: "#ff2040";
        font-family: Wf.code;
        typed(t) => {
          root.hex-typed(t);
        }
        committed(t) => {
          root.hex-committed(t);
        }
      }
      VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        Btn {
          text: "remove";
          height: 28px;
          font-size: 14px;
          pad: 10px;
          clicked => {
            root.remove-clicked();
          }
        }
      }
    }
  }
}

export component RulesWindow inherits Window {
  title: "takt4 — triggers";
  // **These do not decide what the window opens at.** Slint's winit backend sizes a window from
  // what its content asks for, so `ui::kRulesWindowWidth` is the size used; `RulesController` sets
  // it before the first show. 1000 x 872 (HANDOFF §0.5).
  preferred-width: 1000px;
  preferred-height: 872px;
  // The widest row measured, 692 px (a Euclidean rule whose rate a surface has moved, the rate
  // shown), fits at 960 with the list given way to 248 px (`list-max`).
  min-width: 960px;
  min-height: 560px;
  background: Wf.page;
  default-font-family: Wf.sans;
  default-font-size: 15px;
  default-font-weight: 500;

  // --- the shape of the window -----------------------------------------------------------------
  /// How wide the rule list is: 260 to start (HANDOFF §0.5), dragged at the gap between it and the
  /// editor, which is not drawn — which of the two deserves the width changes during a set.
  in-out property <length> list-width: 260px;
  /// The width the list was dragged to. `list-width` is this, given way to the editor.
  private property <length> list-wanted: 260px;
  private property <length> list-min: 200px;
  /// The widest the list is drawn: two-fifths of the window, and **never so wide that the editor's
  /// rows get less than their least width** — the list gives way first, dragged or not, and comes
  /// back when the room does. The page's margin and the gap are the 20 px; the scroll bar's margin
  /// is inside the pane's own width (`body-width`, and its least). Measured on 2026-09-30: a
  /// Euclidean rule with its rate shown needs 692 px, which a 960 px window beside a 260 px list is
  /// 12 short of, and a list dragged to two-fifths of 1000 left 580.
  ///
  /// **Set, not bound**: the list's width is part of the layout the window's own width is worked
  /// out from, so a binding on `root.width` here is a binding loop (the Slint compiler warns of it).
  function list-max() -> length {
    return max(root.list-min, min(root.width * 0.4, root.width - 20px - root.body-least-width));
  }
  function fit-list() {
    root.list-width = clamp(root.list-wanted, root.list-min, root.list-max());
  }
  changed width => {
    root.fit-list();
  }
  changed body-least-width => {
    root.fit-list();
  }
  /// The sections' folds — A, B, C, D — and the event log's, with the height of the log's lines.
  /// **The window's, not the rule's**: they are remembered across launches with the main window's
  /// (machine settings). B starts folded, as a new rule's B does.
  in-out property <bool> when-folded;
  in-out property <bool> only-if-folded: true;
  in-out property <bool> send-folded;
  in-out property <bool> then-folded;
  in-out property <bool> log-open;
  /// Five lines of 18 px to start; the divider over the log drags it, and the editor gives the
  /// height up.
  in-out property <length> log-lines-height: 90px;
  /// 0 to 3 the sections, 4 the log: the controller folds it, having committed what was typed.
  callback fold-clicked(int);

  // --- the set ---------------------------------------------------------------------------------
  in-out property <[RuleRow]> rules;
  in-out property <int> selected: -1;
  /// §5.8's PANIC, latched: lit while it is held, because a rig that has stopped firing and a rig
  /// with no rules look identical otherwise.
  in-out property <bool> panicked;

  callback rule-picked(int);
  /// A click carrying its modifiers: control toggles one row in and out of the selection, shift
  /// takes the run from the anchor to here.
  callback rule-picked-with(int, bool, bool);
  callback rule-added();
  /// Row N's own mark. A row inside the selection acts on the whole selection; a row outside it
  /// acts on itself.
  callback rule-removed-at(int);
  callback rule-duplicated-at(int);
  callback rule-removed();
  callback rule-duplicated();
  callback rule-enabled-changed(bool);
  callback rule-muted-changed(bool);
  /// Row N's dot: the same live mute as MUTE and `/ctl/rule/<id>/mute`, on that row's rule.
  callback rule-muted-at(int, bool);
  /// A **relative** multiplier on the rule's interval, so ÷2 pressed twice is four times as often.
  callback rule-rate-changed(float);
  callback rule-renamed(string);
  callback panic-clicked();
  /// PANIC let go of — RELEASE, which is the only way back.
  callback panic-released();
  /// The M key: fires the rules whose trigger is "manual (M key)", as it does on the main window.
  callback manual-fired();
  /// §5.6's presets at rig scale: a whole set of rules in one pick.
  in-out property <[string]> rig-presets;
  callback rig-added(int);
  /// §5.9's per-rule [test] button: fires past `enabled` and past the conditions, deliberately.
  callback rule-tested();

  // --- A · when ----------------------------------------------------------------------------------
  in-out property <[string]> trigger-names;
  in-out property <int> trigger-index;
  /// Whether the selected trigger counts — beats, bars, a Euclidean pattern's steps.
  in-out property <bool> trigger-takes-every;
  in-out property <int> every: 1;
  /// Whether the selected trigger takes a pulse count — `Euclid` alone.
  in-out property <bool> trigger-takes-pulses;
  in-out property <int> pulses: 3;
  /// The pattern those two numbers name, as "x..x..x.".
  in-out property <string> euclid-pattern;
  /// Whether the cooldown means anything for this trigger — the ones that come in bursts
  /// (`trigger::takesCooldown`). Off, the control is switched off and says why.
  in-out property <bool> trigger-takes-cooldown;
  /// Text the controller writes, not a number the markup formats — see `bpm-range`.
  in-out property <string> cooldown-ms;
  in-out property <string> when-summary;

  callback trigger-picked(int);
  callback every-changed(int);
  callback pulses-changed(int);
  callback cooldown-changed(string);

  // --- B · only if -------------------------------------------------------------------------------
  /// The tick on B's heading: off, the rule fires every time A comes round, whatever is set below.
  in-out property <bool> conditions-on;
  in-out property <float> min-confidence;
  in-out property <bool> allow-calm: true;
  in-out property <bool> allow-normal: true;
  in-out property <bool> allow-intense: true;
  in-out property <float> probability: 1;
  in-out property <string> bpm-range;
  in-out property <string> only-if-summary;

  callback conditions-toggled(bool);
  callback min-confidence-changed(float);
  callback intensity-changed(int, bool);
  callback bpm-range-edited(string);
  callback probability-changed(float);
  /// A number typed into a slider's reading, as typed: the controller reads it and clamps it.
  callback min-confidence-typed(string);
  callback probability-typed(string);

  // --- C · send ----------------------------------------------------------------------------------
  in-out property <[string]> send-kinds;
  in-out property <int> send-index;
  in-out property <bool> sends-osc: true;
  in-out property <bool> sends-midi;
  in-out property <bool> sends-dmx;
  in-out property <string> address;
  in-out property <int> channel: 1;
  /// §5.6's host presets: a starting point that fills the address and its slots, and which of them
  /// the address in front of the operator *is* — 0, "custom", when none.
  in-out property <[string]> host-presets;
  in-out property <int> host-preset-index;
  in-out property <bool> send-value: true;
  in-out property <string> send-summary;

  in-out property <[FollowRow]> follow-ups;
  /// What a follow-up may be, for this rule: "release" first, then whichever kinds sit on the same
  /// side of the OSC/MIDI divide as the rule's own.
  in-out property <[string]> follow-kinds;
  /// ms · beats · bars, shared by every row — `trigger::DelayUnit`.
  in-out property <[string]> follow-up-units;
  in-out property <bool> can-add-follow-up: true;
  in-out property <string> then-summary;

  in-out property <[string]> generator-kinds;
  /// The kinds a color's chip offers: `generator-kinds` without the two that compute numbers.
  in-out property <[string]> color-generator-kinds;
  in-out property <[string]> live-sources;
  in-out property <[string]> ramp-shapes;
  in-out property <[SlotRow]> slots;

  /// §5.6's "rule subset": which of the app's outputs this rule reaches.
  in-out property <[OutputChoice]> output-choices;
  /// Whether the rule names none of them, which is reaching *every* one.
  in-out property <bool> outputs-all;
  in-out property <string> outputs-summary;
  in-out property <string> outputs-available;

  callback output-chosen(string, bool);
  callback all-outputs-chosen();

  // The lighting half, shown only for a rule whose send kind is DMX. Every control is hidden rather
  // than disabled when the chosen effect does not use it.
  /// The fixtures and groups this rule aims at. **Naming none reaches nothing**, the opposite of an
  /// output list: an unrouted lighting rule that went everywhere would swing the whole rig.
  in-out property <[OutputChoice]> fixture-choices;
  in-out property <string> fixtures-summary;
  in-out property <string> fixtures-available;
  /// The same, short enough for the list's first line (258 px inside its edge): the whole
  /// sentence stays beside the field.
  in-out property <string> fixtures-list-note;
  in-out property <bool> fixtures-reaches-nothing;

  in-out property <[string]> effect-kinds;
  in-out property <int> effect-index;
  in-out property <[string]> effect-roles;
  in-out property <int> effect-role-index;
  in-out property <[string]> effect-curves;
  in-out property <int> effect-curve-index;
  in-out property <[string]> effect-shapes;
  in-out property <int> effect-shape-index;
  in-out property <bool> effect-takes-role;
  in-out property <bool> effect-takes-base;
  in-out property <bool> effect-takes-cycles;
  in-out property <bool> effect-takes-duty;
  in-out property <bool> effect-takes-hue;
  in-out property <bool> effect-takes-shape;
  in-out property <bool> effect-takes-curve;
  in-out property <bool> effect-takes-color;
  /// Whether the fixtures this rule names *have* the channel it is aimed at — see
  /// `RulesController::describeRoleReach`. Empty when there is nothing worth saying.
  in-out property <string> effect-role-note;
  in-out property <[string]> color-modes;
  in-out property <int> color-mode-index;
  in-out property <[PaletteEntry]> palette;
  in-out property <bool> palette-shown;
  in-out property <string> effect-duration;
  in-out property <int> effect-unit;
  in-out property <int> effect-base;
  in-out property <string> effect-cycles;
  in-out property <float> effect-duty;
  in-out property <string> effect-hue;
  in-out property <float> effect-size;

  callback fixture-chosen(string, bool);
  callback no-fixtures-chosen();
  callback effect-picked(int);
  callback effect-role-picked(int);
  callback effect-curve-picked(int);
  callback effect-shape-picked(int);
  callback effect-duration-edited(string);
  callback effect-unit-picked(int);
  callback effect-base-changed(int);
  callback effect-cycles-edited(string);
  callback effect-duty-changed(float);
  callback effect-hue-edited(string);
  callback effect-size-changed(float);
  callback color-mode-picked(int);
  callback palette-added();
  callback palette-removed(int);
  /// One palette entry from its picker: hue in degrees, saturation and brightness as percentages.
  callback palette-color-changed(int, float, float, float);
  callback palette-hex-edited(int, string);
  /// A keystroke in a swatch's hex box, before it is committed. See `slot-typed`.
  callback palette-typed(int, string);
  /// Whether a color picker's popup is on the screen. **A picker is a `PopupWindow` inside a
  /// repeated item**, so anything that rebuilt that repeater would destroy the popup and the slider
  /// being dragged — the crash of 2026-09-16. See `RulesController::setPickerOpen`.
  callback picker-open-changed(bool);

  callback send-picked(int);
  callback address-edited(string);
  callback channel-changed(int);
  callback host-preset-picked(int);
  callback send-value-changed(bool);

  callback follow-up-added();
  callback follow-up-removed(int);
  callback follow-kind-picked(int, int);
  callback follow-number-changed(int, int);
  callback follow-value-edited(int, string);
  callback follow-delay-edited(int, string);
  callback follow-unit-picked(int, int);

  callback slot-kind-picked(int, int);
  callback slot-pool-changed(int, bool);
  callback slot-range-edited(int, string);
  callback slot-values-edited(int, string);
  /// A keystroke in a chip's box, before it is committed: field 0 is the fixed value, 1 a range, 2
  /// a list, 3 weights, 4 a normalised range, 5 "no repeat", 6 a ramp's bars. See
  /// `RulesController::typing_`, which commits it before any action.
  callback slot-typed(int, int, string);
  /// The same for a follow-up's boxes: field 0 the value, 1 the delay, 2 the number.
  callback follow-typed(int, int, string);
  /// And for the rule's own boxes: 0 the address, 1 the BPM range, 2 the cooldown, 3 the effect's
  /// duration, 4 its cycles, 5 its hue sweep, 6 "every", 7 the pulses, 8 the MIDI channel, 9 the
  /// effect's "down to", 10 and 11 B's confidence and probability readings.
  /// `RulesController::RuleBox` is this list.
  callback rule-typed(int, string);
  callback slot-normalise-edited(int, string);
  callback slot-weights-edited(int, string);
  callback slot-no-repeat-changed(int, int);
  callback slot-fixed-edited(int, string);
  /// A color slot's hue (degrees), saturation and brightness (both percentages).
  callback slot-color-changed(int, float, float, float);
  callback slot-live-picked(int, int);
  callback slot-shape-picked(int, int);
  callback slot-ramp-bars-changed(int, int);
  callback slot-ramp-float-changed(int, bool);

  // --- what it is doing ----------------------------------------------------------------------------
  /// Phase 6's event log: every message that left, newest first.
  in-out property <[LogLine]> log;
  /// The editor's own message — "A BPM range is two numbers, like 120 - 140." — under the top row,
  /// amber when an entry could not be used and secondary when it only says what happened; gone at
  /// the next edit that works.
  in-out property <string> status;
  in-out property <bool> status-is-error;
  callback log-cleared();

  // The name and enabled state of the selected rule, and what else the top row shows.
  in-out property <string> rule-name;
  /// The rule's id — what `/takt4/ctl/rule/<id>/...` names it by. Shown beside the name, because a
  /// control surface cannot be pointed at a rule whose id nobody can see (the operator, 2026-09-30:
  /// the README sent them to settings.json for it). Generated, and not edited here: a rule is
  /// aimed at by its id, never by a name anybody can change.
  in property <string> rule-id;
  in-out property <bool> rule-enabled;
  /// Why the selected rule will not fire — `Rule::problem()` — or empty.
  in property <string> rule-problem;
  /// §5.7's per-rule mute — see the MUTE button for why it is not `rule-enabled`.
  in-out property <bool> rule-muted;
  /// How often this rule is firing against how often it was written to — "2× faster" — and
  /// **empty at the written rate**.
  in-out property <string> rule-rate;

  /// For the tests: the least width the editor's column of sheets asks for, and the width it is
  /// given. The scroller holds its content to its own width, so a row wider than that is cut off
  /// at the pane's edge, which no pixel outside it shows (the audit of 2026-09-25, L35).
  out property <length> body-least-width: sheets.min-width;
  out property <length> body-width: sheets.width;
  /// Whether the "send to" list is open — what a test finds the field by, where a popup can open
  /// above its field or below it as Slint finds room.
  out property <bool> routing-open;
  /// Whether the preset menu's list is open, for the same reason.
  out property <bool> presets-open;

  private property <bool> none: root.selected < 0;
  private property <length> log-lines-least: 18px;
  // What the log may grow to: the editor keeps its top row and a little of its body.
  private property <length> log-lines-most: max(root.log-lines-least, root.height - 20px - 10px - 52px - 200px);

  // The keyboard's resting place, so Escape works the moment the editor opens.
  forward-focus: keys;

  // **PANIC from the keyboard** — the audit's H18. Escape; in a text box it leaves the box, in an
  // open list it closes the list, and neither panics anything. And **M**, which the trigger list
  // offers as "manual (M key)": it only worked on the main window, so a manual rule built here
  // could not be fired from here (found 2026-09-30). In a text box M is a letter, as Escape is
  // leaving the box — the box has the keyboard, and this only hears what it passes on.
  keys := FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;

    key-pressed(event) => {
      if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
        return reject;
      }
      if (event.text == Key.Escape) {
        if (!event.repeat) {
          root.panic-clicked();
        }
        return accept;
      }
      if (event.text == "m" || event.text == "M") {
        if (!event.repeat) {
          root.manual-fired();
        }
        return accept;
      }
      return reject;
    }

    // **Somewhere for a click on nothing to go** (`FocusSink`): a text box commits when it loses
    // the keyboard, and a click on a heading, a sheet or the page between them moved it nowhere.
    // First in the window, so it is behind everything.
    TouchArea {
      clicked => {
        keys.focus();
      }
    }

    VerticalLayout {
      padding-top: 10px;
      padding-bottom: 10px;
      spacing: 0px;

      HorizontalLayout {
        vertical-stretch: 1;
        padding-left: 10px;
        spacing: 0px;

        // --- the rule list ---------------------------------------------------------------------
        Rectangle {
          width: root.list-width;
          horizontal-stretch: 0;
          background: Wf.sheet;
          clip: true;

          VerticalLayout {
            spacing: 0px;

            // "triggers" and its +.
            HorizontalLayout {
              height: 46px;
              padding-left: 14px;
              padding-right: 10px;
              padding-top: 10px;
              padding-bottom: 8px;
              Text {
                text: "triggers";
                color: Wf.ink;
                font-size: 18px;
                font-weight: 800;
                letter-spacing: -0.36px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
              }
              Btn {
                width: 28px;
                height: 28px;
                text: "+";
                font-size: 15px;
                pad: 0px;
                clicked => {
                  root.rule-added();
                }
              }
            }

            // What the dots mean, since each is a switch (HANDOFF §0.5).
            HorizontalLayout {
              height: 24px;
              padding-left: 14px;
              padding-bottom: 8px;
              spacing: 6px;
              alignment: start;
              VerticalLayout {
                alignment: center;
                Rectangle {
                  width: 12px;
                  height: 12px;
                  border-radius: 6px;
                  background: Wf.locked;
                }
              }
              Text {
                text: "sending";
                color: Wf.ink2;
                font-size: 13px;
                vertical-alignment: center;
              }
              Rectangle { width: 2px; }
              VerticalLayout {
                alignment: center;
                Rectangle {
                  width: 12px;
                  height: 12px;
                  border-radius: 6px;
                  border-width: 2px;
                  border-color: Wf.locked;
                }
              }
              Text {
                text: "muted — click a dot";
                color: Wf.ink2;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
              }
            }

            list-scroll := Scroller {
              vertical-stretch: 1;
              VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;
                alignment: start;

                for row[index] in root.rules: RuleLine {
                  entry: row;
                  shown: index == root.selected;
                  pressed(control, shift) => {
                    // **The keyboard back to the window first**: a row took nothing, so a box being
                    // typed in stayed lit over another rule (the audit of 2026-09-25, M18).
                    keys.focus();
                    root.rule-picked-with(index, control, shift);
                  }
                  mute-clicked(on) => {
                    keys.focus();
                    root.rule-muted-at(index, on);
                  }
                  copy-clicked => {
                    keys.focus();
                    root.rule-duplicated-at(index);
                  }
                  kill-clicked => {
                    keys.focus();
                    root.rule-removed-at(index);
                  }
                }
              }
            }

            // The foot: the preset menu and PANIC, the same place every time and never scrolled
            // away. **PANIC never moves.** RELEASE appears between the menu and PANIC while PANIC
            // is held, and the menu moves up to make room (the operator, 2026-09-30) — the foot
            // grows upwards, so the second click of a double-click lands on PANIC again, which is
            // already engaged (the audit's H18). An explicit height: an `if` in a vertical layout
            // takes a share of the spare height otherwise.
            VerticalLayout {
              padding: 10px;
              spacing: 10px;

              PresetMenu {
                presets: root.rig-presets;
                picked(index) => {
                  root.rig-added(index);
                }
                // From out here: a `changed` inside the popup never fires (measured).
                changed open => {
                  root.presets-open = self.open;
                }
              }

              if root.panicked: Btn {
                height: 32px;
                text: "release";
                clicked => {
                  // The keyboard back to the window first: this button goes the moment it works,
                  // and the focus with it, and the next Escape would reach nothing.
                  keys.focus();
                  root.panic-released();
                }
              }

              Btn {
                height: 46px;
                text: root.panicked ? "panicked" : "panic";
                hint: "Esc";
                danger: true;
                engaged: root.panicked;
                font-size: 22px;
                pad: 16px;
                keycap-size: 20px;
                clicked => {
                  root.panic-clicked();
                }
              }
            }
          }
        }

        // The gap between the list and the editor, which drags the list wider or narrower. Not
        // drawn (HANDOFF §0.5); the pointer says what it is.
        Rectangle {
          width: 10px;
          horizontal-stretch: 0;
          TouchArea {
            mouse-cursor: ew-resize;
            // The movement since the last report: the gap, and this area's origin, moves by
            // whatever the drag did with it (`Splitter`).
            moved => {
              if (self.pressed) {
                // From the width it is drawn at, which the editor may have narrowed: from the width
                // it was dragged to, the first pixels of a drag left would move nothing.
                root.list-wanted = clamp(root.list-width + (self.mouse-x - self.pressed-x),
                  root.list-min, root.list-max());
                root.fit-list();
              }
            }
          }
        }

        // --- the editor --------------------------------------------------------------------------
        VerticalLayout {
          horizontal-stretch: 1;
          spacing: 10px;

          // The top row: whether it is on, MUTE, its name, TEST — and under them, only while there
          // is something to say, why it will not fire and the editor's own message.
          HorizontalLayout {
            padding-right: 10px;
            vertical-stretch: 0;
            Rectangle {
              background: Wf.sheet;

              VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;

                  enabled-tick := Tick {
                    text: "enabled";
                    horizontal-stretch: 0;
                    checked: root.rule-enabled;
                    enabled: !root.none;
                    toggled(on) => {
                      root.rule-enabled-changed(on);
                    }
                  }

                  // **Mute is not disable.** A disabled rule stops running; a muted one keeps
                  // running and stops *sending*, so unmuting rejoins the music in phase. Live, not
                  // saved: a preset that loaded silent is not a thing that can happen.
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Btn {
                      text: "mute";
                      active: root.rule-muted;
                      enabled: !root.none;
                      clicked => {
                        root.rule-muted-changed(!root.rule-muted);
                      }
                    }
                  }

                  // The name commits on every keystroke; Enter only lets go.
                  name-box := Entry {
                    value: root.rule-name;
                    placeholder: root.none ? "pick a rule on the left, or + to add one" : "name this rule";
                    enabled: !root.none;
                    dashed: root.none;
                    typed(text) => {
                      root.rule-renamed(text);
                    }
                  }

                  // Its id, a reading and not a box: "id layer3", for `/takt4/ctl/rule/layer3/mute`.
                  if !root.none: Word {
                    text: "id";
                  }
                  if !root.none: Text {
                    text: root.rule-id;
                    color: Wf.ink;
                    font-family: Wf.code;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    max-width: 160px;
                    overflow: elide;
                  }

                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Btn {
                      text: "test";
                      primary: true;
                      enabled: !root.none;
                      clicked => {
                        root.rule-tested();
                      }
                    }
                  }
                }

                // Why it will not fire, as the list says it, and the editor's message. Each line
                // exists only while it has something to say.
                if !root.none && root.rule-problem != "": Text {
                  height: 16px;
                  text: "will not fire: " + root.rule-problem + ".";
                  color: Wf.holding;
                  font-size: 13px;
                  vertical-alignment: center;
                  overflow: elide;
                }
                if root.status != "": Text {
                  height: 16px;
                  text: root.status;
                  color: root.status-is-error ? Wf.holding : Wf.ink2;
                  font-size: 13px;
                  vertical-alignment: center;
                  overflow: elide;
                }
              }
            }
          }

          body-scroll := Scroller {
            vertical-stretch: 1;

            sheets := VerticalLayout {
              padding-right: 10px;
              spacing: 10px;
              alignment: start;

              // --- A · when ----------------------------------------------------------------------
              Section {
                letter: "A";
                title: "when";
                folded: root.when-folded;
                summary: root.when-summary;
                enabled: !root.none;
                fold-clicked => {
                  root.fold-clicked(0);
                }

                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;

                  Pick {
                    model: root.trigger-names;
                    current-index: root.trigger-index;
                    enabled: !root.none;
                    width: 170px;
                    horizontal-stretch: 0;
                    selected(index) => {
                      root.trigger-picked(index);
                    }
                  }
                  if root.trigger-takes-every: Word {
                    text: "every";
                  }
                  if root.trigger-takes-every: Count {
                    width: 64px;
                    value: root.every;
                    minimum: 1;
                    maximum: 64;
                    enabled: !root.none;
                    typed(v) => {
                      root.rule-typed(6, v);
                    }
                    edited(v) => {
                      root.every-changed(v);
                    }
                  }
                  if root.trigger-takes-pulses: Word {
                    text: "with";
                  }
                  if root.trigger-takes-pulses: Count {
                    width: 64px;
                    value: root.pulses;
                    minimum: 0;
                    maximum: 64;
                    enabled: !root.none;
                    typed(v) => {
                      root.rule-typed(7, v);
                    }
                    edited(v) => {
                      root.pulses-changed(v);
                    }
                  }
                  // "every 4 bars" counts from the first — bars 1, 5 and 9 — and a Euclidean
                  // pattern shows itself: two numbers are not a rhythm anybody can hear. Prose
                  // gives way before the buttons do.
                  if root.trigger-takes-every: Text {
                    // Its own width and no more, and the first thing to give way.
                    horizontal-stretch: 1;
                    max-width: self.preferred-width;
                    min-width: 20px;
                    text: root.trigger-takes-pulses ? root.euclid-pattern : "counting from the first";
                    color: Wf.ink2;
                    font-family: root.trigger-takes-pulses ? Wf.code : Wf.sans;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                  }
                  // ÷2 and ×2 multiply the count; a trigger with none has them switched off and
                  // says why (the audit's M10). 18 px, so the ÷ does not read as a +.
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Btn {
                      text: "÷2";
                      font-size: 18px;
                      enabled: !root.none && root.trigger-takes-every;
                      clicked => {
                        root.rule-rate-changed(0.5);
                      }
                    }
                  }
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Btn {
                      text: "×2";
                      font-size: 18px;
                      enabled: !root.none && root.trigger-takes-every;
                      clicked => {
                        root.rule-rate-changed(2.0);
                      }
                    }
                  }
                  // The rate a surface has moved it to, in amber: the one thing here that is not
                  // the rule as written.
                  if root.trigger-takes-every && root.rule-rate != "": Text {
                    horizontal-stretch: 0;
                    text: root.rule-rate;
                    color: Wf.holding;
                    font-family: Wf.code;
                    font-size: 14px;
                    vertical-alignment: center;
                  }
                  if !root.trigger-takes-every && !root.none: Note {
                    text: "÷2 and ×2 need a count";
                  }
                  Rectangle { horizontal-stretch: 1; }
                }

                // The cooldown, moved here from B: live for the triggers that come in bursts, and
                // switched off — label and unit dim, the box dashed and empty — for the ones that
                // come round at the music's own pace, where the engine ignores it too.
                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  private property <bool> live: !root.none && root.trigger-takes-cooldown;

                  Text {
                    text: "at most once every";
                    color: parent.live ? Wf.ink : Wf.ink-off;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                  }
                  Entry {
                    width: 80px;
                    horizontal-stretch: 0;
                    value: parent.live ? root.cooldown-ms : "";
                    enabled: parent.live;
                    dashed: !parent.live;
                    font-family: Wf.code;
                    typed(text) => {
                      root.rule-typed(2, text);
                    }
                    committed(text) => {
                      root.cooldown-changed(text);
                    }
                  }
                  Text {
                    text: "ms";
                    color: parent.live ? Wf.ink2 : Wf.ink-off;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                  }
                  Note {
                    text: root.none ? ""
                      : root.trigger-takes-cooldown ? "after it fires, it waits this long before it can fire again"
                      : "only for the fast ones: onset, changes, the M key";
                  }
                }
              }

              // --- B · only if -------------------------------------------------------------------
              // Its tick is a rule setting: off, the rule fires every time A comes round; the body,
              // if opened, is dashed and quiet but still settable, for later.
              Section {
                letter: "B";
                title: "only if";
                folded: root.only-if-folded;
                summary: root.only-if-summary;
                off: !root.conditions-on;
                has-tick: true;
                ticked: root.conditions-on;
                enabled: !root.none;
                fold-clicked => {
                  root.fold-clicked(1);
                }
                tick-toggled(on) => {
                  root.conditions-toggled(on);
                }

                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "confidence over";
                    color: root.conditions-on ? Wf.ink : Wf.ink-off;
                  }
                  Track {
                    minimum: 0;
                    maximum: 1;
                    step: 0.01;
                    value: root.min-confidence;
                    enabled: !root.none;
                    quiet: !root.conditions-on;
                    moved(v) => {
                      root.min-confidence-changed(v);
                    }
                  }
                  Reading {
                    width: 59px;
                    text: Math.round(root.min-confidence * 100) / 100;
                    value-text: Math.round(root.min-confidence * 100) / 100;
                    enabled: !root.none;
                    quiet: !root.conditions-on;
                    font-family: Wf.code;
                    typed(text) => {
                      root.rule-typed(10, text);
                    }
                    committed(text) => {
                      root.min-confidence-typed(text);
                    }
                  }
                }
                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "probability";
                    color: root.conditions-on ? Wf.ink : Wf.ink-off;
                  }
                  Track {
                    minimum: 0;
                    maximum: 1;
                    step: 0.01;
                    value: root.probability;
                    enabled: !root.none;
                    quiet: !root.conditions-on;
                    moved(v) => {
                      root.probability-changed(v);
                    }
                  }
                  Reading {
                    width: 59px;
                    text: Math.round(root.probability * 100) + "%";
                    value-text: Math.round(root.probability * 100);
                    enabled: !root.none;
                    quiet: !root.conditions-on;
                    font-family: Wf.code;
                    typed(text) => {
                      root.rule-typed(11, text);
                    }
                    committed(text) => {
                      root.probability-typed(text);
                    }
                  }
                }
                HorizontalLayout {
                  height: 34px;
                  spacing: 24px;
                  RowLabel {
                    text: "intensity";
                    color: root.conditions-on ? Wf.ink : Wf.ink-off;
                  }
                  Tick {
                    text: "calm";
                    horizontal-stretch: 0;
                    checked: root.allow-calm;
                    enabled: !root.none;
                    quiet: !root.conditions-on;
                    toggled(on) => {
                      root.intensity-changed(0, on);
                    }
                  }
                  Tick {
                    text: "normal";
                    horizontal-stretch: 0;
                    checked: root.allow-normal;
                    enabled: !root.none;
                    quiet: !root.conditions-on;
                    toggled(on) => {
                      root.intensity-changed(1, on);
                    }
                  }
                  Tick {
                    text: "intense";
                    horizontal-stretch: 0;
                    checked: root.allow-intense;
                    enabled: !root.none;
                    quiet: !root.conditions-on;
                    toggled(on) => {
                      root.intensity-changed(2, on);
                    }
                  }
                  Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "BPM between";
                    color: root.conditions-on ? Wf.ink : Wf.ink-off;
                  }
                  Entry {
                    width: 120px;
                    horizontal-stretch: 0;
                    value: root.bpm-range;
                    placeholder: "any";
                    enabled: !root.none;
                    dashed: root.none || !root.conditions-on;
                    font-family: Wf.code;
                    // Kept as it is typed, so an action taken before this box lets go commits it.
                    typed(text) => {
                      root.rule-typed(1, text);
                    }
                    committed(text) => {
                      root.bpm-range-edited(text);
                    }
                  }
                  Rectangle { horizontal-stretch: 1; }
                }
              }

              // --- C · send ----------------------------------------------------------------------
              // **Every box one width, 240 px**, so their edges line up down the column; the
              // address the sheet's full width (HANDOFF §0.5).
              Section {
                letter: "C";
                title: "send";
                folded: root.send-folded;
                summary: root.send-summary;
                enabled: !root.none;
                fold-clicked => {
                  root.fold-clicked(2);
                }

                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "send as";
                  }
                  Pick {
                    width: 240px;
                    horizontal-stretch: 0;
                    model: root.send-kinds;
                    current-index: root.send-index;
                    enabled: !root.none;
                    selected(index) => {
                      root.send-picked(index);
                    }
                  }
                  Rectangle { horizontal-stretch: 1; }
                }

                // MIDI: the channel, 1 to 16 as a person counts them.
                if root.sends-midi: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "channel";
                  }
                  Count {
                    width: 240px;
                    value: root.channel;
                    minimum: 1;
                    maximum: 16;
                    enabled: !root.none;
                    typed(v) => {
                      root.rule-typed(8, v);
                    }
                    edited(v) => {
                      root.channel-changed(v);
                    }
                  }
                  Note {
                    text: "1 to 16";
                  }
                }

                if root.sends-osc: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "preset";
                  }
                  Pick {
                    width: 240px;
                    horizontal-stretch: 0;
                    model: root.host-presets;
                    current-index: root.host-preset-index;
                    enabled: !root.none;
                    selected(index) => {
                      root.host-preset-picked(index);
                    }
                  }
                  Note {
                    text: "fills in the address and its slots";
                  }
                }

                // §5.6's rule subset, ticked from the rig's own list. **Not for a lighting rule**,
                // which is routed by fixture: a fixture names its universe already.
                if !root.sends-dmx: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "send to";
                  }
                  routing := ChoiceField {
                    width: 240px;
                    choices: root.output-choices;
                    summary: root.outputs-summary;
                    enabled: !root.none;
                    all-row: true;
                    all-ticked: root.outputs-all;
                    // 214 px in Archivo 14 — the list is 258 inside its edge. "add one on the main
                    // window" was 287, and was cut off for exactly the operator who had none.
                    empty-note: "no outputs yet — use + add output";
                    chosen(key, on) => {
                      root.output-chosen(key, on);
                    }
                    all-chosen => {
                      root.all-outputs-chosen();
                    }
                  }
                  Note {
                    text: root.outputs-available;
                  }
                  // Watched from out here: a `changed is-open` inside a popup is built with it and
                  // never sees a change.
                  property <bool> routing-open: routing.open;
                  changed routing-open => {
                    root.routing-open = self.routing-open;
                  }
                }

                if root.sends-osc: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "address";
                  }
                  Entry {
                    value: root.address;
                    placeholder: "/composition/layers/3/clips/{clip}/connect";
                    enabled: !root.none;
                    dashed: root.none;
                    font-family: Wf.code;
                    typed(text) => {
                      root.rule-typed(0, text);
                    }
                    committed(text) => {
                      root.address-edited(text);
                    }
                  }
                }

                // The lighting half: the effect decides what the rows below even ask.
                if root.sends-dmx: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "effect";
                  }
                  Pick {
                    width: 240px;
                    horizontal-stretch: 0;
                    model: root.effect-kinds;
                    current-index: root.effect-index;
                    enabled: !root.none;
                    selected(index) => {
                      root.effect-picked(index);
                    }
                  }
                  Rectangle { horizontal-stretch: 1; }
                }

                // Which channel it drives — "a flash on the dimmer" — and, where the fixtures have
                // not got it, what happens instead, in amber (`describeRoleReach`).
                if root.sends-dmx && root.effect-takes-role: HorizontalLayout {
                  height: 35px;
                  spacing: 10px;
                  RowLabel {
                    text: "on channel";
                  }
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Pick {
                      width: 240px;
                      model: root.effect-roles;
                      current-index: root.effect-role-index;
                      enabled: !root.none;
                      selected(index) => {
                        root.effect-role-picked(index);
                      }
                    }
                  }
                  Note {
                    text: root.effect-role-note;
                    color: Wf.holding;
                    wrap: word-wrap;
                  }
                }

                if root.sends-dmx && root.effect-takes-shape: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "shape";
                  }
                  Pick {
                    width: 240px;
                    horizontal-stretch: 0;
                    model: root.effect-shapes;
                    current-index: root.effect-shape-index;
                    enabled: !root.none;
                    selected(index) => {
                      root.effect-shape-picked(index);
                    }
                  }
                  Rectangle { horizontal-stretch: 1; }
                }

                if root.sends-dmx && root.effect-takes-color: HorizontalLayout {
                  height: 35px;
                  spacing: 10px;
                  RowLabel {
                    text: "color from";
                  }
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Pick {
                      width: 240px;
                      model: root.color-modes;
                      current-index: root.color-mode-index;
                      enabled: !root.none;
                      selected(index) => {
                        root.color-mode-picked(index);
                      }
                    }
                  }
                  Note {
                    text: root.color-mode-index == 0
                      ? "swatches below; the chip beside them says how they are drawn"
                      : "one generator per component, 0 to 255 each";
                    wrap: word-wrap;
                  }
                }

                // How long the effect runs — not how long until it starts, which is a follow-up's
                // delay: its number and its unit together in the 240.
                if root.sends-dmx: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "over";
                  }
                  HorizontalLayout {
                    width: 240px;
                    horizontal-stretch: 0;
                    spacing: 10px;
                    Entry {
                      width: 64px;
                      horizontal-stretch: 0;
                      value: root.effect-duration;
                      placeholder: "1";
                      enabled: !root.none;
                      font-family: Wf.code;
                      typed(t) => {
                        root.rule-typed(3, t);
                      }
                      committed(t) => {
                        root.effect-duration-edited(t);
                      }
                    }
                    Pick {
                      model: root.follow-up-units;
                      current-index: root.effect-unit;
                      enabled: !root.none;
                      selected(index) => {
                        root.effect-unit-picked(index);
                      }
                    }
                  }
                  Rectangle { horizontal-stretch: 1; }
                }

                if root.sends-dmx && root.effect-takes-curve: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "curve";
                  }
                  Pick {
                    width: 240px;
                    horizontal-stretch: 0;
                    model: root.effect-curves;
                    current-index: root.effect-curve-index;
                    enabled: !root.none;
                    selected(index) => {
                      root.effect-curve-picked(index);
                    }
                  }
                  Rectangle { horizontal-stretch: 1; }
                }

                // The low end of a flash, a pulse or a strobe; the peak is the level chip below.
                if root.sends-dmx && root.effect-takes-base: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "down to";
                  }
                  Count {
                    width: 240px;
                    value: root.effect-base;
                    minimum: 0;
                    maximum: 255;
                    enabled: !root.none;
                    typed(v) => {
                      root.rule-typed(9, v);
                    }
                    edited(v) => {
                      root.effect-base-changed(v);
                    }
                  }
                  Note {
                    text: "0 to 255";
                  }
                }

                if root.sends-dmx && root.effect-takes-cycles: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "times";
                  }
                  Entry {
                    width: 240px;
                    horizontal-stretch: 0;
                    value: root.effect-cycles;
                    placeholder: "1";
                    enabled: !root.none;
                    font-family: Wf.code;
                    typed(t) => {
                      root.rule-typed(4, t);
                    }
                    committed(t) => {
                      root.effect-cycles-edited(t);
                    }
                  }
                  Note {
                    text: "within the time above";
                  }
                }

                if root.sends-dmx && root.effect-takes-hue: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "hues";
                  }
                  Entry {
                    width: 240px;
                    horizontal-stretch: 0;
                    value: root.effect-hue;
                    placeholder: "0 - 360";
                    enabled: !root.none;
                    font-family: Wf.code;
                    typed(t) => {
                      root.rule-typed(5, t);
                    }
                    committed(t) => {
                      root.effect-hue-edited(t);
                    }
                  }
                  Note {
                    text: "degrees round the color wheel, from - to";
                  }
                }

                // A strobe's duty and a path's size, each a slider: each is found by eye.
                if root.sends-dmx && root.effect-takes-duty: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "on for";
                  }
                  Track {
                    width: 240px;
                    horizontal-stretch: 0;
                    minimum: 1;
                    maximum: 99;
                    value: root.effect-duty;
                    enabled: !root.none;
                    moved(v) => {
                      root.effect-duty-changed(v);
                    }
                  }
                  Note {
                    text: round(root.effect-duty) + "% of each flash";
                    color: Wf.ink;
                  }
                }

                if root.sends-dmx && root.effect-takes-shape: HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  RowLabel {
                    text: "size";
                  }
                  Track {
                    width: 240px;
                    horizontal-stretch: 0;
                    minimum: 0;
                    maximum: 100;
                    value: root.effect-size;
                    enabled: !root.none;
                    moved(v) => {
                      root.effect-size-changed(v);
                    }
                  }
                  // At 100% the figure just touches the fixture's own movement limits.
                  Note {
                    text: round(root.effect-size) + "% of the movement window";
                    color: Wf.ink;
                  }
                }

                // Which fixtures. **Naming none: the box edged amber**, and it says so — a DMX rule
                // with no fixtures does not fire at all, and a silent rule looks exactly like one
                // whose trigger has not come round yet.
                if root.sends-dmx: HorizontalLayout {
                  height: 35px;
                  spacing: 10px;
                  RowLabel {
                    text: "lights";
                  }
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ChoiceField {
                      width: 240px;
                      choices: root.fixture-choices;
                      summary: root.fixtures-summary;
                      enabled: !root.none;
                      warn: !root.none && root.fixtures-reaches-nothing;
                      head-note: root.fixtures-list-note;
                      // With nothing patched the list has only "none" in it; say where fixtures
                      // come from — the main window's "patch lights" button.
                      empty-note: "no fixtures yet — use patch lights";
                      none-row: true;
                      chosen(key, on) => {
                        root.fixture-chosen(key, on);
                      }
                      none-chosen => {
                        root.no-fixtures-chosen();
                      }
                    }
                  }
                  Note {
                    text: root.fixtures-available;
                    wrap: word-wrap;
                  }
                }

                // Every `{...}` of the address, the value and — for MIDI — the note: each a
                // generator, in a band of its own. This is where "custom random triggers and
                // sequences" actually gets designed.
                for slot[index] in root.slots: Band {
                  height: slot.is-ramp || (slot.is-live && slot.is-normalised) ? 90px : 48px;

                  VerticalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 8px;

                    HorizontalLayout {
                      height: 34px;
                      spacing: 10px;

                      Text {
                        width: 70px;
                        horizontal-stretch: 0;
                        text: slot.label;
                        color: Wf.slot-name;
                        font-family: Wf.code;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                      }
                      Pick {
                        width: 120px;
                        horizontal-stretch: 0;
                        // A color's chip offers only what can make a color.
                        model: slot.is-color ? root.color-generator-kinds : root.generator-kinds;
                        current-index: slot.kind-index;
                        selected(kind) => {
                          root.slot-kind-picked(index, kind);
                        }
                      }

                      // `if`, not `visible`, on every alternative: a hidden element still takes its
                      // width in a layout, and these are alternatives to each other.

                      // Which values, asked apart from how they are drawn — `trigger::Pool`. Not
                      // on a color, whose values are the palette below.
                      if slot.takes-pool && !slot.is-color: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Tick {
                          text: "list";
                          checked: slot.is-list;
                          toggled(on) => {
                            root.slot-pool-changed(index, on);
                          }
                        }
                      }
                      if slot.takes-pool && slot.is-color: Word {
                        text: "colors below";
                      }
                      if slot.takes-pool && slot.is-color: Rectangle { horizontal-stretch: 1; }

                      // Empty while the number is still to be chosen: a default range showing here
                      // read as one chosen (the audit of 2026-09-25, L11).
                      if slot.takes-pool && !slot.is-color && !slot.is-list: Entry {
                        value: slot.wanting ? "" : slot.low + " - " + slot.high;
                        placeholder: slot.wanting ? "choose a range" : "1 - 8";
                        font-family: Wf.code;
                        typed(text) => {
                          root.slot-typed(index, 1, text);
                        }
                        committed(text) => {
                          root.slot-range-edited(index, text);
                        }
                      }
                      if slot.takes-pool && !slot.is-color && slot.is-list: Entry {
                        value: slot.wanting ? "" : slot.values;
                        placeholder: slot.wanting ? "choose the numbers" : "3, 7, 1, 12 — in this order";
                        font-family: Wf.code;
                        typed(text) => {
                          root.slot-typed(index, 2, text);
                        }
                        committed(text) => {
                          root.slot-values-edited(index, text);
                        }
                      }

                      // **A fixed color: its swatch, which opens the picker**, and its code beside it.
                      // The picker is a popup inside this repeated item — see `picker-open-changed`.
                      if slot.is-color && slot.is-fixed: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Rectangle {
                          width: 40px;
                          height: 30px;
                          background: slot.swatch;
                          border-width: 1px;
                          border-color: swatch-touch.has-hover ? Wf.edge : Wf.field-edge;

                          swatch-touch := TouchArea {
                            clicked => {
                              picker.show();
                            }
                          }

                          // Watched from out here, not from inside the popup: a popup's contents
                          // are built when it opens, and a `changed is-open` in them never fires.
                          property <bool> picking: picker.is-open;
                          changed picking => {
                            root.picker-open-changed(self.picking);
                          }

                          picker := PopupWindow {
                            x: 0;
                            y: parent.height + 2px;
                            width: 300px;
                            // A click inside is a drag on a track; closing on it would make
                            // choosing a colour three trips.
                            close-policy: close-on-click-outside;

                            PickerBody {
                              swatch: slot.swatch;
                              hue: slot.hue;
                              sat: slot.sat;
                              val: slot.val;
                              moved(h, s, v) => {
                                root.slot-color-changed(index, h, s, v);
                              }
                            }
                          }
                        }
                      }

                      if slot.is-fixed && !slot.is-osc-value: Entry {
                        value: slot.fixed;
                        placeholder: slot.is-color ? "#ff2040" : slot.wanting ? "choose one" : "value";
                        font-family: Wf.code;
                        typed(text) => {
                          root.slot-typed(index, 0, text);
                        }
                        committed(text) => {
                          root.slot-fixed-edited(index, text);
                        }
                      }
                      // An OSC value's box is 96 px, with its "send a value" tick beside it.
                      if slot.is-fixed && slot.is-osc-value: Entry {
                        width: 96px;
                        horizontal-stretch: 0;
                        value: slot.fixed;
                        placeholder: "value";
                        font-family: Wf.code;
                        typed(text) => {
                          root.slot-typed(index, 0, text);
                        }
                        committed(text) => {
                          root.slot-fixed-edited(index, text);
                        }
                      }

                      if slot.is-live: Pick {
                        model: root.live-sources;
                        current-index: slot.live-index;
                        selected(i) => {
                          root.slot-live-picked(index, i);
                        }
                      }

                      if slot.is-weighted: Entry {
                        value: slot.wanting ? "" : slot.weights;
                        placeholder: slot.wanting ? "choose them, 7:3, 12:1" : "7:3, 12:1 — value:weight";
                        font-family: Wf.code;
                        typed(text) => {
                          root.slot-typed(index, 3, text);
                        }
                        committed(text) => {
                          root.slot-weights-edited(index, text);
                        }
                      }

                      if slot.is-ramp: Pick {
                        width: 120px;
                        horizontal-stretch: 0;
                        model: root.ramp-shapes;
                        current-index: slot.shape-index;
                        selected(i) => {
                          root.slot-shape-picked(index, i);
                        }
                      }
                      if slot.is-ramp: Entry {
                        value: slot.wanting ? "" : slot.low + " - " + slot.high;
                        placeholder: slot.wanting ? "choose a range" : "0 - 1";
                        font-family: Wf.code;
                        typed(text) => {
                          root.slot-typed(index, 1, text);
                        }
                        committed(text) => {
                          root.slot-range-edited(index, text);
                        }
                      }

                      // The OSC value's "send a value": whether the address takes an argument.
                      if slot.is-osc-value: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Tick {
                          text: "send a value";
                          checked: root.send-value;
                          toggled(on) => {
                            root.send-value-changed(on);
                          }
                        }
                      }
                      if slot.is-osc-value || (!slot.takes-pool && !slot.is-fixed && !slot.is-live
                          && !slot.is-ramp && !slot.is-weighted): Rectangle {
                        horizontal-stretch: 1;
                      }

                      if slot.takes-pool: Word {
                        // `Generator::Config::noRepeatWithin`.
                        text: "no repeat";
                      }
                      if slot.takes-pool: Count {
                        width: 56px;
                        value: slot.no-repeat;
                        minimum: 0;
                        maximum: 64;
                        typed(v) => {
                          root.slot-typed(index, 5, v);
                        }
                        edited(v) => {
                          root.slot-no-repeat-changed(index, v);
                        }
                      }

                      // What this slot last produced, once it has produced anything.
                      if slot.last != "": Produced {
                        value: slot.last;
                      }
                    }

                    // A tempo-normalised value's range, and a ramp's period, on a second line under
                    // the slot's own.
                    if slot.is-live && slot.is-normalised: HorizontalLayout {
                      height: 34px;
                      spacing: 10px;
                      Rectangle { width: 70px; }
                      Word {
                        text: "across BPM";
                      }
                      Entry {
                        width: 120px;
                        horizontal-stretch: 0;
                        value: slot.normalise;
                        placeholder: "20 - 500";
                        font-family: Wf.code;
                        typed(text) => {
                          root.slot-typed(index, 4, text);
                        }
                        committed(text) => {
                          root.slot-normalise-edited(index, text);
                        }
                      }
                      Note {
                        text: "is 0 to 1";
                      }
                    }
                    if slot.is-ramp: HorizontalLayout {
                      height: 34px;
                      spacing: 10px;
                      Rectangle { width: 70px; }
                      Word {
                        text: "over";
                      }
                      Count {
                        width: 64px;
                        value: slot.ramp-bars;
                        minimum: 1;
                        maximum: 64;
                        typed(v) => {
                          root.slot-typed(index, 6, v);
                        }
                        edited(v) => {
                          root.slot-ramp-bars-changed(index, v);
                        }
                      }
                      Word {
                        text: "bars";
                      }
                      // A float sweeps and an int steps — see `Generator::nextRamp`.
                      VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Tick {
                          text: "whole numbers";
                          checked: !slot.ramp-float;
                          toggled(on) => {
                            root.slot-ramp-float-changed(index, !on);
                          }
                        }
                      }
                      Rectangle { horizontal-stretch: 1; }
                    }
                  }
                }

                // An OSC rule sending the address alone has no value slot, so its band says that
                // and keeps the tick that puts the value back.
                if root.sends-osc && !root.send-value && !root.none: Band {
                  height: 48px;
                  HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 10px;
                    Text {
                      width: 70px;
                      horizontal-stretch: 0;
                      text: "value";
                      color: Wf.slot-name;
                      font-family: Wf.code;
                      font-size: 15px;
                      vertical-alignment: center;
                    }
                    VerticalLayout {
                      alignment: center;
                      horizontal-stretch: 0;
                      Tick {
                        text: "send a value";
                        checked: false;
                        toggled(on) => {
                          root.send-value-changed(on);
                        }
                      }
                    }
                    Note {
                      text: "the address goes out with no argument";
                    }
                  }
                }

                // **The colours a shuffle shuffles, as colours**: the chip above says how they are
                // drawn and this says what they are. Each swatch opens the picker. They wrap: Slint
                // has no wrapping layout, so each is placed on a grid of 48 px cells.
                if root.palette-shown: Band {
                  height: 2px + 8px + swatches.lines * 38px - 8px + 6px + 18px + 8px;

                  Text {
                    x: 11px;
                    y: 1px + 8px + (30px - self.height) / 2;
                    width: 70px;
                    text: "palette";
                    color: Wf.slot-name;
                    font-family: Wf.code;
                    font-size: 15px;
                  }

                  swatches := Rectangle {
                    x: 11px + 80px;
                    y: 1px + 8px;
                    width: parent.width - self.x - 11px;
                    height: self.lines * 38px - 8px;
                    property <int> per-line: max(1, Math.floor((self.width + 8px) / 48px));
                    property <int> lines: Math.ceil((root.palette.length + 1) / self.per-line);

                    for entry[index] in root.palette: Rectangle {
                      x: Math.mod(index, swatches.per-line) * 48px;
                      y: Math.floor(index / swatches.per-line) * 38px;
                      width: 40px;
                      height: 30px;
                      background: entry.swatch;
                      border-width: 1px;
                      border-color: entry-touch.has-hover ? Wf.edge : Wf.field-edge;

                      entry-touch := TouchArea {
                        clicked => {
                          entry-picker.show();
                        }
                      }

                      // From out here, for the reason the fixed colour's picker gives. This is the
                      // picker that crashed: its swatch is a repeated item.
                      property <bool> picking: entry-picker.is-open;
                      changed picking => {
                        root.picker-open-changed(self.picking);
                      }

                      entry-picker := PopupWindow {
                        x: 0;
                        y: parent.height + 2px;
                        width: 300px;
                        close-policy: close-on-click-outside;

                        PickerBody {
                          swatch: entry.swatch;
                          hue: entry.hue;
                          sat: entry.sat;
                          val: entry.val;
                          has-code: true;
                          hex: entry.hex;
                          moved(h, s, v) => {
                            root.palette-color-changed(index, h, s, v);
                          }
                          hex-typed(t) => {
                            root.palette-typed(index, t);
                          }
                          hex-committed(t) => {
                            root.palette-hex-edited(index, t);
                          }
                          remove-clicked => {
                            // **Closed first, then removed**: the button is inside the popup and
                            // the popup belongs to the swatch being taken away. And the keyboard
                            // back to the window before either, since its focus dies with it.
                            keys.focus();
                            entry-picker.close();
                            root.palette-removed(index);
                          }
                        }
                      }
                    }

                    // In the cell after the last swatch, wherever that falls.
                    Btn {
                      x: Math.mod(root.palette.length, swatches.per-line) * 48px;
                      y: Math.floor(root.palette.length / swatches.per-line) * 38px;
                      width: 30px;
                      height: 30px;
                      text: "+";
                      font-size: 15px;
                      pad: 0px;
                      enabled: !root.none;
                      clicked => {
                        root.palette-added();
                      }
                    }
                  }

                  Text {
                    x: 11px + 80px;
                    y: swatches.y + swatches.height + 6px;
                    width: parent.width - self.x - 11px;
                    height: 18px;
                    text: root.palette.length == 0
                      ? "no colors yet — + adds one"
                      : root.palette.length + " colors, drawn the way the chip above says";
                    color: Wf.ink2;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                  }
                }
              }

              // --- D · then send -----------------------------------------------------------------
              // **A list, where there was a tick box.** §7.4: Resolume's connect takes 1 for press
              // and 0 for release — and a rig needed more than that from one trigger: *"so each
              // trigger can send multiple things, spaced by time or beats/bars"*. Every delay is
              // counted from the fire, never from the row above (`trigger::FollowUp`).
              Section {
                letter: "D";
                title: "then send";
                folded: root.then-folded;
                summary: root.then-summary;
                enabled: !root.none;
                has-add: true;
                add-enabled: root.can-add-follow-up;
                fold-clicked => {
                  root.fold-clicked(3);
                }
                add-clicked => {
                  root.follow-up-added();
                }

                if root.follow-ups.length == 0: HorizontalLayout {
                  height: 34px;
                  Note {
                    text: root.none ? "" : "nothing — this trigger sends once and is done";
                  }
                }

                // Two lines — what is sent, then when — with the × at the right.
                for owed[index] in root.follow-ups: Band {
                  height: 92px;

                  VerticalLayout {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px - 24px - 10px;
                    height: parent.height - 16px;
                    spacing: 8px;

                    HorizontalLayout {
                      height: 34px;
                      spacing: 10px;
                      // "release (same note)" first: it names what it inherits, which is the one
                      // choice that follows a number the rule *drew*.
                      Pick {
                        width: 210px;
                        horizontal-stretch: 0;
                        model: root.follow-kinds;
                        current-index: owed.kind-index;
                        selected(kind) => {
                          root.follow-kind-picked(index, kind);
                        }
                      }
                      if owed.takes-number: Text {
                        text: owed.number-label;
                        color: Wf.ink;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                      }
                      if owed.takes-number: Count {
                        width: 64px;
                        value: owed.number;
                        minimum: 0;
                        maximum: 127;
                        typed(v) => {
                          root.follow-typed(index, 2, v);
                        }
                        edited(v) => {
                          root.follow-number-changed(index, v);
                        }
                      }
                      if owed.takes-value: Text {
                        text: owed.value-label;
                        color: Wf.ink;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                      }
                      if owed.takes-value: Entry {
                        width: 80px;
                        horizontal-stretch: 0;
                        value: owed.value;
                        placeholder: "0";
                        font-family: Wf.code;
                        typed(text) => {
                          root.follow-typed(index, 0, text);
                        }
                        committed(text) => {
                          root.follow-value-edited(index, text);
                        }
                      }
                      Rectangle { horizontal-stretch: 1; }
                    }

                    HorizontalLayout {
                      height: 34px;
                      spacing: 10px;
                      Text {
                        width: 36px;
                        horizontal-stretch: 0;
                        text: "after";
                        color: Wf.ink;
                        font-size: 15px;
                        vertical-alignment: center;
                      }
                      // Milliseconds or beats, and the difference is musical: a device's lag is a
                      // number of milliseconds, and letting go two beats later is a length of music.
                      Entry {
                        width: 64px;
                        horizontal-stretch: 0;
                        value: owed.delay;
                        font-family: Wf.code;
                        typed(text) => {
                          root.follow-typed(index, 1, text);
                        }
                        committed(text) => {
                          root.follow-delay-edited(index, text);
                        }
                      }
                      Pick {
                        width: 100px;
                        horizontal-stretch: 0;
                        model: root.follow-up-units;
                        current-index: owed.unit;
                        selected(unit) => {
                          root.follow-unit-picked(index, unit);
                        }
                      }
                      // What a release really resolves to, which the row cannot show by listing its
                      // own fields.
                      Text {
                        text: owed.summary;
                        color: Wf.ink;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 20px;
                        overflow: elide;
                      }
                    }
                  }

                  Btn {
                    x: parent.width - 10px - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 24px;
                    height: 24px;
                    text: "×";
                    font-size: 14px;
                    pad: 0px;
                    clicked => {
                      // The keyboard back to the window first, as a button takes it: a box typed
                      // into on a row below stayed lit over the row that moved up into its place
                      // (the audit of 2026-09-25, M18).
                      keys.focus();
                      root.follow-up-removed(index);
                    }
                  }
                }
              }
            }
          }
        }
      }

      // --- the divider over the log: drag it to give the log more lines or fewer -------------------
      // Only while the log is open: folded, it has nothing to drag (HANDOFF §0.5).
      Rectangle {
        height: 10px;
        vertical-stretch: 0;

        if root.log-open: Rectangle {
          x: (parent.width - self.width) / 2;
          y: 3px;
          width: 56px;
          height: 4px;
          border-radius: 2px;
          background: grip.pressed || grip.has-hover ? Wf.scrollbar-hover : Wf.scrollbar;
        }

        grip := TouchArea {
          enabled: root.log-open;
          mouse-cursor: root.log-open ? MouseCursor.ns-resize : MouseCursor.default;
          // The movement since the last report: the divider moves with the log it resizes.
          moved => {
            if (self.pressed) {
              root.log-lines-height = clamp(root.log-lines-height - (self.mouse-y - self.pressed-y),
                root.log-lines-least, root.log-lines-most);
            }
          }
        }
      }

      // --- the event log -------------------------------------------------------------------------
      // The window's full width along the bottom. **Folded to start**: one row, reading the latest
      // line. Open: its lines, newest first — the thing that just happened is what an operator is
      // looking for — in columns of when, which rule, what went out.
      HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        vertical-stretch: 0;

        Rectangle {
          background: Wf.sheet;
          height: root.log-open ? 42px + root.log-lines-height + 10px : 40px;

          VerticalLayout {
            spacing: 0px;

            HorizontalLayout {
              height: root.log-open ? 42px : 40px;
              padding-left: 16px;
              padding-right: 16px;
              padding-top: root.log-open ? 8px : 6px;
              padding-bottom: root.log-open ? 6px : 6px;
              spacing: 14px;

              Text {
                text: "event log";
                color: Wf.ink;
                font-size: 18px;
                font-weight: 800;
                letter-spacing: -0.36px;
                vertical-alignment: center;
                horizontal-stretch: 0;
              }
              if root.log-open: Text {
                text: "newest first";
                color: Wf.ink2;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
              }
              if !root.log-open: HorizontalLayout {
                horizontal-stretch: 1;
                min-width: 20px;
                spacing: 14px;
                if root.log.length > 0: Text {
                  text: root.log[0].when;
                  color: Wf.ink2;
                  font-family: Wf.code;
                  font-size: 13px;
                  vertical-alignment: center;
                  horizontal-stretch: 0;
                }
                if root.log.length > 0: Text {
                  text: root.log[0].rule;
                  color: Wf.ink;
                  font-size: 14px;
                  vertical-alignment: center;
                  horizontal-stretch: 0;
                  max-width: 230px;
                  overflow: elide;
                }
                if root.log.length > 0: Text {
                  text: root.log[0].message + (root.log[0].muted ? "  (muted, not sent)" : "");
                  color: Wf.ink2;
                  font-family: Wf.code;
                  font-size: 13px;
                  vertical-alignment: center;
                  horizontal-stretch: 1;
                  min-width: 20px;
                  overflow: elide;
                }
                if root.log.length == 0: Text {
                  text: "nothing has fired yet";
                  color: Wf.ink2;
                  font-size: 14px;
                  vertical-alignment: center;
                  horizontal-stretch: 1;
                  overflow: elide;
                }
              }
              VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Btn {
                  text: "clear";
                  height: 28px;
                  font-size: 14px;
                  pad: 10px;
                  clicked => {
                    root.log-cleared();
                  }
                }
              }
              FoldArrow {
                folded: !root.log-open;
                clicked => {
                  root.fold-clicked(4);
                }
              }
            }

            if root.log-open: Scroller {
              height: root.log-lines-height;
              VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 0px;
                for line in root.log: HorizontalLayout {
                  height: 18px;
                  spacing: 14px;
                  Text {
                    width: 48px;
                    text: line.when;
                    color: Wf.ink2;
                    font-family: Wf.code;
                    font-size: 13px;
                    vertical-alignment: center;
                  }
                  Text {
                    width: 230px;
                    text: line.rule;
                    color: Wf.ink;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                  }
                  HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    // Its own width and no more, so the muted note follows it, and the first thing
                    // to give way.
                    Text {
                      text: line.message;
                      color: Wf.ink2;
                      font-family: Wf.code;
                      font-size: 13px;
                      vertical-alignment: center;
                      horizontal-stretch: 1;
                      max-width: self.preferred-width;
                      min-width: 20px;
                      overflow: elide;
                    }
                    // A muted rule still runs and still "fires", which keeps it in phase; nothing
                    // left, and the line says so (the audit's M11), drawn apart.
                    if line.muted: Text {
                      text: " (muted, not sent)";
                      color: Wf.ink-off;
                      font-family: Wf.code;
                      font-size: 13px;
                      vertical-alignment: center;
                      horizontal-stretch: 0;
                    }
                    Rectangle { horizontal-stretch: 1; }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
