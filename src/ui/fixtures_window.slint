// The lighting patch — what fixtures there are, where they are addressed, and what each of
// their channels does — in the Weltformat-dark look of the rule editor, as the operator approved it
// on 2026-09-30 (the mockup is design/weltformat-dark/patch1.html and png/p1-*.png).
//
// **A window of its own, for the reason the rule editor is one.** A patch is set up once and
// then not touched for the rest of the night, while the rules are edited during the set; one
// screen holding both would make the thing that changes hourly share space with the thing
// that changes monthly. It also means the patch can sit on a second monitor while a fixture
// is being addressed from the truss.
//
// **Master-detail, like the rule editor**, and built from its parts (editor_parts.slint): the list
// of fixtures down the left, whose dot is each fixture's "in the show" switch as a rule's dot is its
// mute; and on the right a top row and three sheets that fold — A where it is, B what its channels
// do, C how far a head may move.
//
// Nothing here talks to the lighting engine. `ui::FixturesController` owns the patch, edits
// its own copy and posts it whole — see its header, and `RulesController`'s, for why the
// output thread's copy cannot be the one being edited. **And nothing here sets its own value**:
// every control is weltformat.slint's, which says what was asked for and shows what the controller
// then holds — so no row is ever built again to catch up with its model.

import { Btn, Count, Entry, Meter, Pick, Scroller, SpanTrack, Tick, Wf } from "weltformat.slint";
import { FocusSink } from "theme.slint";
import { Band, Mark, Note, RowLabel, Section, Word } from "editor_parts.slint";

/// One row of the fixture list — everything it shows without the editor being open.
export struct FixtureRow {
  name: string,
  /// "0 · 1-3", the universe and the channels it occupies. What an operator checks against
  /// the display on the back of the fixture, so it is spelled the way that display is.
  where: string,
  group: string,
  enabled: bool,
  /// Empty when the fixture is usable; otherwise `dmx::problemWith`, which is why it is not.
  /// Held and shown rather than refused — the same policy a rule follows.
  problem: string,
}

/// One channel of the fixture being edited.
export struct ChannelRow {
  /// The DMX number this channel really is — the fixture's start address plus its offset.
  /// Shown because it is the number on the fixture's own display and in its manual, and
  /// because an off-by-one here is a rig where every color is on the wrong component.
  number: int,
  /// Which `dmx::Role`, as an index into `roles`.
  role-index: int,
  /// Where this channel sits when nothing is driving it — `dmx::Fixture::parked`. The
  /// shutter that has to be open before a dimmer means anything lives here, and a rig where
  /// "the dimmer rule does nothing" is nearly always this.
  parked: int,
  /// What takt4 is sending on this channel right now, 0-255. The one thing in this window
  /// that moves on its own, and the only way to see a fade actually happening without a
  /// fixture plugged in.
  live: int,
  /// What the fixture's definition calls the channel — "Pan/Tilt Speed", "red · Cell 3" — for a
  /// fixture an import made; empty for one patched by hand (`dmx::Fixture::labels`).
  label: string,
  /// What the import had to say about the channel — "second focus — takt4 drives the first" —
  /// on a line of its own under its band; empty for most.
  note: string,
  /// Which head a pan, tilt or fine channel moves, on a fixture with more than one
  /// (`dmx::headsOf`) — what a rule's "heads" means; 0 for every other channel.
  head: int,
}

/// One definition in the preset's library, as the import lists it.
export struct LibraryRow {
  /// "ayrton · ", in the secondary ink before the model; empty when the file named none.
  maker: string,
  /// "Diablo S" — or "Diablo S (2023-04-20 …)" where two of it are kept side by side.
  model: string,
  /// "2 fixtures", "1 fixture", "no fixture".
  users: string,
  /// No fixture is made from it, so its × can take it out of the library.
  removable: bool,
  picked: bool,
}

/// One mode of the definition being imported.
export struct ModeRow {
  name: string,
  /// "25", or "18 + 28" for a mode that needs two start addresses.
  channels: string,
  /// What takt4 drives in it, all of it: "dimmer ×2 · RGBW ×7 · pan/tilt 16-bit".
  drives: string,
  /// How many of its channels have no role.
  unused: int,
  /// Why it cannot be imported, in plain words; empty when it can.
  refused: string,
  /// What the file had to say about the mode, one note to a line — shown while it is picked.
  notes: string,
  picked: bool,
}

/// One fixture in the list: its dot — which is its "in the show" switch — its name, and under it
/// where it sits and its group, or in amber why it cannot be driven. On the picked row and the row
/// under the pointer, copy and delete at the right; at rest, "left out" for a fixture out of the show.
component FixtureLine inherits Rectangle {
  in property <FixtureRow> entry;
  /// The one the editor is showing: lit and edged.
  in property <bool> shown;
  callback pressed();
  callback dot-clicked(bool);
  callback copy-clicked();
  callback kill-clicked();

  // All four hovers, or moving onto a mark would take the hover off the row and the mark with it.
  private property <bool> showing: root.shown || pick.has-hover || dot-touch.has-hover
    || copy-mark.has-hover || kill-mark.has-hover;
  private property <color> dot-color: root.entry.problem != "" ? Wf.holding : Wf.locked;

  // 59, so the rows sit 61 apart as the approved picture has them.
  height: 59px;
  background: root.shown ? Wf.row-picked : transparent;
  border-width: root.shown ? 2px : 0px;
  border-color: Wf.edge;

  // **First, so it is underneath the dot and the marks** (see `RuleLine`).
  pick := TouchArea {
    pointer-event(event) => {
      if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
        root.pressed();
      }
    }
  }

  // The dot: 14 px in a 28 px target that lights under the pointer. Filled while the fixture is in
  // the show, a 2.5 px ring while it is left out; amber when it cannot be driven.
  Rectangle {
    x: 3px;
    y: 7px;
    width: 28px;
    height: 28px;
    background: dot-touch.has-hover ? Wf.face-hover : transparent;
    accessible-role: checkbox;
    accessible-label: "in the show: " + root.entry.name;
    accessible-checked: root.entry.enabled;
    accessible-checkable: true;
    accessible-action-default => {
      root.dot-clicked(!root.entry.enabled);
    }

    Rectangle {
      x: 7px;
      y: 7px;
      width: 14px;
      height: 14px;
      border-radius: 7px;
      background: root.entry.enabled ? root.dot-color : transparent;
      border-width: root.entry.enabled ? 0px : 2.5px;
      border-color: root.dot-color;
    }

    dot-touch := TouchArea {
      clicked => {
        root.dot-clicked(!root.entry.enabled);
      }
    }
  }

  Text {
    x: 35px;
    y: 7px;
    width: parent.width - self.x - 9px - (root.showing ? 48px : right.preferred-width + (right.text == "" ? 0px : 4px));
    height: 28px;
    text: root.entry.name == "" ? "(unnamed)" : root.entry.name;
    color: root.entry.enabled ? Wf.ink : Wf.ink-off;
    font-size: 14px;
    vertical-alignment: center;
    overflow: elide;
  }

  right := Text {
    x: parent.width - 9px - self.width;
    y: 7px;
    width: self.preferred-width;
    height: 28px;
    visible: !root.showing;
    text: root.entry.enabled ? "" : "left out";
    color: Wf.ink2;
    font-size: 13px;
    vertical-alignment: center;
  }

  copy-mark := Mark {
    x: parent.width - 9px - 44px;
    y: 11px;
    copy: true;
    what: "fixture " + root.entry.name;
    visible: root.showing;
    clicked => {
      root.copy-clicked();
    }
  }
  kill-mark := Mark {
    x: parent.width - 9px - 20px;
    y: 11px;
    what: "fixture " + root.entry.name;
    visible: root.showing;
    clicked => {
      root.kill-clicked();
    }
  }

  // Where it sits, in Chivo Mono, and its group in words — or why it cannot be driven, where the
  // address would be, because the address is usually what is wrong with it.
  HorizontalLayout {
    x: 35px;
    y: 36px;
    width: parent.width - self.x - 9px;
    height: 16px;
    spacing: 0px;

    if root.entry.problem == "": Text {
      text: root.entry.where;
      color: Wf.ink2;
      font-family: Wf.code;
      font-size: 13px;
      vertical-alignment: center;
      horizontal-stretch: 0;
    }
    if root.entry.problem == "" && root.entry.group != "": Text {
      text: " · " + root.entry.group;
      color: Wf.ink2;
      font-size: 13px;
      vertical-alignment: center;
      horizontal-stretch: 1;
      min-width: 0px;
      overflow: elide;
    }
    if root.entry.problem != "": Text {
      text: root.entry.problem;
      color: Wf.holding;
      font-size: 13px;
      vertical-alignment: center;
      horizontal-stretch: 1;
      min-width: 0px;
      overflow: elide;
    }
    Rectangle { horizontal-stretch: 1; }
  }
}

/// The radio dot of a list one entry of which is picked: a 14 px ring, filled when picked, and
/// dashed grey for an entry that cannot be (a mode an import refuses).
component Radio inherits Rectangle {
  in property <bool> on;
  in property <bool> usable: true;

  width: 14px;
  height: 14px;
  border-radius: 7px;
  border-width: 2px;
  border-color: root.usable ? Wf.ink : Wf.off-edge;
  background: root.on && root.usable ? Wf.ink : transparent;
}

/// One definition in the preset's library, in the import's sheet A: its dot, its maker and model,
/// how many fixtures are made from it, and — only when none is — the × that takes it out.
component LibraryLine inherits Rectangle {
  in property <LibraryRow> entry;
  callback pressed();
  callback kill-clicked();

  height: 40px;
  background: Wf.band;
  border-width: root.entry.picked ? 2px : 0px;
  border-color: Wf.edge;
  accessible-role: button;
  accessible-label: "import " + root.entry.maker + root.entry.model;
  accessible-action-default => {
    root.pressed();
  }

  // First, so it is under the ×.
  touch := TouchArea {
    clicked => {
      root.pressed();
    }
  }

  Radio {
    x: 9px;
    y: (parent.height - self.height) / 2;
    on: root.entry.picked;
  }

  HorizontalLayout {
    x: 36px;
    width: parent.width - self.x - 10px;
    height: parent.height;
    spacing: 0px;

    Text {
      text: root.entry.maker;
      color: Wf.ink2;
      font-size: 15px;
      vertical-alignment: center;
      horizontal-stretch: 0;
      min-width: 0px;
      overflow: elide;
    }
    Text {
      text: root.entry.model;
      color: Wf.ink;
      font-size: 15px;
      vertical-alignment: center;
      horizontal-stretch: 1;
      min-width: 0px;
      overflow: elide;
    }
    Text {
      text: root.entry.users;
      color: root.entry.removable ? Wf.ink-off : Wf.ink2;
      font-size: 14px;
      vertical-alignment: center;
      horizontal-stretch: 0;
    }
    // The ×'s column, held whether or not it is drawn, so the counts line up.
    Rectangle {
      width: 30px;
      horizontal-stretch: 0;
    }
  }

  Mark {
    x: parent.width - 10px - 20px;
    y: (parent.height - self.height) / 2;
    what: "definition " + root.entry.model + " from the library";
    visible: root.entry.removable;
    clicked => {
      if (root.entry.removable) {
        root.kill-clicked();
      }
    }
  }
}

/// One mode of the definition being imported, in the import's sheet B: a band of two lines — its
/// dot, its name, its channels and how many have no role; under them what takt4 drives in it,
/// the whole of it, wrapped rather than cut — or, for one that cannot be imported, why, in amber
/// and in plain words. Picked, the file's notes on it follow.
component ModeLine inherits Rectangle {
  in property <ModeRow> entry;
  callback pressed();

  private property <bool> usable: root.entry.refused == "";

  background: Wf.band;
  border-width: root.entry.picked ? 2px : 0px;
  border-color: Wf.edge;
  height: lines.preferred-height;
  accessible-role: button;
  accessible-label: "mode " + root.entry.name;
  accessible-enabled: root.usable;
  accessible-action-default => {
    if (root.usable) {
      root.pressed();
    }
  }

  touch := TouchArea {
    enabled: root.usable;
    clicked => {
      root.pressed();
    }
  }

  Radio {
    x: 9px;
    y: 11px;
    on: root.entry.picked;
    usable: root.usable;
  }

  lines := VerticalLayout {
    padding-left: 36px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 7px;
    spacing: 1px;

    HorizontalLayout {
      height: 28px;
      spacing: 10px;
      Text {
        text: root.entry.name;
        color: root.usable ? Wf.ink : Wf.ink-off;
        font-size: 15px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        min-width: 0px;
        overflow: elide;
      }
      Text {
        width: 80px;
        text: root.entry.channels;
        color: Wf.ink;
        font-family: Wf.code;
        font-size: 15px;
        horizontal-alignment: right;
        vertical-alignment: center;
      }
      Text {
        width: 64px;
        text: root.usable ? root.entry.unused : "";
        color: Wf.ink2;
        font-family: Wf.code;
        font-size: 15px;
        horizontal-alignment: right;
        vertical-alignment: center;
      }
    }
    Text {
      text: root.usable ? root.entry.drives : "can't be imported: " + root.entry.refused;
      color: root.usable ? Wf.ink2 : Wf.holding;
      font-size: 14px;
      wrap: word-wrap;
    }
    Text {
      height: root.entry.picked && root.entry.notes != "" ? self.preferred-height : 0px;
      visible: root.entry.picked && root.entry.notes != "";
      text: root.entry.notes;
      color: Wf.ink2;
      font-size: 13px;
      wrap: word-wrap;
    }
  }
}

export component FixturesWindow inherits Window {
  // takt4's icon in the title bar and the taskbar (assets/icon, from tools/make_icon.py). 64 px: four
  // times the title bar's 16 and twice the taskbar's 32, which the system scales it down to.
  icon: @image-url("../../assets/icon/takt4-64.png");
  title: "takt4 — fixtures";
  // See `RulesWindow`: these do not decide what the window opens at. `ui::kFixturesWindowWidth`
  // is the size actually used, set before the first show: 1000 x 800, the mockup's.
  preferred-width: 1000px;
  preferred-height: 800px;
  min-width: 880px;
  min-height: 520px;
  background: Wf.page;
  default-font-family: Wf.sans;
  default-font-size: 15px;
  default-font-weight: 500;

  // --- the shape of the window -----------------------------------------------------------------
  /// How wide the list is: 260 to start, as the rule editor's, dragged at the gap between it and
  /// the editor — and given way to the editor's rows, as the rule editor's list is (`list-max`).
  in-out property <length> list-width: 260px;
  private property <length> list-wanted: 260px;
  private property <length> list-min: 200px;
  // A fixture's channel names elide down to 66 px at the narrowest; the list gives way first, so
  // they keep the 120 they had before the "head" column, where the window has it to give.
  function list-max() -> length {
    return max(root.list-min, min(root.width * 0.4, root.width - 20px - root.body-least-width
      - (root.has-labels ? 54px : 0px)));
  }
  function fit-list() {
    root.list-width = clamp(root.list-wanted, root.list-min, root.list-max());
  }
  changed width => {
    root.fit-list();
  }
  changed body-least-width => {
    root.fit-list();
  }
  changed has-labels => {
    root.fit-list();
  }
  /// The three sheets' folds — A where, B channels, C how far it moves. The window's, not the
  /// fixture's, and remembered across launches with the rule editor's (machine settings).
  in-out property <bool> where-folded;
  in-out property <bool> channels-folded;
  in-out property <bool> moves-folded;
  /// 0 to 2: the controller folds it, having committed what was typed; 3 to 5, the import's A, B
  /// and C, which are not remembered.
  callback fold-clicked(int);

  in-out property <[FixtureRow]> fixtures;
  /// Which fixture the editor is on, or -1 when the patch is empty.
  in-out property <int> selected: -1;

  // --- the selected fixture ----------------------------------------------------------
  in-out property <string> name;
  in-out property <string> group;
  in-out property <string> universe;
  in-out property <int> address: 1;
  in-out property <bool> enabled: true;
  /// Every `dmx::Role`, in `kRoles` order — what a channel's dropdown offers.
  in-out property <[string]> roles;
  /// The ready-made channel maps, with "custom" at index 0 so that picking nothing is a
  /// state rather than a fixture nobody meant — or, for a fixture an import made, its
  /// definition's modes, the one it is in first as "… (edited)" when its channels were changed by
  /// hand, so picking that mode again puts them back.
  in-out property <[string]> modes;
  in-out property <int> mode-index;
  /// Beside each mode in the open list, how many channels it has — for a definition's modes.
  in-out property <[string]> mode-asides;
  /// Under the open list: what picking does — for a definition's modes.
  in-out property <string> mode-footnote;
  /// What the mode row says after the dropdown: "fills in the channels below", or where the
  /// fixture's definition came from — "from ayrton · Diablo S".
  in-out property <string> mode-note: "fills in the channels below";
  in-out property <[ChannelRow]> channels;
  /// Whether any channel has a name from a definition: B then has a column for them.
  in-out property <bool> has-labels;
  /// Whether the fixture has more than one head: B then says which each pan and tilt is.
  in-out property <bool> has-heads;

  // --- the import, in the editor's place while it is open --------------------------------------
  /// What IMPORT beside the list's + opens: sheets A (which definition), B (which mode) and C
  /// (where, and how many), with the editor kept and hidden behind them — a box being typed in
  /// there is committed before this opens, and nothing of it is taken down.
  in-out property <bool> importing;
  /// A: the preset's library, by maker and model.
  in-out property <[LibraryRow]> library-rows;
  /// The file read last, as "Prolights@AstraWash7PIX.gdtf · Prolights · AstraWash7PIX", or what
  /// FROM A FILE… will read when nothing has been.
  in-out property <string> import-file-line: "a GDTF file (.gdtf) or an Open Fixture Library file (.json)";
  /// Under it: whether the file is new to the library, the same as an entry, or could not be
  /// read and why (`import-file-error`, in amber).
  in-out property <string> import-file-note;
  in-out property <bool> import-file-error;
  /// A file the library has a different version of: the question, and what each answer does.
  in-out property <bool> import-asking;
  in-out property <string> ask-question;
  in-out property <string> ask-library;
  in-out property <string> ask-file;
  in-out property <string> ask-replace;
  /// B and C are there once a definition is picked and no question is open.
  in-out property <bool> import-picked;
  /// What A and B say while folded: "Elation · Rayzor 760", "Pixels 360Pan/Tilt".
  in-out property <string> import-definition;
  in-out property <string> import-mode;
  in-out property <[ModeRow]> mode-rows;
  /// C.
  in-out property <int> import-count: 1;
  in-out property <string> import-universe: "0";
  in-out property <int> import-address: 1;
  /// "channels 1 to 104 on universe 1, 52 each" — or why it cannot be imported there
  /// (`import-takes-error`, in amber, IMPORT then off).
  in-out property <string> import-takes;
  in-out property <bool> import-takes-error;
  /// Patched fixtures the block lands on. Allowed — either can be re-addressed after — and said.
  in-out property <string> import-overlap;
  in-out property <string> import-names;
  in-out property <bool> import-pair;
  in-out property <bool> import-can;
  in-out property <bool> import-type-folded;
  in-out property <bool> import-mode-folded;
  in-out property <bool> import-where-folded;
  callback import-clicked();
  callback import-cancelled();
  callback library-picked(int);
  callback library-removed(int);
  callback import-file-clicked();
  callback ask-replace-clicked();
  callback ask-keep-clicked();
  callback ask-cancel-clicked();
  callback import-mode-picked(int);
  callback import-count-changed(int);
  callback import-count-typed(int);
  callback import-universe-edited(string);
  callback import-universe-typed(string);
  callback import-address-changed(int);
  callback import-address-typed(int);
  callback import-confirmed();

  /// What a channel's TEST holds it at, and for how long.
  in-out property <int> test-level: 255;
  in-out property <int> test-seconds: 3;

  /// The movement window, as percentages — the numbers an operator sets from the stage.
  /// Only shown for a fixture that can move, because on a wash they mean nothing.
  in-out property <bool> moves;
  in-out property <float> pan-min: 0;
  in-out property <float> pan-max: 100;
  in-out property <float> tilt-min: 0;
  in-out property <float> tilt-max: 100;

  /// A line under the list: how many fixtures, how many universes, and what the Art-Net
  /// targets are doing with them. What tells "nothing is patched" from "nothing is plugged
  /// in", which look the same from the truss.
  in-out property <string> summary;
  /// The editor's own message — "Channel 72 at 255 for 3 s." — under the top row, amber when it
  /// says something could not be done.
  in-out property <string> status;
  in-out property <bool> status-error;

  // One selection, not a set — unlike the rule list, which gained ctrl- and shift-click
  // because a preset's worth of rules is something somebody prunes in one gesture. A patch is
  // built once, fixture by fixture, and is short.
  callback picked(int);
  callback added();
  /// Row N's own marks, which appear on the picked row and the row under the pointer.
  callback duplicated-at(int);
  callback removed-at(int);
  /// Row N's dot: in the show, or left out.
  callback enabled-changed(int, bool);

  /// The three text boxes: `edited` is the edit finished (Enter, a click away), `typed` every
  /// keystroke — kept by the controller and committed before any other action, and the only
  /// thing that makes a finished edit count (`FixturesController::draft_`).
  callback name-edited(string);
  callback name-typed(string);
  callback group-edited(string);
  callback group-typed(string);
  callback universe-edited(string);
  callback universe-typed(string);
  /// The number boxes, the same way round: `typed` is what Enter would set.
  callback address-changed(int);
  callback address-typed(int);
  callback fixture-enabled-changed(bool);
  callback mode-picked(int);
  callback channel-added();
  callback channel-removed(int);
  callback channel-role-picked(int, int);
  callback channel-parked-changed(int, int);
  callback channel-parked-typed(int, int);
  /// Holds one channel of the selected fixture at `test-level` for `test-seconds` — which
  /// channel, by index into `channels`. See `DmxEngine::holdChannel`.
  callback channel-tested(int);
  callback test-level-changed(int);
  callback test-level-typed(int);
  /// Said once a handle is let go, not on every pixel of the drag: each is a re-patch (H8).
  callback pan-range-changed(float, float);
  callback tilt-range-changed(float, float);
  /// Flashes every light-emitting channel of the selected fixture, so an operator in the truss
  /// can see which lamp they are patching.
  callback identify();

  /// For the tests: the least width the editor's column of sheets asks for, and the width it is
  /// given — a row wider than the pane is cut off at its edge (see `RulesWindow`).
  out property <length> body-least-width: sheets.min-width;
  out property <length> body-width: sheets.width;

  private property <bool> none: root.selected < 0;
  private property <int> last-channel: root.address + max(1, root.channels.length) - 1;

  // **Somewhere for a click on nothing to go.** See `FocusSink`: a text box in this window
  // commits when it loses the keyboard, and a click on a heading, a panel or the space
  // between two rows used to move the focus nowhere. First in the window, so it is *behind*
  // everything: what reaches it is a click on nothing.
  defocus := FocusSink { }
  TouchArea {
    clicked => {
      defocus.take();
    }
  }

  VerticalLayout {
    padding-top: 10px;
    padding-bottom: 10px;
    spacing: 0px;

    HorizontalLayout {
      vertical-stretch: 1;
      padding-left: 10px;
      spacing: 0px;

      // --- the list ------------------------------------------------------------------
      Rectangle {
        width: root.list-width;
        horizontal-stretch: 0;
        background: Wf.sheet;
        clip: true;

        VerticalLayout {
          spacing: 0px;

          // "fixtures", IMPORT and its +.
          HorizontalLayout {
            height: 46px;
            padding-left: 14px;
            padding-right: 10px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 6px;
            Text {
              text: "fixtures";
              color: Wf.ink;
              font-size: 18px;
              font-weight: 800;
              letter-spacing: -0.36px;
              vertical-alignment: center;
              horizontal-stretch: 1;
              overflow: elide;
            }
            // A fixture from its definition — a GDTF or Open Fixture Library file, or one this
            // preset has imported before — in the editor's place (the operator's decision 9).
            Btn {
              height: 28px;
              text: "import";
              accessible-text: "import fixtures from a definition";
              font-size: 14px;
              pad: 10px;
              clicked => {
                root.import-clicked();
              }
            }
            Btn {
              width: 28px;
              height: 28px;
              text: "+";
              accessible-text: "add a fixture";
              font-size: 15px;
              pad: 0px;
              clicked => {
                root.added();
              }
            }
          }

          // What the dots mean, since each is a switch — once there is a dot to mean anything. An
          // explicit height: an `if` in a vertical layout takes a share of the spare height otherwise.
          if root.fixtures.length > 0: HorizontalLayout {
            height: 24px;
            padding-left: 14px;
            padding-bottom: 8px;
            spacing: 6px;
            alignment: start;
            VerticalLayout {
              alignment: center;
              Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Wf.locked;
              }
            }
            Text {
              text: "in the show";
              color: Wf.ink2;
              font-size: 13px;
              vertical-alignment: center;
            }
            Rectangle { width: 2px; }
            VerticalLayout {
              alignment: center;
              Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                border-width: 2px;
                border-color: Wf.locked;
              }
            }
            Text {
              text: "left out — click a dot";
              color: Wf.ink2;
              font-size: 13px;
              vertical-alignment: center;
              overflow: elide;
            }
          }

          Scroller {
            vertical-stretch: 1;
            VerticalLayout {
              padding-left: 8px;
              padding-right: 8px;
              spacing: 2px;
              alignment: start;

              for row[index] in root.fixtures: FixtureLine {
                entry: row;
                shown: index == root.selected;
                pressed => {
                  // The keyboard back to the window first: a row took nothing, so a box being
                  // typed in stayed lit over the next fixture, holding what was typed for this one
                  // (the audit of 2026-09-25, M18).
                  defocus.take();
                  root.picked(index);
                }
                dot-clicked(on) => {
                  defocus.take();
                  root.enabled-changed(index, on);
                }
                copy-clicked => {
                  defocus.take();
                  root.duplicated-at(index);
                }
                kill-clicked => {
                  defocus.take();
                  root.removed-at(index);
                }
              }
            }
          }

          // The foot: how many, on how many universes, going where.
          VerticalLayout {
            padding-left: 14px;
            padding-right: 10px;
            padding-top: 10px;
            padding-bottom: 12px;
            Text {
              text: root.summary;
              color: Wf.ink2;
              font-size: 14px;
              wrap: word-wrap;
            }
          }
        }
      }

      // The gap between the list and the editor, which drags the list wider or narrower. Not
      // drawn; the pointer says what it is.
      Rectangle {
        width: 10px;
        horizontal-stretch: 0;
        TouchArea {
          mouse-cursor: ew-resize;
          moved => {
            if (self.pressed) {
              root.list-wanted = clamp(root.list-width + (self.mouse-x - self.pressed-x),
                root.list-min, root.list-max());
              root.fit-list();
            }
          }
        }
      }

      // --- the editor ----------------------------------------------------------------
      VerticalLayout {
        horizontal-stretch: 1;
        spacing: 10px;

        // The top row: in the show, its name and group, IDENTIFY — or, with nothing patched, what to
        // do — and under them, only while there is something to say, the editor's own message.
        HorizontalLayout {
          padding-right: 10px;
          vertical-stretch: 0;
          Rectangle {
            background: Wf.sheet;

            VerticalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: 10px;
              padding-bottom: 10px;
              spacing: 6px;

              // **One place, two contents**: the row of controls, or the note. Both are kept and one
              // is hidden, rather than built and destroyed — a box being typed in commits a turn of the
              // event loop after it loses the keyboard, and the last fixture's × would otherwise have
              // destroyed it first.
              Rectangle {
                height: root.none && !root.importing ? 44px : 34px;
                // The row's least width, which a layout inside a plain rectangle does not pass up on
                // its own — without it the list would not give way and the row would be cut off.
                min-width: root.importing ? import-row.min-width : top-row.min-width;

                // **The import's own row, in the same place** — and the editor's kept under it,
                // hidden: its boxes commit what was typed into them a turn after the click that
                // opened the import, and the operator asked that nothing typed there be lost
                // (2026-10-05).
                import-row := HorizontalLayout {
                  x: 0;
                  y: 0;
                  width: parent.width;
                  height: 34px;
                  visible: root.importing;
                  spacing: 10px;

                  Text {
                    text: "import fixtures";
                    color: Wf.ink;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    overflow: elide;
                  }
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Btn {
                      text: "cancel";
                      accessible-text: "cancel the import";
                      enabled: root.importing;
                      clicked => {
                        root.import-cancelled();
                      }
                    }
                  }
                }

                top-row := HorizontalLayout {
                  x: 0;
                  y: 0;
                  width: parent.width;
                  height: 34px;
                  visible: !root.none && !root.importing;
                  spacing: 10px;

                  // What the switch does rather than "on", which read as the lamp being lit.
                  Tick {
                    text: "in the show";
                    horizontal-stretch: 0;
                    checked: root.enabled;
                    toggled(on) => {
                      root.fixture-enabled-changed(on);
                    }
                  }

                  // **Labelled**: a placeholder only shows while the box is empty, and a patched
                  // fixture's name and group are two boxes reading "head 1" and "heads".
                  Word {
                    text: "name";
                  }
                  name-box := Entry {
                    value: root.name;
                    placeholder: "what a rule aims at";
                    min-width: 120px;
                    preferred-width: 204px;
                    max-width: 300px;
                    typed(text) => {
                      root.name-typed(text);
                    }
                    committed(text) => {
                      root.name-edited(text);
                    }
                  }

                  Word {
                    text: "group";
                  }
                  // A second name any number of fixtures share, so a rule can say "heads" and a
                  // re-rig is an edit to the patch rather than to every rule.
                  group-box := Entry {
                    value: root.group;
                    placeholder: "optional";
                    min-width: 90px;
                    preferred-width: 150px;
                    max-width: 150px;
                    typed(text) => {
                      root.group-typed(text);
                    }
                    committed(text) => {
                      root.group-edited(text);
                    }
                  }

                  Rectangle {
                    horizontal-stretch: 1;
                  }

                  // The one control in this window, besides TEST, that sends anything.
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Btn {
                      text: "identify";
                      primary: true;
                      clicked => {
                        root.identify();
                      }
                    }
                  }
                }

                // Nothing patched: what to press, and what to set.
                Text {
                  x: 0;
                  y: 0;
                  width: parent.width;
                  height: parent.height;
                  visible: root.none && !root.importing;
                  text: "Nothing patched. Press import to bring in a fixture from its file, or + to add one by hand, and set its start address to the one on the back of the fixture.";
                  color: Wf.ink2;
                  font-size: 15px;
                  wrap: word-wrap;
                  vertical-alignment: center;
                }
              }

              // **Always there, empty or not** — unlike the rule editor's, which comes and goes. Here
              // the buttons an operator clicks one after another are in the rows below, and a message
              // that appeared pushed every row 22 px down under the pointer: TEST on one channel said
              // "Channel 18 at 255 for 3 s." and the next click, on the next channel's TEST, landed on
              // the gap between two rows (found testing the build, 2026-09-30).
              Text {
                height: 16px;
                text: root.status;
                color: root.status-error ? Wf.holding : Wf.ink2;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
              }
            }
          }
        }

        Scroller {
          vertical-stretch: 1;

          sheets := VerticalLayout {
            padding-right: 10px;
            spacing: 10px;
            alignment: start;

            // **Clipped away with nothing patched, or while importing, not removed** — for the reason
            // the top row is, and so that no conditional sheet takes a share of the pane's spare
            // height.
            Rectangle {
              height: root.none || root.importing ? 0px : fixture-sheets.preferred-height;
              min-width: root.importing ? 0px : fixture-sheets.min-width;
              clip: true;

              fixture-sheets := VerticalLayout {
                y: 0;
                width: parent.width;
                spacing: 10px;

                // --- A · where ---------------------------------------------------------------
                Section {
                  letter: "A";
                  title: "where";
                  folded: root.where-folded;
                  summary: "universe " + root.universe + " · " + root.address
                    + (root.channels.length > 1 ? "-" + root.last-channel : "")
                    + " · " + (root.mode-index > 0 && root.mode-index < root.modes.length
                      ? root.modes[root.mode-index] : "custom map");
                  fold-clicked => {
                    root.fold-clicked(0);
                  }

                  HorizontalLayout {
                    height: 34px;
                    spacing: 10px;

                    RowLabel {
                      text: "universe";
                    }
                    // A flat number, which is how every desk and node front panel spells it. The
                    // three-part "net:sub:uni" form is accepted too — see `dmx::parsePortAddress`.
                    universe-box := Entry {
                      width: 72px;
                      horizontal-stretch: 0;
                      value: root.universe;
                      placeholder: "0";
                      font-family: Wf.code;
                      typed(text) => {
                        root.universe-typed(text);
                      }
                      committed(text) => {
                        root.universe-edited(text);
                      }
                    }
                    Rectangle {
                      width: 4px;
                    }
                    Word {
                      text: "start address";
                    }
                    // 1-based, because that is the number printed on the back of the fixture. Entered,
                    // never per keystroke: typing 101 re-patched the fixture at 1, then 10, then 101
                    // (the audit of 2026-09-25, M22).
                    address-box := Count {
                      width: 72px;
                      value: root.address;
                      minimum: 1;
                      maximum: 512;
                      typed(value) => {
                        root.address-typed(value);
                      }
                      edited(value) => {
                        root.address-changed(value);
                      }
                    }
                    Note {
                      text: root.channels.length == 0 ? "takes no channels yet"
                        : root.channels.length == 1 ? "takes channel " + root.address
                        : "takes channels " + root.address + " to " + root.last-channel;
                    }
                  }

                  HorizontalLayout {
                    height: 34px;
                    spacing: 10px;

                    RowLabel {
                      text: "mode";
                    }
                    // Not a fixture library — there are thousands of fixtures and takt4 ships no
                    // database of them. These are the shapes nearly every LED fixture takes, so an RGB
                    // par is one pick and anything unusual is the nearest, edited below.
                    Pick {
                      width: 240px;
                      horizontal-stretch: 0;
                      model: root.modes;
                      current-index: root.mode-index;
                      asides: root.mode-asides;
                      footnote: root.mode-footnote;
                      selected(index) => {
                        root.mode-picked(index);
                        // And lets go of the keyboard: left with it, the next Up or Down picked the
                        // neighbouring mode, which replaces the channel map — a custom map gone with
                        // no undo (found reviewing, 2026-10-01).
                        defocus.take();
                      }
                    }
                    Note {
                      text: root.mode-note;
                    }
                  }
                }

                // --- B · channels ------------------------------------------------------------
                Section {
                  letter: "B";
                  title: "channels";
                  has-add: true;
                  add-enabled: root.address + root.channels.length <= 512;
                  folded: root.channels-folded;
                  summary: root.channels.length == 1 ? "1 channel" : root.channels.length + " channels";
                  fold-clicked => {
                    root.fold-clicked(1);
                  }
                  add-clicked => {
                    root.channel-added();
                  }

                  // What TEST holds a channel at. **One box for the column rather than one per row**:
                  // an operator poking channels to find out which is which pokes them all at the same
                  // level, and a box on every row would make a map meant to be read top to bottom wider.
                  HorizontalLayout {
                    height: 34px;
                    spacing: 10px;

                    RowLabel {
                      text: "test sends";
                    }
                    Count {
                      width: 72px;
                      value: root.test-level;
                      minimum: 0;
                      maximum: 255;
                      typed(value) => {
                        root.test-level-typed(value);
                      }
                      edited(value) => {
                        root.test-level-changed(value);
                      }
                    }
                    Note {
                      text: "to one channel for " + root.test-seconds + " s, then puts it back";
                    }
                  }

                  // The columns' headings, centred over them. With the names' column the columns
                  // sit 8 px apart and the numbers' column is 36 px: at the window's narrowest a
                  // named fixture's rows asked 682 px of a 660 px pane, and 736 with "head" too
                  // (measured, 2026-10-05) — the names give way to 66 px there, and elide.
                  HorizontalLayout {
                    height: 18px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: root.has-labels ? 8px : 10px;

                    Text {
                      width: root.has-labels ? 36px : 44px;
                      text: "ch";
                      color: Wf.ink2;
                      font-size: 14px;
                      font-weight: 700;
                      vertical-alignment: center;
                    }
                    // What the definition calls each channel, in a column of its own before what
                    // takt4 does with it (the operator's pick of the two drawn, 2026-10-05) — only
                    // for a fixture an import made.
                    if root.has-labels: Text {
                      horizontal-stretch: 1;
                      min-width: 66px;
                      // Never from the text: every row's must be the same, or the columns after it
                      // do not line up under their headings.
                      preferred-width: 120px;
                      text: "is called";
                      color: Wf.ink2;
                      font-size: 14px;
                      font-weight: 700;
                      vertical-alignment: center;
                    }
                    // Which head each pan and tilt moves, on a fixture with several (approved
                    // 2026-10-05): what a rule's ticks for heads 1, 2… mean on this one.
                    if root.has-heads: Text {
                      width: 40px;
                      text: "head";
                      color: Wf.ink2;
                      font-size: 14px;
                      font-weight: 700;
                      horizontal-alignment: center;
                      vertical-alignment: center;
                    }
                    Text {
                      width: root.has-labels ? 150px : 180px;
                      text: "does";
                      color: Wf.ink2;
                      font-size: 14px;
                      font-weight: 700;
                      horizontal-alignment: center;
                      vertical-alignment: center;
                    }
                    Text {
                      width: 72px;
                      text: "parked at";
                      color: Wf.ink2;
                      font-size: 14px;
                      font-weight: 700;
                      horizontal-alignment: center;
                      vertical-alignment: center;
                    }
                    Text {
                      horizontal-stretch: 1;
                      // Wide enough for its heading whole: beside the names' column, at the
                      // window's narrowest, 80 cut it to "sending nov" (the render of 2026-10-05).
                      min-width: root.has-labels ? 92px : 80px;
                      max-width: root.has-labels ? 160px : 100000px;
                      text: "sending now";
                      color: Wf.ink2;
                      font-size: 14px;
                      font-weight: 700;
                      horizontal-alignment: center;
                      vertical-alignment: center;
                    }
                    Rectangle {
                      width: 58px;
                    }
                    Rectangle {
                      width: 24px;
                    }
                  }

                  // A band per channel: its DMX number, what it does, where it is parked, what is being
                  // sent on it now, TEST, and ×. **Tight on purpose**: a twelve-channel head is twelve
                  // of these, read top to bottom against the fixture's manual — 6 px apart, where the
                  // sheet's rows are 8.
                  VerticalLayout {
                    spacing: 6px;
                    for channel[index] in root.channels: Band {
                      // Taller by a line for a channel the import had something to say about: the
                      // note goes under the band's controls, in the band (the mockup, approved
                      // 2026-10-05), so it reads as the channel's and moves nothing beside it.
                      height: channel.note == "" ? 44px : 66px;

                      HorizontalLayout {
                        y: 0;
                        height: 44px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: root.has-labels ? 8px : 10px;

                        Text {
                          width: root.has-labels ? 36px : 44px;
                          text: channel.number;
                          color: Wf.ink;
                          font-family: Wf.code;
                          font-size: 15px;
                          vertical-alignment: center;
                        }
                        if root.has-labels: Text {
                          horizontal-stretch: 1;
                          min-width: 66px;
                          preferred-width: 120px; // as its heading's: see there
                          text: channel.label;
                          color: Wf.ink;
                          font-size: 14px;
                          vertical-alignment: center;
                          overflow: elide;
                        }
                        if root.has-heads: Text {
                          width: 40px;
                          text: channel.head > 0 ? channel.head : "";
                          color: Wf.ink;
                          font-family: Wf.code;
                          font-size: 15px;
                          horizontal-alignment: center;
                          vertical-alignment: center;
                        }
                        VerticalLayout {
                          alignment: center;
                          horizontal-stretch: 0;
                          Pick {
                            width: root.has-labels ? 150px : 180px;
                            model: root.roles;
                            current-index: channel.role-index;
                            selected(role) => {
                              root.channel-role-picked(index, role);
                            }
                          }
                        }
                        VerticalLayout {
                          alignment: center;
                          horizontal-stretch: 0;
                          Count {
                            width: 72px;
                            value: channel.parked;
                            minimum: 0;
                            maximum: 255;
                            typed(value) => {
                              root.channel-parked-typed(index, value);
                            }
                            edited(value) => {
                              root.channel-parked-changed(index, value);
                            }
                          }
                        }
                        // The live level, as a bar as well as a number: what an operator is checking
                        // here is *movement* — that a fade is happening.
                        HorizontalLayout {
                          horizontal-stretch: 1;
                          min-width: root.has-labels ? 92px : 80px;
                          max-width: root.has-labels ? 160px : 100000px;
                          spacing: 8px;
                          VerticalLayout {
                            alignment: center;
                            Meter {
                              value: channel.live / 255;
                            }
                          }
                          Text {
                            width: 28px;
                            text: channel.live;
                            color: Wf.ink;
                            font-family: Wf.code;
                            font-size: 14px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                          }
                        }
                        // **One channel, on its own, for a moment** — what IDENTIFY cannot say: whether
                        // channel 72 really is the blue one. It puts the channel back by itself.
                        VerticalLayout {
                          alignment: center;
                          horizontal-stretch: 0;
                          Btn {
                            width: 58px;
                            height: 28px;
                            text: "test";
                            accessible-text: "test channel " + channel.number;
                            font-size: 14px;
                            pad: 0px;
                            clicked => {
                              root.channel-tested(index);
                            }
                          }
                        }
                        VerticalLayout {
                          alignment: center;
                          horizontal-stretch: 0;
                          Btn {
                            width: 24px;
                            height: 24px;
                            text: "×";
                            accessible-text: "delete channel " + channel.number;
                            font-size: 14px;
                            pad: 0px;
                            clicked => {
                              root.channel-removed(index);
                            }
                          }
                        }
                      }

                      // Under the names' column: past the padding, the numbers and their gap.
                      Text {
                        x: root.has-labels ? 54px : 64px;
                        y: 40px;
                        width: parent.width - self.x - 10px;
                        height: 20px;
                        visible: channel.note != "";
                        text: channel.note;
                        color: Wf.ink2;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                      }
                    }

                  }

                  if root.channels.length == 0: Note {
                    height: 34px;
                    text: "no channels — use + add";
                  }

                  // Why a channel nothing uses stays in the map — the old window said it, and the
                  // redrawn one first left it out.
                  Note {
                    height: 20px;
                    text: root.has-heads
                      ? "\"head\" says which head each pan and tilt moves, as a rule's heads are numbered"
                      : "a channel nothing uses is \"unused\": keep it, so the ones after it stay where the manual says";
                  }
                }

                // --- C · how far it moves -----------------------------------------------------
                // Only for a fixture that can move. A *safety* limit rather than a preference: a head
                // told to pan at random across its whole travel will at some point point straight at
                // the audience. Clipped away for one that cannot move, for the reason the sheets are.
                Rectangle {
                  height: root.moves ? moves-sheet.preferred-height : 0px;
                  min-width: moves-sheet.min-width;
                  clip: true;

                  moves-sheet := Section {
                    y: 0;
                    width: parent.width;
                    letter: "C";
                    title: "how far it moves";
                    folded: root.moves-folded;
                    summary: "pan " + round(root.pan-min) + " to " + round(root.pan-max) + " % · tilt "
                      + round(root.tilt-min) + " to " + round(root.tilt-max) + " %";
                    fold-clicked => {
                      root.fold-clicked(2);
                    }

                    HorizontalLayout {
                      height: 34px;
                      spacing: 10px;

                      RowLabel {
                        text: "pan";
                      }
                      VerticalLayout {
                        alignment: center;
                        max-width: 360px;
                        // Followed by the window as the hand moves it, committed once it is let go.
                        SpanTrack {
                          low: root.pan-min;
                          high: root.pan-max;
                          minimum: 0;
                          maximum: 100;
                          step: 1;
                          // A new fixture's: its whole travel (`dmx::Fixture::panMin` and the rest).
                          has-default: true;
                          default-low: 0;
                          default-high: 100;
                          low-moved(value) => {
                            root.pan-min = value;
                          }
                          high-moved(value) => {
                            root.pan-max = value;
                          }
                          settled(low, high) => {
                            root.pan-range-changed(low, high);
                          }
                        }
                      }
                      Text {
                        width: 100px;
                        text: round(root.pan-min) + " to " + round(root.pan-max) + " %";
                        color: Wf.ink;
                        font-family: Wf.code;
                        font-size: 14px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                      }
                      Rectangle {
                        horizontal-stretch: 1;
                      }
                    }

                    HorizontalLayout {
                      height: 34px;
                      spacing: 10px;

                      RowLabel {
                        text: "tilt";
                      }
                      VerticalLayout {
                        alignment: center;
                        max-width: 360px;
                        SpanTrack {
                          low: root.tilt-min;
                          high: root.tilt-max;
                          minimum: 0;
                          maximum: 100;
                          step: 1;
                          // A new fixture's: its whole travel (`dmx::Fixture::panMin` and the rest).
                          has-default: true;
                          default-low: 0;
                          default-high: 100;
                          low-moved(value) => {
                            root.tilt-min = value;
                          }
                          high-moved(value) => {
                            root.tilt-max = value;
                          }
                          settled(low, high) => {
                            root.tilt-range-changed(low, high);
                          }
                        }
                      }
                      Text {
                        width: 100px;
                        text: round(root.tilt-min) + " to " + round(root.tilt-max) + " %";
                        color: Wf.ink;
                        font-family: Wf.code;
                        font-size: 14px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                      }
                      Rectangle {
                        horizontal-stretch: 1;
                      }
                    }

                    Note {
                      height: 20px;
                      text: "every random position and path stays inside this, so no head points at the audience";
                    }
                  }
                }
              }
            }

            // --- the import -------------------------------------------------------------------------
            // In the editor's place while it is open, clipped away while it is not (as the editor's
            // sheets are), drawn to the mockup the operator approved on 2026-10-05
            // (design/weltformat-dark/import1.html).
            Rectangle {
              height: root.importing ? import-sheets.preferred-height : 0px;
              min-width: root.importing ? import-sheets.min-width : 0px;
              clip: true;

              import-sheets := VerticalLayout {
                y: 0;
                width: parent.width;
                spacing: 10px;

                // --- A · fixture type -----------------------------------------------------------
                Section {
                  letter: "A";
                  title: "fixture type";
                  folded: root.import-type-folded;
                  summary: root.import-picked ? root.import-definition : "none picked yet";
                  fold-clicked => {
                    root.fold-clicked(3);
                  }

                  // The preset's library: every definition imported into it before.
                  VerticalLayout {
                    spacing: 4px;
                    for row[index] in root.library-rows: LibraryLine {
                      entry: row;
                      pressed => {
                        root.library-picked(index);
                      }
                      kill-clicked => {
                        root.library-removed(index);
                      }
                    }
                  }
                  if root.library-rows.length == 0: Note {
                    height: 20px;
                    text: "nothing imported into this preset yet";
                  }

                  HorizontalLayout {
                    height: 34px;
                    spacing: 10px;
                    VerticalLayout {
                      alignment: center;
                      horizontal-stretch: 0;
                      Btn {
                        text: "from a file…";
                        accessible-text: "import from a GDTF or Open Fixture Library file";
                        clicked => {
                          root.import-file-clicked();
                        }
                      }
                    }
                    Note {
                      text: root.import-file-line;
                    }
                  }
                  // New to the library, the same as an entry of it, or why it could not be read.
                  Text {
                    height: root.import-file-note == "" ? 0px : self.preferred-height;
                    text: root.import-file-note;
                    color: root.import-file-error ? Wf.holding : Wf.ink2;
                    font-size: 14px;
                    wrap: word-wrap;
                  }

                  // **A file the library has another version of asks before it changes anything**
                  // (decision 12): replace, keep both, or cancel.
                  Rectangle {
                    height: root.import-asking ? ask.preferred-height : 0px;
                    min-width: root.import-asking ? ask.min-width : 0px;
                    clip: true;
                    background: Wf.question;
                    border-width: root.import-asking ? 2px : 0px;
                    border-color: Wf.holding;

                    ask := VerticalLayout {
                      y: 0;
                      width: parent.width;
                      padding-left: 14px;
                      padding-right: 14px;
                      padding-top: 12px;
                      padding-bottom: 12px;
                      spacing: 8px;

                      Text {
                        text: root.ask-question;
                        color: Wf.ink;
                        font-size: 15px;
                        wrap: word-wrap;
                      }
                      HorizontalLayout {
                        spacing: 10px;
                        Text {
                          width: 130px;
                          text: "in the library";
                          color: Wf.ink2;
                          font-size: 14px;
                        }
                        Text {
                          text: root.ask-library;
                          color: Wf.ink;
                          font-size: 14px;
                          horizontal-stretch: 1;
                          wrap: word-wrap;
                        }
                      }
                      HorizontalLayout {
                        spacing: 10px;
                        Text {
                          width: 130px;
                          text: "this file";
                          color: Wf.ink2;
                          font-size: 14px;
                        }
                        Text {
                          text: root.ask-file;
                          color: Wf.ink;
                          font-size: 14px;
                          horizontal-stretch: 1;
                          wrap: word-wrap;
                        }
                      }
                      HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                          alignment: start;
                          horizontal-stretch: 0;
                          Btn {
                            width: 110px;
                            text: "replace";
                            primary: true;
                            enabled: root.import-asking;
                            clicked => {
                              root.ask-replace-clicked();
                            }
                          }
                        }
                        Text {
                          text: root.ask-replace;
                          color: Wf.ink2;
                          font-size: 14px;
                          horizontal-stretch: 1;
                          vertical-alignment: center;
                          wrap: word-wrap;
                        }
                      }
                      HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                          alignment: start;
                          horizontal-stretch: 0;
                          Btn {
                            width: 110px;
                            text: "keep both";
                            enabled: root.import-asking;
                            clicked => {
                              root.ask-keep-clicked();
                            }
                          }
                        }
                        Text {
                          text: "a second entry, shown with its revision; nothing patched changes";
                          color: Wf.ink2;
                          font-size: 14px;
                          horizontal-stretch: 1;
                          vertical-alignment: center;
                          wrap: word-wrap;
                        }
                      }
                      HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                          alignment: start;
                          horizontal-stretch: 0;
                          Btn {
                            width: 110px;
                            text: "cancel";
                            accessible-text: "leave the library as it is";
                            enabled: root.import-asking;
                            clicked => {
                              root.ask-cancel-clicked();
                            }
                          }
                        }
                        Text {
                          text: "leave the library as it is";
                          color: Wf.ink2;
                          font-size: 14px;
                          horizontal-stretch: 1;
                          vertical-alignment: center;
                          wrap: word-wrap;
                        }
                      }
                    }
                  }
                }

                // B and C, once a definition is picked and nothing is being asked.
                Rectangle {
                  height: root.import-picked ? picked-sheets.preferred-height : 0px;
                  min-width: root.import-picked ? picked-sheets.min-width : 0px;
                  clip: true;

                  picked-sheets := VerticalLayout {
                    y: 0;
                    width: parent.width;
                    spacing: 10px;

                    // --- B · mode -----------------------------------------------------------------
                    Section {
                      letter: "B";
                      title: "mode";
                      folded: root.import-mode-folded;
                      summary: root.import-mode;
                      fold-clicked => {
                        root.fold-clicked(4);
                      }

                      HorizontalLayout {
                        height: 18px;
                        padding-left: 36px;
                        padding-right: 10px;
                        spacing: 10px;
                        Text {
                          text: "mode, and what takt4 drives in it";
                          color: Wf.ink2;
                          font-size: 14px;
                          font-weight: 700;
                          vertical-alignment: center;
                          horizontal-stretch: 1;
                          min-width: 0px;
                          overflow: elide;
                        }
                        Text {
                          width: 80px;
                          text: "channels";
                          color: Wf.ink2;
                          font-size: 14px;
                          font-weight: 700;
                          horizontal-alignment: right;
                          vertical-alignment: center;
                        }
                        Text {
                          width: 64px;
                          text: "no role";
                          color: Wf.ink2;
                          font-size: 14px;
                          font-weight: 700;
                          horizontal-alignment: right;
                          vertical-alignment: center;
                        }
                      }
                      VerticalLayout {
                        spacing: 4px;
                        for mode[index] in root.mode-rows: ModeLine {
                          entry: mode;
                          pressed => {
                            root.import-mode-picked(index);
                          }
                        }
                      }
                    }

                    // --- C · where ----------------------------------------------------------------
                    Section {
                      letter: "C";
                      title: "where";
                      folded: root.import-where-folded;
                      summary: root.import-takes;
                      fold-clicked => {
                        root.fold-clicked(5);
                      }

                      HorizontalLayout {
                        height: 34px;
                        spacing: 10px;
                        RowLabel {
                          text: "how many";
                        }
                        Count {
                          width: 72px;
                          value: root.import-count;
                          minimum: 1;
                          maximum: 512;
                          typed(value) => {
                            root.import-count-typed(value);
                          }
                          edited(value) => {
                            root.import-count-changed(value);
                          }
                        }
                        Rectangle {
                          width: 4px;
                        }
                        Word {
                          text: "universe";
                        }
                        Entry {
                          width: 72px;
                          horizontal-stretch: 0;
                          value: root.import-universe;
                          placeholder: "0";
                          font-family: Wf.code;
                          typed(text) => {
                            root.import-universe-typed(text);
                          }
                          committed(text) => {
                            root.import-universe-edited(text);
                          }
                        }
                        Rectangle {
                          width: 4px;
                        }
                        Word {
                          text: "start address";
                        }
                        Count {
                          width: 72px;
                          value: root.import-address;
                          minimum: 1;
                          maximum: 512;
                          typed(value) => {
                            root.import-address-typed(value);
                          }
                          edited(value) => {
                            root.import-address-changed(value);
                          }
                        }
                        Rectangle {
                          horizontal-stretch: 1;
                        }
                      }

                      // What the block takes, then — each only while it has something to say —
                      // what it lands on, what the fixtures are called and the pair's note: in one
                      // column of their own, so a row that is not there leaves no gap behind.
                      VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                          spacing: 10px;
                          RowLabel {
                            height: 20px;
                            text: "takes";
                          }
                          Text {
                            text: root.import-takes;
                            color: root.import-takes-error ? Wf.holding : Wf.ink;
                            font-size: 14px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            wrap: word-wrap;
                          }
                        }
                        HorizontalLayout {
                          height: root.import-overlap == "" ? 0px : self.preferred-height;
                          visible: root.import-overlap != "";
                          padding-top: 8px;
                          spacing: 10px;
                          Rectangle {
                            width: 118px;
                          }
                          Text {
                            text: root.import-overlap;
                            color: Wf.holding;
                            font-size: 14px;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                          }
                        }
                        // A label with nothing beside it — a block that runs past 512 makes no
                        // fixtures — reads as a field left blank, so it goes with its names.
                        HorizontalLayout {
                          height: root.import-names == "" ? 0px : self.preferred-height;
                          visible: root.import-names != "";
                          padding-top: 8px;
                          spacing: 10px;
                          RowLabel {
                            height: 20px;
                            text: "named";
                          }
                          Text {
                            text: root.import-names;
                            color: Wf.ink;
                            font-size: 14px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            wrap: word-wrap;
                          }
                        }
                        HorizontalLayout {
                          height: root.import-pair ? 28px : 0px;
                          visible: root.import-pair;
                          padding-top: 8px;
                          Note {
                            text: "two fixtures per copy, changing mode together, each with its own start address";
                          }
                        }
                      }

                      HorizontalLayout {
                        height: 40px;
                        spacing: 12px;
                        VerticalLayout {
                          alignment: end;
                          horizontal-stretch: 0;
                          Btn {
                            width: 120px;
                            text: "import";
                            accessible-text: "import these fixtures";
                            primary: true;
                            enabled: root.import-can;
                            clicked => {
                              root.import-confirmed();
                            }
                          }
                        }
                        Note {
                          vertical-alignment: bottom;
                          text: "a channel with no role sits at its parked level; you can give it one after";
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
