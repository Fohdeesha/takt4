// The vocabulary both of takt4's windows are built from — HANDOFF §5.9.
//
// Extracted from main_window.slint when the rule editor became a second window: a Slint
// `global` and a component are file-scoped unless they are exported, so two windows that
// are meant to look like one application have to import their theme from one place. This
// is that place, and it holds nothing that knows what either window is for.

import { LineEdit, Slider } from "std-widgets.slint";

/// A place for the keyboard focus to go when the operator has finished with a text box.
///
/// **Because a text box only commits when it loses the focus**, and until this there was
/// nothing in either window willing to take it. Every `LineEdit` here carries a
/// `changed has-focus` handler that writes what was typed — that is how clicking away from a
/// box saves the edit instead of losing it — and a click on a button, a heading or the panel
/// behind them moved the focus nowhere at all, so the box stayed lit and the edit stayed
/// uncommitted. Reported from a rig on 2026-09-16: *"when I click outside of a box, that box
/// stays selected as an entry box ... clicking save, etc other ui elements doesnt exit out of
/// that box being in edit mode either."*
///
/// Taking the focus is what makes the box let go and commit. **And the focus stays here**,
/// which it did not until 2026-09-23: this used to `clear-focus()` straight after, so that no
/// invisible element held the keyboard — and with nothing holding it, Slint delivers a key
/// press to nothing at all. That was harmless while no window had a keyboard shortcut. The
/// main window has three now (the audit's H18: PANIC, TAP and DOWNBEAT from the keyboard),
/// and a key only reaches the window's shortcut scope by bubbling up from whatever holds the
/// focus — so after a click on a button the shortcuts went dead until the operator clicked
/// the background. A sink that keeps the focus passes every key it does not want straight up
/// to its window, which is exactly right. It accepts focus neither by click nor by tab — it is
/// only ever aimed at deliberately, by `Press`, by `Field` and by a window's background.
export component FocusSink inherits FocusScope {
  width: 0px;
  height: 0px;
  focus-on-click: false;
  focus-on-tab-navigation: false;

  /// Takes the focus off whatever has it, and holds it somewhere harmless.
  public function take() {
    self.focus();
  }
}

/// A text box that lets go on Escape and on Enter — and leaves the keyboard somewhere useful
/// when it does.
///
/// Every box in takt4 commits when it loses the focus (see `FocusSink`). A `LineEdit` ignores
/// Escape, so it bubbled up to the window — and in a window where Escape means PANIC, an
/// operator pressing Escape to get out of a box would halt the show. This one takes Escape for
/// itself: it finishes the edit, exactly as clicking away does, and panics nothing. Enter does
/// the same through `leave()`, which the boxes' `accepted` handlers call instead of
/// `clear-focus()` — clearing would leave nothing holding the keyboard, and the shortcuts dead.
///
/// A wrapper rather than `inherits LineEdit`, because a `LineEdit` cannot be given children and
/// the place the focus goes has to live somewhere. The properties and callbacks are the ones
/// the boxes in this application use, under the same names.
///
/// **A plain rectangle that forwards the box's own size constraints, not a layout.** The first
/// version was rooted in a `HorizontalLayout`, and a layout's minimum is its children's — so
/// the `LineEdit`'s own minimum beat every `width:` written on an instance. Rendered, the port
/// box came out 69 px against its 62, the universe box 92 against 56 and over the delay slider,
/// and at the window's minimum width the port box sat under the slider's thumb. On a rectangle
/// an explicit `width` wins, exactly as it did on the `LineEdit` itself; with none, the
/// forwarded constraints give the box its natural size and let it stretch as it did.
export component Field inherits Rectangle {
  in-out property <string> text <=> edit.text;
  in property <string> placeholder-text <=> edit.placeholder-text;
  in property <length> font-size <=> edit.font-size;
  in property <bool> enabled <=> edit.enabled;
  /// Whether Up and Down step the box (`NumberBox`) rather than going to whoever is above it.
  in property <bool> takes-arrows: false;
  /// The box's own focus, so a `changed has-focus` on an instance commits exactly as it did.
  out property <bool> has-focus: edit.has-focus;
  callback edited(string);
  callback accepted(string);
  /// Escape was pressed in it — told before the focus leaves, so an owner that means Escape as
  /// "put it back" (`NumberEntry`) can say so before its `changed has-focus` commits.
  callback escaped();
  /// Up (+1) or Down (-1) was pressed in it, when `takes-arrows` is set.
  callback arrowed(int);

  min-width: edit.min-width;
  min-height: edit.min-height;
  preferred-width: edit.preferred-width;
  preferred-height: edit.preferred-height;
  max-height: edit.max-height;
  vertical-stretch: 0;

  /// Finished with the box: the focus goes where it commits the edit and still passes the
  /// window's shortcuts up to it.
  public function leave() {
    done.take();
  }

  /// Into the box, with everything in it selected so that typing replaces it.
  public function edit-now() {
    edit.focus();
    edit.select-all();
  }

  edit := LineEdit {
    x: 0;
    y: 0;
    width: root.width;
    height: root.height;
    edited(text) => {
      root.edited(text);
    }
    accepted(text) => {
      root.accepted(text);
    }
    key-pressed(event) => {
      if (event.text == Key.Escape) {
        root.escaped();
        done.take();
        return accept;
      }
      if (root.takes-arrows && event.text == Key.UpArrow) {
        root.arrowed(1);
        return accept;
      }
      if (root.takes-arrows && event.text == Key.DownArrow) {
        root.arrowed(-1);
        return accept;
      }
      return reject;
    }
  }

  done := FocusSink { }
}

/// A text box that shows what its owner says it holds — **and never stops showing it**.
///
/// A `Field` bound one way (`text: slot.values`) goes deaf the moment it is typed into: Slint
/// drops a binding when the property is assigned, and typing assigns it. The rule editor made up
/// for that by building a row again whenever the controller changed it, and that destroyed
/// whatever on the row had the keyboard — Tab from a follow-up's value into its delay landed in a
/// box that was already on its way out (the audit of 2026-09-25, M17). This one needs no
/// rebuilding. It shows `value` whenever it is not being typed in, and puts `value` back the
/// moment an edit is finished, so a range the controller turned round ("8 - 1" held as 1 to 8)
/// is what the box then says.
///
/// `typed` is every keystroke, for an owner that keeps what is half-typed
/// (`RulesController::typing_`). `committed` is the edit finished — Enter, Escape or a click
/// away — **once**: a `Field` with an `accepted` and a `changed has-focus` handler said Enter
/// twice.
export component LiveField inherits Rectangle {
  in property <string> value;
  in property <string> placeholder-text <=> box.placeholder-text;
  in property <length> font-size <=> box.font-size;
  in property <bool> enabled <=> box.enabled;
  out property <bool> has-focus: box.has-focus;
  callback typed(string);
  callback committed(string);

  // Enter has committed; the focus leaving because of it is not a second edit.
  private property <bool> entered: false;

  min-width: box.min-width;
  min-height: box.min-height;
  preferred-width: box.preferred-width;
  preferred-height: box.preferred-height;
  max-height: box.max-height;
  vertical-stretch: 0;

  // What the owner changed it to, into the box — never over what is being typed.
  changed value => {
    if (!box.has-focus) {
      box.text = root.value;
    }
  }

  box := Field {
    x: 0;
    y: 0;
    width: root.width;
    height: root.height;
    text: root.value;
    edited(t) => {
      root.typed(t);
    }
    accepted(t) => {
      root.entered = true;
      // Focus first, callback second, as every box here does: the callback may publish, and the
      // focus has to be somewhere that passes the window's shortcuts up before it does.
      self.leave();
      root.committed(t);
      self.text = root.value;
    }
    changed has-focus => {
      if (!self.has-focus) {
        if (root.entered) {
          root.entered = false;
        } else {
          root.committed(self.text);
        }
        self.text = root.value;
      }
    }
  }
}

// A dark window, whatever the desktop is set to. This is read across a booth, and the
// std-widgets are pinned to the same scheme so the pickers do not come up white.
export global Theme {
  out property <color> background: #121316;
  out property <color> panel: #191b1f;
  out property <color> line: #2b2f36;
  out property <color> text: #e9ebee;
  out property <color> dim: #878d97;
  /// Secondary text that still has to be read at a glance — a label beside a control, a
  /// reading, a column heading. `dim` on the panel colour was too faint to read across a
  /// room (the operator, 2026-09-25: "not light grey on grey"); `dim` is kept for what is
  /// switched off.
  out property <color> soft: #c5cad2;
  out property <color> accent: #60cdff;   // fluent's own dark accent, so the pickers agree
  out property <color> locked: #4ade80;
  out property <color> holding: #fbbf24;
  // Something has failed and the rig is not doing what the screen would otherwise suggest —
  // no audio arriving, most of all. Red, because amber already means "holding".
  out property <color> alarm: #f87171;
  out property <color> trace: #3f596b;

  // The pressable controls. Lighter than the panel they sit on, so a button reads as a
  // button, and their labels are plain white rather than the body text's off-white —
  // these are hit in a dark room, at a glance, while something else is going on.
  out property <color> control: #2b313a;
  out property <color> controlEdge: #4a525f;
  out property <color> controlPrimary: #17567a;
  // A toggle that is currently on, in the same green the lock readout uses — it is the
  // lock the operator is holding, and green means locked everywhere else in this window.
  out property <color> controlActive: #1a6b3c;
  out property <color> label: #ffffff;
  // A disabled button keeps its shape: it sits between the panel and an active control
  // rather than sinking into the background, because on a freshly opened window every
  // one of these is disabled and a row of holes is not what the app should look like.
  out property <color> controlOff: #21252b;
}

/// A button, built here rather than taken from std-widgets.
///
/// `Button` exposes `text`, `icon`, `primary`, `enabled` and `checkable` — and no
/// `font-size` or `font-weight`. Its label therefore comes out at the widget set's own
/// size in the widget set's own foreground color, which on this dark panel is grey on
/// grey and too small to read at a glance. These are the controls an operator hits in a
/// booth, mid-set, while looking at something else, so the type is 17px, bold, and plain
/// white. It also settles `÷2`: at the std size the dots of U+00F7 all but vanish and the
/// glyph reads as `+`.
///
/// What is given up is the Fluent look and its focus ring. The pickers and sliders are
/// still std widgets, so the window keeps that vocabulary everywhere it does not cost
/// legibility.
export component Press inherits Rectangle {
  in property <string> text;
  in property <bool> enabled: true;
  /// The one action in a row that should be reached for first.
  in property <bool> primary;
  /// A toggle that is currently on, lit so it reads as held down rather than pressable.
  in property <bool> active;
  /// Air either side of the label. It is most of what a short button's minimum width *is*,
  /// so a row of these in a pane that can be dragged narrow wants less of it than a row of
  /// performance controls does.
  in property <length> pad: 16px;
  /// 17px is for the controls hit mid-set from across a booth, which is what this component
  /// was written for and is still the default. An editor's own COPY and DELETE are not
  /// those, and at 17px two of them do not fit a pane that can be dragged to a third of the
  /// window — the choice is a smaller label or no label, and a smaller one still reads.
  in property <length> font: 17px;
  /// The key that does the same thing, drawn small and dim after the label — "Esc", "T". A
  /// shortcut nobody can see is one nobody uses, and the audit's H18 made three of these.
  in property <string> hint;
  callback clicked;

  private property <color> face: root.active ? Theme.controlActive
    : root.primary ? Theme.controlPrimary
    : Theme.control;

  min-height: 40px;
  horizontal-stretch: 0;
  border-radius: 5px;
  border-width: 1px;
  border-color: !root.enabled ? Theme.line
    : root.active ? Theme.locked
    : root.primary ? Theme.accent
    : touch.has-hover ? Theme.accent
    : Theme.controlEdge;
  background: !root.enabled ? Theme.controlOff
    : touch.pressed ? root.face.darker(0.3)
    : touch.has-hover ? root.face.brighter(0.25)
    : root.face;

  HorizontalLayout {
    padding-left: root.pad;
    padding-right: root.pad;
    spacing: 8px;
    alignment: center;

    Text {
      text: root.text;
      // Plain white, not Theme.text: this is the one thing in the window that has to
      // survive being glanced at rather than read.
      color: root.enabled ? Theme.label : Theme.dim;
      font-size: root.font;
      font-weight: 700;
      horizontal-alignment: center;
      vertical-alignment: center;
      // A label with no elide reports its whole width as the button's minimum, and a
      // layout will not shrink a child past its minimum — so in a pane that can be dragged
      // narrower than the row of buttons in it, the buttons ran off the edge and were
      // clipped rather than giving way. Eliding makes the minimum one ellipsis wide.
      overflow: elide;
    }

    if root.hint != "" : Text {
      text: root.hint;
      color: Theme.dim;
      font-size: 11px;
      font-weight: 400;
      vertical-alignment: center;
    }
  }

  // Pressing a button finishes whatever was being typed. See `FocusSink`: SAVE used to fire
  // with the name box still holding the focus and still holding an uncommitted edit, which
  // is the one order in which a button called SAVE must not run.
  sink := FocusSink { }

  touch := TouchArea {
    enabled: root.enabled;
    clicked => {
      // Focus first, action second — but that is not the order they are sure to finish in.
      // Taking the focus makes the box let go, and its `changed has-focus` commit can run a
      // turn of the event loop later, after the action (the audit found exactly that). So the
      // controllers do not lean on this order: they keep what is typed as it is typed and
      // commit it themselves at the start of an action that depends on it
      // (`RulesController::commitTyping`, `FixturesController::commitDrafts`).
      sink.take();
      root.clicked();
    }
  }
}

/// The line between two panes, draggable.
///
/// A pane whose width is written into the markup is the right width for whoever wrote it.
/// An operator with twenty rules wants the list wide; one watching what a rule they have
/// just built is sending wants the log wide and the list gone — and which of those is true
/// changes during a set, so it is not a decision this file can make once.
///
/// It reports a **delta** rather than a width, because the pane it moves may be on either
/// side of it: the owner adds it to the left-hand pane's width or subtracts it from the
/// right-hand one's, and clamps. `mouse-x - pressed-x` is the movement since the last time
/// this was reported, because the divider — and with it this touch area's own origin —
/// moves by whatever the owner did with it.
export component Splitter inherits Rectangle {
  callback dragged(length);

  width: 5px;
  horizontal-stretch: 0;
  // Lit under the pointer, because a 5px line that does something is worth nothing if
  // nobody can tell it from the 1px lines that do not.
  background: touch.pressed || touch.has-hover ? Theme.accent : Theme.line;

  touch := TouchArea {
    mouse-cursor: ew-resize;
    moved => {
      root.dragged(self.mouse-x - self.pressed-x);
    }
  }
}

/// A reading that can be typed into. The operator's call of 2026-09-25: *"make the latency
/// display numbers next to the sliders clickable so you can then input a number directly, but
/// dont make it always a big ugly entry box. just a underlined blue number like a URL"*.
///
/// At rest it is the reading, in the accent colour with a line under it and a hand for the
/// pointer, which is what a link looks like anywhere. Clicked, a box opens in the same place
/// holding the number alone, all of it selected, so typing replaces it. **Enter or a click away
/// sets it**, the way every box in takt4 commits, and **Escape leaves it as it was**. What was
/// typed goes to the C++ side as text, which reads it and clamps it: the box never decides what
/// a number means.
///
/// Switched off it is plain dim text that does nothing, like the slider beside it.
export component NumberEntry inherits Rectangle {
  /// What it reads at rest: "+12 ms".
  in property <string> text;
  /// What the box holds when it opens: "12".
  in property <string> value-text;
  in property <bool> enabled: true;
  in property <length> font-size: 14px;
  /// Whether the box is open.
  out property <bool> editing: false;
  /// What was typed, on Enter or on a click away — never on Escape.
  callback committed(string);

  // The reading's own width, for the line under it: a text right-aligned in its column is only
  // as wide as its characters, and the line should be too.
  measure := Text {
    visible: false;
    text: root.text;
    font-size: root.font-size;
    font-family: "Consolas";
  }

  reading := Text {
    x: 0;
    y: 0;
    width: root.width;
    height: root.height;
    visible: !root.editing;
    text: root.text;
    color: !root.enabled ? Theme.dim : touch.has-hover ? Theme.accent.brighter(0.3) : Theme.accent;
    font-size: root.font-size;
    font-family: "Consolas";
    horizontal-alignment: right;
    vertical-alignment: center;
  }

  // The line under it, which is what says it can be clicked — only while it can.
  Rectangle {
    visible: !root.editing && root.enabled;
    x: root.width - self.width;
    y: root.height / 2 + root.font-size * 0.6;
    width: min(measure.width, root.width);
    height: 1px;
    background: reading.color;
  }

  touch := TouchArea {
    enabled: root.enabled && !root.editing;
    mouse-cursor: pointer;
    clicked => {
      box.text = root.value-text;
      root.editing = true;
      box.edit-now();
    }
  }

  box := Field {
    x: 0;
    y: (root.height - self.height) / 2;
    width: root.width;
    visible: root.editing;
    enabled: root.editing;
    font-size: 12px;
    accepted(text) => {
      root.editing = false;
      self.leave();
      root.committed(text);
    }
    escaped => {
      root.editing = false;
    }
    // A click anywhere else takes the focus, and that is finishing the edit rather than
    // abandoning it — the same as every other box in the window.
    changed has-focus => {
      if (!self.has-focus && root.editing) {
        root.editing = false;
        root.committed(self.text);
      }
    }
  }
}

/// A whole number, typed or stepped — every number box in takt4, in place of std-widgets'
/// `SpinBox` (the audit of 2026-09-25: H2, M17, M19, M22). That one did four things wrong for a
/// booth:
///
/// - **Escape went through it to the window**, where Escape is PANIC. Its text input takes no
///   control key, so an operator backing out of "every" or a note number halted every rule and
///   froze the lights. Here Escape leaves the box as it was, and nothing else.
/// - **It sent every keystroke.** Typing 60 sent 6 first — a note, a CC, a re-patch of a
///   fixture to address 1 and then 10 on the way to 101 — and the row it was on was rebuilt under
///   the next keystroke. Here what is typed is sent on Enter, on a click away, or on a step, and
///   only if it is a number; anything else goes back to what it was.
/// - **The mouse wheel changed it**, whichever box the pointer happened to be over as the pane
///   was scrolled — parked levels on the rig, one notch at a time. This one does not handle the
///   wheel at all, so the pane scrolls.
/// - **It wrote its own value**, which is what makes a binding from a row go deaf. This one never
///   assigns `value`: it says what was entered through `edited`, and shows whatever `value` then
///   is — so a row bound to it needs nothing rebuilt when the number changes.
///
/// ▲ and ▼ beside it, and Up and Down in it, step by one from what is in the box.
export component NumberBox inherits Rectangle {
  in-out property <int> value;
  in property <int> minimum: 0;
  in property <int> maximum: 100;
  in property <bool> enabled: true;
  in property <length> font-size: 13px;
  out property <bool> has-focus: box.has-focus;
  /// A number entered — clamped to the range — that differs from `value`.
  callback edited(int);
  /// What Enter would set, on every keystroke: `value` while the box holds no number. For an
  /// owner that keeps what is half-typed and commits it before an action (`RulesController::
  /// typing_`) — the keystrokes themselves are never sent anywhere.
  callback typed(int);

  private property <bool> reverting: false;

  min-height: box.min-height;
  preferred-height: box.preferred-height;
  max-height: box.max-height;
  min-width: 56px;
  vertical-stretch: 0;

  pure function entered() -> int {
    return box.text.is-float() ? max(root.minimum, min(root.maximum, round(box.text.to-float())))
      : root.value;
  }

  function enter() {
    let number = root.entered();
    if (number != root.value) {
      root.edited(number);
    }
    // Whatever the owner made of it, or what it was when it was not a number.
    box.text = root.value;
  }

  function step(by: int) {
    let from = box.text.is-float() ? round(box.text.to-float()) : root.value;
    let stepped = max(root.minimum, min(root.maximum, from + by));
    if (stepped != root.value) {
      // Said as typed first, then entered: a step is a keystroke that commits itself, and an
      // owner keeping keystrokes should hear it as one.
      root.typed(stepped);
      root.edited(stepped);
    }
    box.text = root.value;
  }

  // What the owner changed it to, into the box — never over what is being typed.
  changed value => {
    if (!box.has-focus) {
      box.text = root.value;
    }
  }

  box := Field {
    x: 0;
    y: 0;
    width: root.width - 18px;
    height: root.height;
    text: root.value;
    font-size: root.font-size;
    enabled: root.enabled;
    takes-arrows: true;
    edited(t) => {
      root.typed(root.entered());
    }
    arrowed(by) => {
      root.step(by);
    }
    accepted(t) => {
      self.leave();
      root.enter();
    }
    escaped => {
      root.reverting = true;
      // And whoever was keeping what was typed is told it is gone, or their next action would
      // commit the number Escape just threw away.
      root.typed(root.value);
    }
    changed has-focus => {
      if (!self.has-focus) {
        if (root.reverting) {
          root.reverting = false;
          self.text = root.value;
        } else {
          root.enter();
        }
      }
    }
  }

  // The steppers: a column of two, the height of the box.
  up := TouchArea {
    x: root.width - 16px;
    y: 0;
    width: 16px;
    height: root.height / 2;
    enabled: root.enabled;
    clicked => {
      root.step(1);
    }
    Text {
      text: "▲";
      font-size: 8px;
      color: !root.enabled ? Theme.dim : parent.has-hover ? Theme.accent : Theme.soft;
      horizontal-alignment: center;
      vertical-alignment: center;
    }
  }
  down := TouchArea {
    x: root.width - 16px;
    y: root.height / 2;
    width: 16px;
    height: root.height / 2;
    enabled: root.enabled;
    clicked => {
      root.step(-1);
    }
    Text {
      text: "▼";
      font-size: 8px;
      color: !root.enabled ? Theme.dim : parent.has-hover ? Theme.accent : Theme.soft;
      horizontal-alignment: center;
      vertical-alignment: center;
    }
  }
}

/// A horizontal level bar with a label and a reading beside it.
export component Bar inherits HorizontalLayout {
  in property <string> label;
  in property <float> value;      // 0 to 1
  in property <string> reading;
  in property <color> fill: Theme.accent;
  /// The label's look, for a meter that is the main thing in its part of the window.
  in property <length> label-size: 14px;
  in property <color> label-color: Theme.soft;

  spacing: 10px;

  // No label, no column: a bar whose label is written somewhere else starts at its own edge.
  if root.label != "" : Text {
    text: root.label;
    color: root.label-color;
    font-size: root.label-size;
    width: 86px;
    vertical-alignment: center;
  }

  Rectangle {
    background: Theme.panel;
    border-radius: 3px;
    vertical-stretch: 0;
    height: 10px;
    y: (parent.height - self.height) / 2;
    clip: true;

    Rectangle {
      x: 0;
      width: parent.width * clamp(root.value, 0.0, 1.0);
      height: 100%;
      background: root.fill;
      border-radius: 3px;
    }
  }

  Text {
    text: root.reading;
    color: Theme.text;
    font-size: 14px;
    font-family: "Consolas";
    width: 80px;
    horizontal-alignment: right;
    vertical-alignment: center;
  }
}

/// A setting the operator drags: the same label and reading columns as `Bar`, so a
/// control and a meter line up down the window.
///
/// `value` is two-way bound all the way down to the Slider, which is what lets the C++
/// side move the control when something other than a drag changes the setting — a tap
/// moves the fold window, and the window has to follow it (§7 deviation 8).
export component Setting inherits HorizontalLayout {
  in property <string> label;
  in-out property <float> value;
  in property <float> minimum;
  in property <float> maximum;
  in property <float> step: 1;
  in property <string> reading;
  /// Blank column between the label and the slider, so a row with no switch in it lines
  /// its slider up with a row that has one.
  in property <length> indent: 0px;
  /// Whether the reading can be clicked and a number typed in — see `NumberEntry` — and what
  /// the box holds when it opens.
  in property <bool> typable;
  in property <string> value-text;
  callback moved(float);
  /// What was typed into the reading, as typed.
  callback typed(string);

  spacing: 10px;

  Text {
    text: root.label;
    color: Theme.soft;
    font-size: 14px;
    width: 86px;
    vertical-alignment: center;
  }

  Rectangle { width: root.indent; }

  Slider {
    minimum: root.minimum;
    maximum: root.maximum;
    step: root.step;
    value <=> root.value;
    // A slider sends the value it now has, never a nudge. The control queue coalesces
    // settings changes, so two relative steps arriving in one round would collapse into
    // one and lose a step; an absolute value does not have the question.
    changed(v) => {
      root.moved(v);
    }
  }

  if !root.typable : Text {
    text: root.reading;
    color: Theme.text;
    font-size: 14px;
    font-family: "Consolas";
    width: 80px;
    horizontal-alignment: right;
    vertical-alignment: center;
  }

  if root.typable : NumberEntry {
    text: root.reading;
    value-text: root.value-text;
    width: 80px;
    committed(text) => {
      root.typed(text);
    }
  }
}
