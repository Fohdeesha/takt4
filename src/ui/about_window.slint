// About takt4: what it is, the licence it is under, where its source is, and the notices of
// everything built into it — in the Weltformat-dark look, as the operator approved it on
// 2026-09-30 (design/weltformat-dark/about1.html): three sheets, and CLOSE at the bottom right.
//
// **GPLv3 §5(d) asks a program with an interactive interface to show "Appropriate Legal
// Notices"** — a copyright notice, that there is no warranty, that it may be passed on under
// the licence, and how to see the licence — and BSD, MIT, Apache, MPL and the Unicode licence
// ask for their notices to go wherever the binary goes (the audit's licensing finding; the
// user's answer to its Q8). takt4 is one file somebody copies to a stick, so the notices are
// built into it and opened from here rather than left in a folder that may not have come
// along. `WindowController` writes the text out and opens it in the machine's text viewer.

import { Btn, Scroller, Wf } from "weltformat.slint";
import { FocusSink } from "theme.slint";

/// A sheet of this window: charcoal on the page, 16 px in from its edges.
component Sheet inherits Rectangle {
  background: Wf.sheet;
  vertical-stretch: 0;

  VerticalLayout {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 16px;
    spacing: 8px;
    @children
  }
}

/// Words that can be selected and copied — every one in this window (the operator, 2026-10-08:
/// none of it could be, the version and the source's address included). A read-only `TextInput`,
/// because Slint never lets a `Text` be selected; selected as the window's boxes are.
component Copyable inherits TextInput {
  read-only: true;
  color: Wf.ink;
  selection-background-color: Wf.ink;
  selection-foreground-color: Wf.on-primary;
}

/// Running text in a sheet, wrapping.
component Words inherits Copyable {
  font-size: 15px;
  single-line: false;
  wrap: word-wrap;
}

/// A sheet's heading.
component Head inherits Copyable {
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.36px;
}

export component AboutWindow inherits Window {
  title: "About takt4";
  background: Wf.page;
  default-font-family: Wf.sans;
  default-font-size: 15px;
  default-font-weight: 500;
  // The size it is drawn for is `ui::kAboutWindowWidth` x `kAboutWindowHeight`, set from C++
  // before the first show, no larger than the screen (`fitToScreen`). Shorter than that the sheets
  // scroll and CLOSE stays put: on a small laptop at 125 % the window used to be taller than the
  // screen (found reviewing, 2026-10-01).
  preferred-width: 580px;
  preferred-height: 640px;
  min-width: 520px;
  min-height: 320px;

  /// `versionLabel`: the version, and the commit after it for anything but a clean release.
  in property <string> version;
  /// What the last OPEN did: where the file was written, or why it could not be.
  in property <string> opened;
  /// The source's address, clicked: the C++ side opens it in the browser.
  callback source-opened();
  callback licence-opened();
  callback notices-opened();
  callback closed();

  // Nothing here takes typing, but a click on the background still lands somewhere, as it
  // does in every other window.
  sink := FocusSink { }
  TouchArea {
    clicked => {
      sink.take();
    }
  }

  VerticalLayout {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    spacing: 10px;

    Scroller {
      vertical-stretch: 1;
    VerticalLayout {
    padding-right: 10px;
    spacing: 10px;
    alignment: start;

    Sheet {
      HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Copyable {
          text: "takt4";
          font-size: 34px;
          font-weight: 800;
          letter-spacing: -1px;
          vertical-alignment: bottom;
        }
        Copyable {
          text: root.version;
          color: Wf.ink2;
          font-family: Wf.code;
          font-size: 15px;
          vertical-alignment: bottom;
          horizontal-stretch: 1;
        }
      }
      Words {
        text: "Author: Jon Sands (Fohdeesha)";
        color: Wf.ink2;
      }
      Words {
        text: "Beat, downbeat, tempo and meter from the audio coming in, sent to the rest of the rig over Ableton Link, OSC, MIDI and Art-Net.";
      }
    }

    Sheet {
      Head {
        text: "licence";
      }
      Words {
        text: "Copyright © 2026 Jon Sands";
      }
      Words {
        text: "takt4 is free software: you can pass it on and change it under the terms of the GNU General Public License, version 3. It comes with ABSOLUTELY NO WARRANTY. You are entitled to its complete source code under that licence.";
      }
      // **A link**, drawn as the window's links are and opened in the browser: it read as one and
      // did nothing when clicked (the operator, 2026-10-08). The one thing here a click opens
      // rather than selects; the browser it opens shows the address to copy.
      HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Copyable {
          text: "source";
          font-size: 15px;
          vertical-alignment: center;
        }
        // Sized to its words: in a row laid out from the start, a bare Rectangle is given its
        // preferred width, which with nothing laid out inside it is none — the words still drew,
        // and the click area under them was zero wide (found by the test below, 2026-10-08).
        Rectangle {
          width: source-link.preferred-width;
          source-link := Text {
            text: "github.com/Fohdeesha/takt4";
            color: source-touch.has-hover ? Wf.link-hover : Wf.link;
            font-family: Wf.code;
            font-size: 14px;
            vertical-alignment: center;
            height: parent.height;
          }
          source-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
              root.source-opened();
            }
          }
        }
      }
      Words {
        text: "ASIO is a trademark and software of Steinberg Media Technologies GmbH.";
        color: Wf.ink2;
        font-size: 14px;
      }
    }

    Sheet {
      Head {
        text: "built with";
      }
      Words {
        text: "PortAudio, Ableton Link, Slint, Skia and more, each under its own licence. The licence and every notice are inside takt4:";
      }
      HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Btn {
          text: "open the licence";
          clicked => {
            root.licence-opened();
          }
        }
        Btn {
          text: "open third-party notices";
          clicked => {
            root.notices-opened();
          }
        }
      }
      // Where the file went, which is the one place to look if no viewer opened. Broken at any
      // character, so a path fills its lines evenly. (Word-wrapped it stays on the sheet too:
      // Slint 1.18 breaks a word too long for its line — measured 2026-10-01 against a review
      // that said otherwise.)
      if root.opened != "": Copyable {
        text: root.opened;
        color: Wf.ink2;
        font-family: Wf.code;
        font-size: 13px;
        single-line: false;
        wrap: char-wrap;
      }
    }
    }
    }

    HorizontalLayout {
      padding-right: 10px;
      alignment: end;
      Btn {
        text: "close";
        primary: true;
        clicked => {
          root.closed();
        }
      }
    }
  }
}
