// The main window — HANDOFF §5.9.
//
// §5.9 sketches one window: device and channel pickers along the top, the BPM readout
// and lock state in the middle, a bar indicator that draws however many beats the
// tracker reports, the ÷2 / ×2 / TAP controls beside it, and along the bottom the two
// things the handoff says carry this UI — the scrolling activation trace and the input
// meter. All of that is here, with §5.5's manual downbeat, octave-fold window and
// latency offset alongside.
//
// Since then the OUTPUTS row, the TRIGGERS line with PANIC and RELEASE, and the buttons that
// open the rule and patch editors have joined it. What is still not here is §5.1's
// two-channel input: the window starts a tracker on one channel.
//
// Every control here *sends* through engine::BeatEngine::post(), and none of them talks
// to the tracker directly. The controller behind this window is the only thing that
// touches the engine; see window_controller.cpp for why a posted change is not read
// straight back.
//
// Nothing in this file assumes a meter of four. `beats-per-bar` comes from the decoder's
// bar position — the forward filter's, by default — and the bar indicator is drawn from it,
// as §5.5 requires.

import { CheckBox, ComboBox, Palette, ScrollView, Slider } from "std-widgets.slint";
import { Bar, Field, Press, Setting, Theme } from "theme.slint";

// §5.9's rule editor is a window of its own (rules_window.slint), re-exported through here
// so the Slint compiler produces one generated header for both. See src/ui/CMakeLists.txt.
export { RulesWindow, RuleRow, SlotRow } from "rules_window.slint";
// And the patch editor, for the same reason — see src/ui/CMakeLists.txt on why there is one
// generated header rather than one per window.
export { FixturesWindow, FixtureRow, ChannelRow } from "fixtures_window.slint";
export { AboutWindow } from "about_window.slint";

/// One 50 Hz frame of the activation trace. The network's two probabilities, and
/// whether the tracker actually called a beat on this frame — which is the difference
/// between "the model saw something" and "the filter agreed", and the whole reason the
/// trace is diagnostic rather than decorative.
export struct TracePoint {
  beat: float,
  downbeat: float,
  called: bool,
}

/// One of §5.6's simultaneous targets, as the row that edits it holds it.
///
/// **A row each, and two boxes rather than one line.** This was a single field holding
/// `deck = 127.0.0.1:7000, wall = 127.0.0.1:7001, …`, which is the whole rig on one line: a
/// third address had to be typed onto the end of a string already too long to read, and one
/// mistyped character anywhere in it took the parse down. A rig has several outputs — that is
/// §5.6's premise — so the list is a list, the name a rule aims at is its own box, and the
/// destination is its own box beside it.
/// **The destination is asked for as the destination is shaped, not as a string.** This row
/// used to be one box holding "127.0.0.1:7000   or   midi Device Name", which asks an
/// operator wanting MIDI to type the exact name their driver enumerated — and nobody knows
/// what that is. A target is one of two kinds and each kind has its own question, so the kind
/// is picked first and the row then asks that kind's question: a host and a port for OSC, a
/// list of this machine's own devices for MIDI.
export struct OutputRow {
  /// What rules are routed to it by — `output::OutputTarget::id`. Never shown and never
  /// edited: it is what lets the name be changed without un-routing every rule.
  id: string,
  /// What the operator calls it. Left empty, the target is named after its address, which is
  /// what this field meant before names existed.
  name: string,
  /// `output::OutputTarget::Kind`: 0 is OSC, 1 is MIDI, 2 is Art-Net. The index into
  /// `output-kinds`.
  kind-index: int,
  /// OSC and Art-Net: where to send it, in two boxes because they are two facts and one of
  /// them has a sane default (9000, or Art-Net's own 6454) while the other does not.
  host: string,
  port: string,
  /// MIDI: which device, as an index into `output-devices` — 0 being that list's own
  /// "not chosen yet" label. A name would be the same trap the single address box was.
  device-index: int,
  /// Art-Net: which universes this node carries, as typed — "0, 1, 4". **Empty means every
  /// universe the fixture patch uses**, which is what one node on one rig wants and the
  /// reason the box can be left alone until there are two nodes.
  universes: string,
  /// "127.0.0.1:7000", or "midi Some Device" — `output::formatOutputAddress`. Not shown any
  /// more; kept because it is still the one string that says the whole destination, which is
  /// what a settings file holds and what a pasted rig arrives as.
  address: string,
  /// §5.6's per-target enabled state. Off sends nothing and keeps the address.
  enabled: bool,
  /// How long everything to this target is held back, in milliseconds — `OutputTarget::
  /// delaySeconds`. Milliseconds here rather than seconds because that is what the slider
  /// moves in and what the row reads out; the C++ side owns the conversion.
  delay-ms: float,
}

export component MainWindow inherits Window {
  title: root.version == "" ? "takt4" : "takt4 " + root.version;
  // Wider than it was, and the outputs row is why: a target now says its kind before its
  // destination, which is one more control on the busiest row in the window. At 900 the
  // delay slider — the one control on that row that is *dragged* — was down to a hundred
  // pixels for a two-second range. The floor rose with it, because below about 820 the row
  // has nowhere left to give.
  preferred-width: 1000px;
  preferred-height: 836px;
  min-width: 820px;
  // The floor is what has to be *on screen*, not what the window holds: the body scrolls,
  // so everything below this height is reachable rather than lost. 736px was the whole
  // content's own minimum, which put the floor above what fits on a 1366x768 laptop once
  // a title bar and a taskbar are taken off — the one size where being able to shrink the
  // window matters most. What is left is the pinned footer, the top bar with the device
  // pickers and START, and a useful amount of scrollable body between them.
  min-height: 420px;
  background: Theme.background;
  init => {
    Palette.color-scheme = ColorScheme.dark;
  }

  // Everything below is written by the C++ side and read by nothing else — `in` would
  // say that better. They are `in-out` because Slint generates a getter only for those,
  // and without one `takt4_ui_tests` could set a property but never check what the
  // window made of it. Nothing in this file writes to them.
  //
  // --- the input, chosen ---------------------------------------------------------
  in-out property <[string]> devices;
  in-out property <[string]> channels;
  in-out property <int> device-index;
  in-out property <int> channel-index;
  in-out property <bool> running;
  /// The input has stopped delivering audio, or is being reopened after it did — the audit's
  /// C4. While this is true the readouts are the last ones before the audio stopped, and the
  /// lock readout says NO AUDIO rather than LOCKED at a tempo nothing is producing any more.
  in-out property <bool> input-lost;
  /// What went missing between the input and the beats — "3 input overflows", "12 hops
  /// dropped — the model fell behind the audio" — or empty. Shown under the meter, because a
  /// device dropping input, or a machine too busy to keep up, is otherwise visible nowhere.
  in-out property <string> input-trouble;
  /// Look for input devices and MIDI ports again: an interface switched on after takt4
  /// started, a controller plugged in later. Only while stopped.
  callback rescan-clicked();

  // --- what the tracker says -----------------------------------------------------
  in-out property <float> bpm;
  in-out property <bool> locked;
  /// The operator is holding the lock up; see TempoTracker::setLockPinned.
  in-out property <bool> pinned;
  in-out property <bool> holding;
  in-out property <bool> refined;
  in-out property <float> confidence;
  in-out property <int> beats-per-bar;
  in-out property <int> beat-in-bar;
  in-out property <int> bars;
  /// How many of the filter's beats go to one published beat — `TempoState::beatDivisor`.
  /// One while the tempo below has been halved is the state worth seeing: the readout has
  /// moved and the beats have not.
  in-out property <int> beat-divisor: 1;

  // --- §5.5's octave fold, made visible (§7 deviation 4) and now settable ---------
  in-out property <bool> fold-on;
  in-out property <float> fold-min;
  in-out property <float> fold-max;
  in-out property <float> raw-bpm;
  /// The rate the filter is calling beats at — `TempoState::calledBpm`, which is `raw-bpm`
  /// unless the filter is contradicting itself. What the fold worked on, so what the
  /// "halved from" note below compares against: a cloud at 214 calling beats at 107 under
  /// a 70-140 window has been folded from 107 to 107, which is nothing, and saying "halved
  /// from 214 — beats still at 214" of it would be wrong twice.
  in-out property <float> called-bpm;

  // §5.5's latency offset: "one slider in milliseconds, applied to beat event
  // timestamps so events fire early enough". Negative is the useful direction.
  in-out property <float> latency-ms;

  /// Whether a ÷2 or ×2 carries on into the next track — `TempoTracker::Options::
  /// keepOctaveShift`. Off by default: the next record is dropped back to the tempo the
  /// tracker hears.
  in-out property <bool> keep-shift;

  // Taps in the set being counted in and taps needed before a tempo is offered, so
  // the TAP button can say that a press registered. 0 when no set is in progress.
  in-out property <int> tap-count;
  in-out property <int> tap-needs;
  /// A downbeat snap posted and not yet landed. See the DOWNBEAT button.
  in-out property <bool> snap-pending;

  // How far the two settings above can be dragged. The values here are only a sane
  // starting point for a preview: the C++ side sets all four at startup from the
  // constants it also clamps against (ui/window_state.hpp), so a slider can never
  // offer a value the controller would refuse.
  in-out property <float> fold-limit-min: 40;
  in-out property <float> fold-limit-max: 220;
  in-out property <float> fold-least-span: 5;
  in-out property <float> latency-limit-ms: 250;
  /// How far a single output's delay slider goes, in milliseconds — `kMaxOutputDelaySeconds`.
  /// A whole second is longer than a beat anywhere in the tracker's range, so every phase of
  /// every beat is reachable.
  in-out property <float> output-delay-limit-ms: 1000;

  // --- the two displays that carry the window ------------------------------------
  in-out property <[TracePoint]> trace;
  in-out property <float> input-level;   // 0 to 1, mapped from dBFS by the caller
  in-out property <float> input-peak;
  in-out property <string> input-reading;

  // --- §5.9's OUTPUTS row --------------------------------------------------------
  // What is being sent, and what it is being sent to. `*-on` is what the operator
  // asked for; `link-peers` and `beats-sent` are what actually happened, which is the
  // difference between a tick box and a working rig.
  in-out property <bool> link-on;
  in-out property <int> link-peers;
  in-out property <bool> osc-on;
  /// Whether any target is an Art-Net node, which is what decides whether the destination
  /// column is wide enough for three fields and whether there is a "universes" heading over
  /// the third. A property rather than a search through `outputs-list` in the markup, because
  /// Slint has no fold and the C++ side already walks the list to build it.
  in-out property <bool> outputs-any-artnet;

  /// §5.6's targets, one row each. Written by the C++ side whenever the list changes shape
  /// — never while a row is being typed into, which would reset the field under the cursor.
  in-out property <[OutputRow]> outputs-list;
  /// What kinds of target there are, in `output::OutputTarget::Kind` order.
  in-out property <[string]> output-kinds;
  /// Every MIDI output on this machine, with a "pick one" label at index 0 — what a target
  /// row's device dropdown offers. Separate from `midi-ports` below only in that label:
  /// leaving the clock unset is a setting, leaving a target's device unset is an unfinished
  /// row, and the two want different words for the same empty entry.
  in-out property <[string]> output-devices;
  in-out property <bool> midi-on;
  /// The MIDI clock port, as an index into `midi-ports` — 0 is "no MIDI clock".
  ///
  /// An index rather than the name it used to be. `current-value <=>` on a ComboBox does not
  /// move the selection when it is written from outside (Slint 11970), so every write from
  /// `publishOutputs` was silently dropped and the box could sit on a port the transports
  /// were not using; it also logged a warning on every redraw.
  in-out property <int> midi-port-index;
  in-out property <[string]> midi-ports;
  in-out property <int> beats-sent;
  /// What has gone wrong on the way out that nothing else on screen says — "3 rule messages
  /// reached no output", "12 MIDI clock ticks skipped" — or empty (the audit's M12). Shown
  /// under the outputs heading, for the reason `input-trouble` is under the meter.
  in-out property <string> output-trouble;

  // --- §5.7's control input --------------------------------------------------------
  // What drives the app from outside it. The port is a fact about this desk and lives in
  // machine settings; the bindings are *learned* rather than typed, because nobody knows
  // what their controller's pad 3 sends and a box asking for a note number is a worse
  // question than "press it now".
  in-out property <[string]> midi-in-ports;
  /// Which of them, as an index — 0 being that list's own "select input" label. See
  /// `midi-port-index` for why this is not the name.
  in-out property <int> midi-in-port-index;
  in-out property <bool> control-on;
  /// One per ControlAction, in kControlActions order, as labelOf() writes them.
  in-out property <[string]> learn-actions;
  in-out property <int> learn-action-index;
  in-out property <bool> learning;
  /// What the selected action is bound to, or what just arrived unbound. The second is
  /// what tells an operator their controller is on a channel nothing is listening to,
  /// which otherwise looks exactly like a broken cable.
  in-out property <string> control-reading;

  callback midi-in-picked(int);
  callback learn-action-picked(int);
  /// Arms learn mode for the selected action, or disarms it when it already is.
  callback learn-clicked();
  callback forget-clicked();

  /// §5.7's other surface: a listening UDP socket, so a Stream Deck or Bitfocus Companion
  /// can drive this without touching the laptop. Off until asked — OSC carries no
  /// authentication and takt4 invents none, so opening the socket, and opening it past
  /// loopback, are two separate decisions and both are the operator's.
  in-out property <bool> osc-control-on;
  /// The port actually bound, as text, or what has been typed while it is off. Not always
  /// the port that was asked for: 0 means "any free one" and the operator needs the real
  /// number to point a surface at.
  in-out property <string> osc-control-port;
  in-out property <bool> osc-control-network;
  /// The last address that arrived and where from, or the counts. What tells an operator
  /// their surface is aimed at the wrong prefix, which otherwise looks like a dead cable.
  in-out property <string> osc-control-reading;

  callback osc-control-toggled(bool);
  callback osc-control-port-edited(string);
  callback osc-control-network-toggled(bool);

  /// §5.9's TRIGGERS row. The editor is a window of its own (rules_window.slint), so what
  /// belongs here is only what an operator needs while watching the tracker: how many rules
  /// are armed, what just fired, and PANIC — which has to be reachable without opening
  /// anything, because it is pressed in a hurry.
  in-out property <int> rules-active;
  in-out property <int> rules-total;
  in-out property <string> rules-last-fired;
  in-out property <bool> panicked;

  callback rules-clicked();
  /// ABOUT in the status line: the licence, the source and the notices.
  callback about-opened();
  /// How many fixtures are patched, for the button that opens the patch editor. Zero is a rig
  /// with no lights on it, and the button says "PATCH LIGHTS" rather than "0 FIXTURES".
  in-out property <int> fixtures-total;
  callback fixtures-clicked();
  callback panic-clicked();

  in-out property <string> status;
  in-out property <bool> status-is-error;

  // What this build is, kept where it cannot be scrolled or overwritten. It used to be
  // said once, in the opening status line, and the first thing that set a status took it
  // away — so the answer to "which build is this?" was gone by the time anyone had cause
  // to ask. It is in the title bar and in the corner of the status bar instead.
  in-out property <string> version;

  callback device-picked(int);
  callback channel-picked(int);
  callback toggle-run();

  // §5.5's manual half. Each one is a `post` on the engine's control queue; none of
  // them touches the tracker from this thread.
  callback halve();
  callback redouble();
  callback tap();
  callback snap-downbeat();
  /// Fires every rule whose trigger is "manual hotkey" — the M key. The same thing
  /// `/ctl/manual` and a learned MIDI pad do.
  callback manual-fired();
  /// The state being asked for, not a toggle: the button already shows the current one,
  /// and sending the intention is what makes two quick presses land as two changes.
  callback pin-changed(bool);
  callback fold-on-changed(bool);
  callback fold-min-changed(float);
  callback fold-max-changed(float);
  callback latency-changed(float);
  /// The new state of the "keep for the next track" box, not a flip.
  callback keep-shift-changed(bool);

  callback link-toggled(bool);
  /// A keystroke in one box of row N: remembered, not applied. Applying opens and closes a
  /// socket, and doing that once per character would rebuild it halfway through an address —
  /// but a draft that is only in the widget is lost the moment the list is republished,
  /// which is what pressing [+] does. The `-accepted` half is Enter, where a row is applied.
  callback output-name-edited(int, string);
  callback output-name-accepted(int, string);
  callback output-host-edited(int, string);
  callback output-host-accepted(int, string);
  callback output-port-edited(int, string);
  callback output-port-accepted(int, string);
  callback output-added();

  /// Write the settings now rather than on the way out, and the two file-picker routes
  /// beside it. See `WindowController::saveNow` for why a button had to exist.
  callback save-now();
  callback export-settings();
  callback import-settings();
  callback output-removed(int);
  callback output-enabled-changed(int, bool);
  /// Row N is an OSC target or a MIDI one. Applied at once, like the tick and unlike the
  /// text boxes: it changes which question the row is asking, so nothing is half-typed yet.
  callback output-kind-changed(int, int);
  /// Row N's Art-Net universe list, as typed. Edited keeps the keystroke; accepted rebuilds
  /// the sockets — the same split every other text box on this row makes.
  callback output-universes-edited(int, string);
  callback output-universes-accepted(int, string);
  /// Row N's MIDI device, as an index into `output-devices`. Applied at once for the same
  /// reason: it is a pick from a list, so there is nothing to wait for Enter about.
  callback output-device-picked(int, int);
  /// Row N's delay slider, in milliseconds. Applied as it moves, like the enabled tick and
  /// unlike the two text boxes: dragging it is how an operator finds the offset by ear, and
  /// a delay that waited for Enter could not be found that way at all.
  callback output-delay-changed(int, float);
  callback midi-port-picked(int);

  /// PANIC let go of — the RELEASE button beside PANIC, which is the only way back. See
  /// `panic-clicked`, which now only ever engages.
  callback panic-released();

  // The keyboard's resting place, so a shortcut works the moment the window opens.
  forward-focus: keys;

  // **The keyboard shortcuts** — the audit's H18. HANDOFF calls PANIC by keyboard
  // "non-negotiable for live use", and until this no `.slint` file handled a key at all.
  //
  // A key reaches this by bubbling up from whatever holds the focus, which is why everything
  // in the window is inside it and why nothing here ever leaves the focus nowhere (see
  // `FocusSink`). Printable keys are taken by a text box before they get this far, so T and D
  // cannot fire while somebody types a name; Escape is not, and `Field` takes it for itself,
  // so Escape in a box leaves the box and panics nothing. An open dropdown's popup stops the
  // bubbling too, so Escape there closes the list, as it should.
  //
  // A held key repeats; only its first press counts. TAP from a key held down would otherwise
  // tap at the keyboard's repeat rate — 30 a second — and seed an absurd tempo.
  keys := FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;

    key-pressed(event) => {
      if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
        return reject;
      }
      if (event.text == Key.Escape) {
        if (!event.repeat) {
          root.panic-clicked();
        }
        return accept;
      }
      // TAP and DOWNBEAT only while running, exactly like their buttons: each corrects a
      // tempo or a bar that is being tracked now.
      if (event.text == "t" || event.text == "T") {
        if (root.running && !event.repeat) {
          root.tap();
        }
        return accept;
      }
      if (event.text == "d" || event.text == "D") {
        if (root.running && !event.repeat) {
          root.snap-downbeat();
        }
        return accept;
      }
      // The "manual hotkey" trigger's hotkey, which it never had (the audit's M7). Whether or
      // not the tracker is running: the outputs are, and a manual cue is the operator's own.
      if (event.text == "m" || event.text == "M") {
        if (!event.repeat) {
          root.manual-fired();
        }
        return accept;
      }
      return reject;
    }

    // **Somewhere for a click on nothing to go.** See `FocusSink`: a text box in this window
    // commits when it loses the keyboard, and a click on a heading, a panel or the space
    // between two rows used to move the focus nowhere — so the box stayed lit and what was
    // typed in it stayed uncommitted until something else happened to take the focus.
    //
    // First in the window, so it is *behind* everything: a click that any real control wants
    // is taken by that control and never reaches here, and what does reach here is a click on
    // nothing. `Press` does the same thing for itself, since a button's own touch area would
    // otherwise swallow the click before this saw it. It hands the focus to `keys` itself, the
    // keyboard's resting place.
    TouchArea {
      clicked => {
        keys.focus();
      }
    }

    VerticalLayout {
      padding: 0;
      spacing: 0;

      // Everything above the triggers row scrolls — HANDOFF §5.9's window is taller than
      // some of the screens it is opened on, and until this was here the bottom of it was
      // simply cut off. Measured at the launch size of 1000x900 with four outputs
      // configured: the status bar was gone and PANIC was sliced in half, with no way to
      // reach either. There is no cliff now; there is a scroll bar.
      //
      // `viewport-height` is Slint's own `max(this height, the content's *minimum*)`, so
      // this scrolls only once the content can no longer fit at its minimum, and above that
      // the trace still takes the slack exactly as it did before.
      body := ScrollView {
        vertical-stretch: 1;
        // Vertically only. Without this a ScrollView sizes its viewport to whatever its
        // content asks for, and this window's rows are full of fixed widths — so it would
        // scroll sideways and half of every row would be off screen. The rule editor's own
        // scroller found this first; see `scroller` in rules_window.slint.
        viewport-width: self.visible-width;

        VerticalLayout {
          padding: 0;
          spacing: 0;

          // --- top bar: what we are listening to --------------------------------------
          Rectangle {
            background: Theme.panel;
            vertical-stretch: 0;

            HorizontalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: 12px;
              padding-bottom: 12px;
              spacing: 10px;

              // Named so `takt4_ui_tests` can find them: Slint's testing backend addresses
              // elements as "MainWindow::<id>", and a test that clicks the real button is what
              // proves the callback below is wired to the controller at all.
              device-picker := ComboBox {
                model: root.devices;
                current-index <=> root.device-index;
                enabled: !root.running;
                horizontal-stretch: 2;
                selected => {
                  root.device-picked(self.current-index);
                }
              }

              channel-picker := ComboBox {
                model: root.channels;
                current-index <=> root.channel-index;
                enabled: !root.running;
                horizontal-stretch: 1;
                selected => {
                  root.channel-picked(self.current-index);
                }
              }

              // The device list is read once, when takt4 starts — so an interface switched on
              // afterwards, or unplugged and plugged back in, was never in it (the audit's H11).
              // Beside the pickers it refreshes, and only while stopped, because every device
              // is renumbered when it runs.
              Press {
                text: "RESCAN";
                enabled: !root.running;
                min-width: 108px;
                clicked => {
                  root.rescan-clicked();
                }
              }

              run-button := Press {
                text: root.running ? "STOP" : "START";
                primary: !root.running;
                enabled: root.devices.length > 0;
                min-width: 116px;
                clicked => {
                  root.toggle-run();
                }
              }
            }
          }

          Rectangle {
            height: 1px;
            background: Theme.line;
            vertical-stretch: 0;
          }

          // --- the readouts ------------------------------------------------------------
          // The readouts take the height they need; the trace below gets the rest, because
          // it is the one thing here that is worth more when it is bigger.
          HorizontalLayout {
            padding: 24px;
            spacing: 24px;
            vertical-stretch: 0;

            // tempo, and the bar. Centred rather than stretched: a VerticalLayout's
            // default alignment spreads the leftover height *between* children that
            // cannot stretch, which pushed these forty pixels apart.
            VerticalLayout {
              spacing: 4px;
              horizontal-stretch: 1;
              alignment: center;

              HorizontalLayout {
                spacing: 8px;
                alignment: start;
                vertical-stretch: 0;

                Text {
                  // Two decimals: the refined tempo resolves to a fraction of a BPM,
                  // and rounding it to a whole number would throw that away.
                  text: root.bpm > 0 ? round(root.bpm * 100) / 100 : "--";
                  color: Theme.text;
                  font-size: 64px;
                  font-weight: 300;
                  font-family: "Consolas";
                }

                Text {
                  // Sat on the baseline of the number beside it. A layout owns its
                  // children's y, so this is vertical-alignment and not a y binding —
                  // that one was silently ignored and left the label up in the air.
                  text: "BPM";
                  color: Theme.dim;
                  font-size: 14px;
                  vertical-alignment: bottom;
                }
              }

              Text {
                // Where the number comes from. Before the lock it is the particle
                // cloud's tempo interval, which steps in whole 20 ms frames — 5.4 BPM
                // apart at 130. After it, the spacing of the beats themselves.
                text: root.bpm <= 0 ? ""
                  : root.refined ? "from beat spacing"
                  : "from the filter's tempo interval";
                color: Theme.dim;
                font-size: 11px;
                vertical-stretch: 0;
              }

              Rectangle { height: 12px; vertical-stretch: 0; }

              // The bar indicator. However many beats the tracker reports — three,
              // four, five, seven. §5.5: nothing here hardcodes four.
              HorizontalLayout {
                spacing: 10px;
                alignment: start;
                vertical-stretch: 0;
                height: 20px;

                for beat in root.beats-per-bar : Rectangle {
                  width: 16px;
                  height: 16px;
                  border-radius: 8px;
                  border-width: 2px;
                  border-color: beat == 0 ? Theme.text : Theme.dim;
                  background: beat + 1 == root.beat-in-bar
                    ? (beat == 0 ? Theme.text : Theme.accent)
                    : transparent;
                }

                Rectangle { width: 8px; }

                Text {
                  text: root.beats-per-bar > 0 ? root.beats-per-bar + "/4" : "--";
                  color: Theme.dim;
                  font-size: 14px;
                  font-family: "Consolas";
                  vertical-alignment: center;
                }

                Text {
                  text: root.bars > 0 ? "bar " + root.bars : "";
                  color: Theme.dim;
                  font-size: 12px;
                  vertical-alignment: center;
                }
              }
            }

            // lock, confidence, and the fold window
            VerticalLayout {
              spacing: 10px;
              horizontal-stretch: 1;
              alignment: center;

              HorizontalLayout {
                spacing: 8px;
                alignment: end;
                vertical-stretch: 0;

                Rectangle {
                  width: 10px;
                  height: 10px;
                  y: 6px;
                  border-radius: 5px;
                  background: !root.running ? Theme.line
                    : root.input-lost ? Theme.alarm
                    : root.holding ? Theme.holding
                    : root.locked ? Theme.locked
                    : Theme.dim;
                }

                // NO AUDIO before anything else: with the input dead the tracker is frozen on
                // its last state, and LOCKED at that tempo was the window lying about a rig that
                // had stopped hearing the music.
                Text {
                  text: !root.running ? "STOPPED"
                    : root.input-lost ? "NO AUDIO"
                    : root.holding ? "HOLDING"
                    : root.locked ? "LOCKED"
                    : "HUNTING";
                  color: !root.running ? Theme.dim
                    : root.input-lost ? Theme.alarm
                    : root.holding ? Theme.holding
                    : root.locked ? Theme.locked
                    : Theme.dim;
                  font-size: 18px;
                  letter-spacing: 2px;
                }
              }

              Bar {
                label: "confidence";
                value: root.confidence;
                reading: round(root.confidence * 100) / 100;
                // §5.5's confidence gate: below it the tempo above is the last good
                // one being held, not a fresh reading, and the color says so.
                fill: root.holding ? Theme.holding : Theme.accent;
              }

              Rectangle { height: 4px; vertical-stretch: 0; }

              // §7 deviation 4: the fold window is measured to help inside it and to fail
              // hard outside it, so an operator has to be able to see it and see what it
              // did to the number above. The window itself is on the sliders below — this
              // is the half of that they cannot show, which is the fold having *moved*
              // the reading.
              Text {
                // Only when folding actually moved the number, which is exactly when an
                // operator would otherwise mistrust the readout.
                //
                // The test is the *ratio*, not the difference. A fold is a halving or a
                // doubling, so it leaves the two numbers a factor of two apart; a plain
                // difference also catches the tenth-of-a-BPM gap between the cloud's
                // tempo interval and the refined tempo (§6: 5.4 BPM apart at 130), which
                // is not a fold and must not be announced as one.
                text: (root.fold-on && root.called-bpm > 0 && root.bpm > 0
                       && (root.called-bpm > root.bpm * 1.5 || root.called-bpm < root.bpm * 0.67))
                  // Named as the arithmetic that was done rather than as "folded", for the reason
                  // the row's own label is no longer "octave fold": the operator has to be able to
                  // read what happened to the number without knowing the word for it.
                  //
                  // **And whether the beats came with it.** Halving the number without halving the
                  // grid is a real state — see `TempoState::beatDivisor` — and it is the one thing
                  // on this window that is otherwise invisible: the readout says 92 and every
                  // output fires at 184. It is not a fault to be fixed by looking at it, so this
                  // says what is happening rather than warning; ÷2 with the range switched off is
                  // what moves both together.
                  //
                  // Against `called-bpm`, the grid the filter is actually calling beats on, and
                  // not `raw-bpm`, its cloud: the two differ by an octave on a track like Moonlake
                  // and the fold works on the first.
                  ? (root.called-bpm > root.bpm ? "halved from " : "doubled from ")
                    + round(root.called-bpm * 10) / 10 + " BPM"
                    + (root.called-bpm > root.bpm && root.beat-divisor <= 1
                       ? " — beats still at " + round(root.called-bpm) : "")
                  : "";
                color: Theme.holding;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-stretch: 0;
              }
            }
          }

          Rectangle {
            height: 1px;
            background: Theme.line;
            vertical-stretch: 0;
          }

          // --- the controls -----------------------------------------------------------
          // §5.9 draws ÷2, ×2 and TAP beside the bar indicator; they are gathered here
          // instead, with §5.5's manual downbeat beside them and its octave-fold window and
          // latency offset below. The sketch predates all three, and the four buttons read
          // as one row of things the operator presses rather than as an afterthought to the
          // readouts.
          Rectangle {
            background: Theme.panel;
            vertical-stretch: 0;

            VerticalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-top: 14px;
              padding-bottom: 14px;
              spacing: 12px;

              // The performance controls. Live only while the tracker is running: every one
              // of them corrects a tempo or a bar phase that is being tracked *now*, and a
              // ÷2 with nothing to halve is a button that lies about doing something.
              HorizontalLayout {
                spacing: 10px;
                alignment: start;
                vertical-stretch: 0;

                Press {
                  text: "÷2";
                  enabled: root.running;
                  min-width: 72px;
                  clicked => {
                    root.halve();
                  }
                }

                Press {
                  text: "×2";
                  enabled: root.running;
                  min-width: 72px;
                  clicked => {
                    root.redouble();
                  }
                }

                // Counts the operator in: three taps before there is a tempo, and a press
                // that registered has to look different from one that did not.
                Press {
                  text: root.tap-count > 0 ? "TAP  " + root.tap-count + "/" + root.tap-needs : "TAP";
                  hint: "T";
                  enabled: root.running;
                  min-width: 140px;
                  clicked => {
                    root.tap();
                  }
                }

                // §5.7's lock, pinned rather than set: the tracker goes on tracking and simply
                // is not allowed to let go of the tempo. Lit while held, because a tempo that
                // has stopped following the audio is alarming when nothing says why.
                Press {
                  text: "LOCK";
                  active: root.pinned;
                  enabled: root.running;
                  min-width: 96px;
                  clicked => {
                    root.pin-changed(!root.pinned);
                  }
                }

                Rectangle { width: 16px; }

                // §5.5: "Big keyboard / MIDI / OSC downbeat now ... Non-negotiable — the best
                // online downbeat tracker in the world scores 56% F1, and being two beats out
                // is worse than one tap." So it is the widest thing in the row.
                // Lit from the press until the next beat, which is when the correction reaches
                // the outputs — up to nine hundred milliseconds at 70 BPM. A press on the beat
                // moves the bar dots immediately (the tracker takes the nearer beat, so it names
                // the one just heard), but a press between beats still has to wait for one, and a
                // button that does nothing for most of a second, then shifts a bar phase that is
                // hard to see moving, reads as a button that does nothing at all.
                Press {
                  text: "DOWNBEAT";
                  hint: "D";
                  primary: root.running;
                  active: root.snap-pending;
                  enabled: root.running;
                  min-width: 196px;
                  clicked => {
                    root.snap-downbeat();
                  }
                }
              }

              // The settings, live whether or not anything is running: an operator sets the
              // fold window for their material before pressing Start, and the engine applies
              // what was posted while it was stopped to the run about to begin.
              HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 0;

                Text {
                  // **Not "octave fold"**, which is what this said and which nobody outside the
                  // code knows the meaning of — the user who wrote the feature said so. The label
                  // now describes what the setting *does to the number on screen*: a tempo outside
                  // this range is halved or doubled until it is inside. Read with the readouts
                  // beside it the row says "keep BPM in 70 to 140 BPM", which is the whole of it.
                  text: "keep BPM in";
                  color: Theme.dim;
                  font-size: 12px;
                  width: 74px;
                  vertical-alignment: center;
                }

                // Unlabelled, because the column to its left is the label — which is what
                // lines this row's slider up with the latency row's.
                CheckBox {
                  checked <=> root.fold-on;
                  width: 36px;
                  // The new state, not a flip: what the operator sees is what gets sent.
                  toggled => {
                    root.fold-on-changed(self.checked);
                  }
                }

                Slider {
                  minimum: root.fold-limit-min;
                  // The two cannot cross. `foldInto` quietly returns the tempo unfolded when
                  // the window is inverted, which would look like the fold having no effect
                  // rather than like a setting being wrong.
                  maximum: root.fold-max - root.fold-least-span;
                  step: 1;
                  enabled: root.fold-on;
                  value <=> root.fold-min;
                  changed(v) => {
                    root.fold-min-changed(v);
                  }
                }

                Text {
                  text: round(root.fold-min) + " to";
                  color: root.fold-on ? Theme.text : Theme.dim;
                  font-size: 12px;
                  font-family: "Consolas";
                  width: 66px;
                  horizontal-alignment: right;
                  vertical-alignment: center;
                }

                Slider {
                  minimum: root.fold-min + root.fold-least-span;
                  maximum: root.fold-limit-max;
                  step: 1;
                  enabled: root.fold-on;
                  value <=> root.fold-max;
                  changed(v) => {
                    root.fold-max-changed(v);
                  }
                }

                Text {
                  text: round(root.fold-max) + " BPM";
                  color: root.fold-on ? Theme.text : Theme.dim;
                  font-size: 12px;
                  font-family: "Consolas";
                  width: 76px;
                  horizontal-alignment: right;
                  vertical-alignment: center;
                }
              }

              Setting {
                label: "latency";
                // The width of the fold row's switch, so the two sliders share a left edge.
                indent: 36px;
                value <=> root.latency-ms;
                minimum: -root.latency-limit-ms;
                maximum: root.latency-limit-ms;
                // The sign is the whole point of this control — negative fires early — so it
                // is shown rather than left to be inferred from a thumb position. "all outputs"
                // because this one moves the whole rig and each output row has its own beside it;
                // the row readouts show the sum, so moving this visibly moves all of them.
                reading: (root.latency-ms > 0 ? "+" : "") + round(root.latency-ms) + " ms"
                    + (root.latency-ms == 0 ? "" : "  all");
                moved(v) => {
                  root.latency-changed(v);
                }
              }

              // What the ÷2 and ×2 above do when the record changes. A setting, so it sits with
              // the settings and is live while stopped; the audit's H2, and the operator's call
              // of 2026-09-23 that the default is to drop a shift at the next track.
              HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 0;

                Text {
                  // Words, not the buttons' own "÷2 / ×2": at this size and in this colour the ÷
                  // reads as a +, and "+2 / ×2" names nothing on the window (measured on a render).
                  text: "halve, double";
                  color: Theme.dim;
                  font-size: 12px;
                  width: 74px;
                  vertical-alignment: center;
                }

                CheckBox {
                  // Says what ticking it does, in the words of what the operator hears: left
                  // off, a new record that the tracker locks onto comes back at the tempo it
                  // hears. A tapped tempo is never carried; see `keepOctaveShift`.
                  text: "keep for the next track";
                  checked <=> root.keep-shift;
                  toggled => {
                    root.keep-shift-changed(self.checked);
                  }
                }
              }
            }
          }

          Rectangle {
            height: 1px;
            background: Theme.line;
            vertical-stretch: 0;
          }

          // --- the activation trace ------------------------------------------------------
          VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            vertical-stretch: 1;

            HorizontalLayout {
              spacing: 10px;
              vertical-stretch: 1;

              Text {
                text: "activation";
                color: Theme.dim;
                font-size: 12px;
                width: 74px;
                vertical-alignment: center;
              }

              Rectangle {
                background: Theme.panel;
                border-radius: 3px;
                min-height: 88px;
                clip: true;

                // One column per 50 Hz frame, oldest at the left. One repeater, not two,
                // so the model is tracked once however many marks a column carries.
                for point[i] in root.trace : Rectangle {
                  width: parent.width / root.trace.length;
                  x: i * self.width;
                  height: 100%;
                  y: 0;

                  // P(beat), from the bottom — and in the lock color on the frames the
                  // filter actually called a beat, which is the difference between the
                  // network seeing something and the filter agreeing.
                  Rectangle {
                    width: 100%;
                    height: parent.height * clamp(point.beat, 0.0, 1.0);
                    y: parent.height - self.height;
                    background: point.called ? Theme.locked : Theme.trace;
                  }

                  // P(downbeat), as a mark at its own height. This is the weakest signal
                  // in the whole chain — 56.51 F1 in §A.1, the reason §5.5 calls a manual
                  // downbeat non-negotiable — so it is worth being able to watch it.
                  Rectangle {
                    width: 100%;
                    height: 2px;
                    y: (parent.height - 2px) * (1.0 - clamp(point.downbeat, 0.0, 1.0));
                    background: point.downbeat > 0.02 ? Theme.accent.with-alpha(0.7) : transparent;
                  }
                }
              }
            }

            Bar {
              label: "input";
              value: root.input-level;
              reading: root.input-reading;
              // Peaking is the one thing an input meter must not be quiet about.
              fill: root.input-peak >= 0.99 ? Theme.holding : Theme.accent;
            }

            // The input's own complaints, under the meter they are about. An explicit height,
            // because an `if` row in a vertical layout otherwise takes a share of the spare
            // height — measured: `vertical-stretch: 0` does not stop it.
            if root.input-trouble != "" : Text {
              text: root.input-trouble;
              color: Theme.holding;
              font-size: 11px;
              height: 14px;
              vertical-stretch: 0;
              horizontal-alignment: right;
              overflow: elide;
            }
          }

          Rectangle {
            height: 1px;
            background: Theme.line;
            vertical-stretch: 0;
          }

          // --- §5.9's OUTPUTS row ---------------------------------------------------------
          // "Link ✓ · OSC 192.168.1.40:7000 ✓ · MIDI clock ✓", and settable rather than only
          // shown: Phase 5's exit is a new user going from launch to synced output without a
          // text editor or a restart, so this is where that happens.
          //
          // The tick and the reading are deliberately different things. A box says what the
          // operator asked for; the peer count and the beat counter say what is actually
          // happening, and an output that is on with nothing at the other end is exactly the
          // failure somebody needs to see at a gig.
          Rectangle {
            background: Theme.panel;
            vertical-stretch: 0;

            // A layout, not two loose children: a Rectangle positions its children itself, so the
            // second row would be drawn on top of the first — silently (§6).
            VerticalLayout {

            HorizontalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-top: 12px;
              padding-bottom: 8px;
              spacing: 10px;

              Text {
                text: "outputs";
                color: Theme.dim;
                font-size: 12px;
                width: 74px;
                vertical-alignment: center;
              }

              CheckBox {
                text: "Link";
                checked <=> root.link-on;
                width: 74px;
                toggled => {
                  root.link-toggled(self.checked);
                }
              }

              Text {
                // Peers are the whole point of Link, and "on with nobody there" is the state
                // worth being able to see.
                text: !root.link-on ? ""
                  : root.link-peers == 0 ? "no peers"
                  : root.link-peers == 1 ? "1 peer"
                  : root.link-peers + " peers";
                color: root.link-peers > 0 ? Theme.locked : Theme.dim;
                font-size: 12px;
                width: 72px;
                vertical-alignment: center;
              }

              Text {
                text: "MIDI clock";
                color: root.midi-on ? Theme.text : Theme.dim;
                font-size: 12px;
                width: 72px;
                vertical-alignment: center;
              }

              midi-picker := ComboBox {
                model: root.midi-ports;
                current-index <=> root.midi-port-index;
                horizontal-stretch: 1;
                selected => {
                  root.midi-port-picked(self.current-index);
                }
              }

              Text {
                // What has actually gone out. Nothing else on screen distinguishes a transport
                // that is configured from one that is working.
                text: root.beats-sent > 0 ? root.beats-sent + " beats sent" : "";
                color: Theme.dim;
                font-size: 12px;
                font-family: "Consolas";
                width: 104px;
                horizontal-alignment: right;
                vertical-alignment: center;
              }
            }

            // What went wrong on the way out, under the heading it is about. An explicit
            // height, for the reason the input's own line under the meter has one.
            if root.output-trouble != "" : HorizontalLayout {
              padding-left: 24px;
              padding-right: 24px;
              height: 16px;
              vertical-stretch: 0;

              Text {
                text: root.output-trouble;
                color: Theme.holding;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
              }
            }

            // **The column headings, and they are not decoration.**
            //
            // A row of this is a tick box, two or three text boxes, a dropdown, a slider and two
            // numbers, and every one of them was bare: the boxes only said what they were while
            // they were *empty*, because the answer was in their placeholder, and a rig that had
            // filled them in was looking at "RDM10", "127.0.0.1", "6454" and "all" with nothing
            // saying which was which. Reported on 2026-09-16: *"which of the entry boxes is the
            // IP and which is the name? wtf is the box that just says 'all'? LABEL UI ELEMENTS!!
            // humans arent psychcic."*
            //
            // Drawn once above the list rather than per row, because repeated down the side they
            // would read as four separate settings rather than as one table — the same argument
            // the "targets" label already makes. The widths are the rows' own, so the headings
            // sit over what they name; the `if` on the Art-Net pair is the same test the rows
            // use, so a rig with no node has no column for one.
            if root.outputs-list.length > 0 : HorizontalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-bottom: 3px;
              spacing: 10px;

              Rectangle { width: 74px; horizontal-stretch: 0; }

              Text {
                text: "on";
                color: Theme.dim;
                font-size: 10px;
                width: 28px;
                horizontal-stretch: 0;
                horizontal-alignment: center;
              }

              // Every heading carries **exactly the size constraints of the column under it** —
              // the rows are separate layouts, and two layouts only share out a narrow window
              // the same way when every column gives way by the same rules. With a hard width
              // here and a softer one below, the headings drifted a column to the left at the
              // window's minimum width (rendered at 820 px).
              Text {
                text: "name";
                color: Theme.dim;
                font-size: 10px;
                preferred-width: 104px;
                min-width: 80px;
                max-width: 104px;
                horizontal-stretch: 0;
                overflow: elide;
              }

              Text {
                text: "protocol";
                color: Theme.dim;
                font-size: 10px;
                width: 84px;
                horizontal-stretch: 0;
              }

              // The destination slot, which is a host and a port — and on Art-Net a universe
              // list as well, and on MIDI a device picker instead. One heading per shape, over
              // the same widths the row uses.
              HorizontalLayout {
                preferred-width: root.outputs-any-artnet ? 288px : 226px;
                max-width: root.outputs-any-artnet ? 288px : 226px;
                min-width: root.outputs-any-artnet ? 192px : 150px;
                horizontal-stretch: 0;
                spacing: 6px;

                Text {
                  text: "host / device";
                  color: Theme.dim;
                  font-size: 10px;
                  horizontal-stretch: 1;
                  overflow: elide;
                }

                Text {
                  text: "port";
                  color: Theme.dim;
                  font-size: 10px;
                  width: 62px;
                  horizontal-stretch: 0;
                }

                if root.outputs-any-artnet : Text {
                  // The box that said "all" and nothing else. "all" is its *value* — every
                  // universe the patch uses — and a value is not a label.
                  text: "universes";
                  color: Theme.dim;
                  font-size: 10px;
                  width: 56px;
                  horizontal-stretch: 0;
                  overflow: elide;
                }
              }

              Text {
                text: "this target's own delay";
                color: Theme.dim;
                font-size: 10px;
                min-width: 70px;
                horizontal-stretch: 1;
                overflow: elide;
              }

              Text {
                text: "total";
                color: Theme.dim;
                font-size: 10px;
                width: 116px;
                horizontal-stretch: 0;
                horizontal-alignment: right;
              }

              Rectangle { width: 44px; horizontal-stretch: 0; }
            }

            // §5.6's targets, a row each. They used to be one field among four on the row
            // above, then one field of their own holding a comma-separated line — and the whole
            // point of naming them is that a rig has several, so a rig's worth of them is a
            // list. The name a rule routes to and the place the message goes are two facts, so
            // they get two boxes: `output::formatOutputAddress` is what the second one holds.
            for target[index] in root.outputs-list: HorizontalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-bottom: 6px;
              spacing: 10px;

              Text {
                // The column label, on the first row only. Repeated down the side it would read
                // as four separate settings rather than as one list.
                text: index == 0 ? "targets" : "";
                color: root.osc-on ? Theme.text : Theme.dim;
                font-size: 12px;
                width: 74px;
                vertical-alignment: center;
              }

              CheckBox {
                // §5.6's per-target enabled state: a switch rather than deleting the row, because
                // an operator killing one feed mid-set wants it back afterwards with its address
                // intact. Applied at once — a tick box that waited for Enter would be a lie.
                checked: target.enabled;
                width: 28px;
                toggled => {
                  root.output-enabled-changed(index, self.checked);
                }
              }

              // **Each box reports only itself.** The row used to be two boxes that each sent both
              // values, because both halves had to travel together — but a row is four fields now,
              // and two of them live inside an `if`, where an id in one branch cannot be read from
              // the other. The C++ side holds the draft and merges, which it was already doing
              // (`targetDrafts_`); what changed is that it merges a field rather than a whole row.
              Field {
                text: target.name;
                placeholder-text: "name";
                font-size: 12px;
                // The heading's constraints exactly — see the "name" heading above.
                preferred-width: 104px;
                min-width: 80px;
                max-width: 104px;
                horizontal-stretch: 0;
                edited(text) => {
                  root.output-name-edited(index, text);
                }
                accepted(text) => {
                  self.leave();
                  root.output-name-accepted(index, text);
                }
                // And when the operator clicks away instead of pressing
                // Enter, which is finishing rather than cancelling. Without
                // this, what they typed sat in the box until the next
                // publish wrote over it, and the edit was silently lost.
                changed has-focus => {
                  if (!self.has-focus) {
                    root.output-name-accepted(index, self.text);
                  }
                }
              }

              // OSC or MIDI, asked before anything else on the row, because it decides what the
              // rest of the row is even asking. See `OutputRow`.
              ComboBox {
                model: root.output-kinds;
                current-index: target.kind-index;
                // Two four-letter words and a chevron. Measured rather than guessed: at 66px the
                // Fluent ComboBox spent it all on its own padding and drew "O..." and "M...".
                width: 84px;
                horizontal-stretch: 0;
                selected => {
                  root.output-kind-changed(index, self.current-index);
                }
              }

              // The destination, in a fixed-width slot so that the slider beside it starts at the
              // same x whichever kind the row is — a row switched to MIDI must not shove every
              // readout below it sideways. A quarter narrower than the single address box it
              // replaces, the width going to the delay slider, which is dragged and was too short
              // to find an offset by ear on.
              HorizontalLayout {
                // A quarter narrower than the single address box it replaces, which at the window's
                // own width was 302 px. `max-width` rather than a hard `width` so that it, and not
                // the row, is what gives when the window is dragged towards its minimum — at the
                // floor a host and a port still read, and a device name elides as it always did.
                //
                // An Art-Net row is one field wider — a host, a port *and* a universe list — so
                // it takes the extra rather than squeezing all three into a slot sized for two.
                // The delay slider beside it gives it up; that slider stretches, and this does
                // not, so every readout to the right of it still starts at the same x.
                //
                // **Sized by whether any row is Art-Net, not by this row's kind** — the same test
                // the column headings use. Sized by its own kind, an OSC row's slot was the
                // narrower one in a rig that also had a node, so its delay slider started under
                // the "universes" heading and every heading to the right of it named the wrong
                // column (rendered at 1000 px). The space a universe list would take is left
                // empty on the rows that have none; see the spacer at the end of the slot.
                preferred-width: root.outputs-any-artnet ? 288px : 226px;
                max-width: root.outputs-any-artnet ? 288px : 226px;
                min-width: root.outputs-any-artnet ? 192px : 150px;
                horizontal-stretch: 0;
                spacing: 6px;

                // `if`, not `visible`: a hidden element still takes its layout space, so the two
                // shapes would each reserve room for the other and neither would get the slot.
                // See rules_window.slint's slot rows for the render that found it.
                if target.kind-index != 1 : Field {
                  text: target.host;
                  placeholder-text: "127.0.0.1";
                  font-size: 12px;
                  horizontal-stretch: 1;
                  // Its own floor, not the Fluent box's 160 px: with the port beside it that was
                  // a slot of 228 px against the 150 it is meant to give way to, so at the
                  // window's minimum width the row overflowed and the port box slid under the
                  // delay slider (rendered at 820 px). At the window's very minimum an address
                  // shows its first half and scrolls in the box when typed into; at the size the
                  // window opens at it reads whole.
                  min-width: 62px;
                  edited(text) => {
                    root.output-host-edited(index, text);
                  }
                  accepted(text) => {
                    self.leave();
                    root.output-host-accepted(index, text);
                  }
                  // And when the operator clicks away instead of pressing
                  // Enter, which is finishing rather than cancelling. Without
                  // this, what they typed sat in the box until the next
                  // publish wrote over it, and the edit was silently lost.
                  changed has-focus => {
                    if (!self.has-focus) {
                      root.output-host-accepted(index, self.text);
                    }
                  }
                }

                if target.kind-index != 1 : Field {
                  text: target.port;
                  placeholder-text: target.kind-index == 2 ? "6454" : "9000";
                  font-size: 12px;
                  width: 62px;
                  horizontal-stretch: 0;
                  edited(text) => {
                    root.output-port-edited(index, text);
                  }
                  accepted(text) => {
                    self.leave();
                    root.output-port-accepted(index, text);
                  }
                  // And when the operator clicks away instead of pressing
                  // Enter, which is finishing rather than cancelling. Without
                  // this, what they typed sat in the box until the next
                  // publish wrote over it, and the edit was silently lost.
                  changed has-focus => {
                    if (!self.has-focus) {
                      root.output-port-accepted(index, self.text);
                    }
                  }
                }

                // Art-Net's third field: which universes this node carries. Empty is every
                // universe the patch uses, which is the ordinary rig of one node — so the
                // placeholder says what leaving it alone means rather than showing a value the
                // operator would then have to maintain.
                if target.kind-index == 2 : Field {
                  text: target.universes;
                  placeholder-text: "all";
                  font-size: 12px;
                  width: 56px;
                  horizontal-stretch: 0;
                  edited(text) => {
                    root.output-universes-edited(index, text);
                  }
                  accepted(text) => {
                    self.leave();
                    root.output-universes-accepted(index, text);
                  }
                  changed has-focus => {
                    if (!self.has-focus) {
                      root.output-universes-accepted(index, self.text);
                    }
                  }
                }

                // The machine's own devices, never a name to be typed. Nobody knows what their
                // interface enumerated as, and a mistyped one is a target that silently sends
                // nowhere — which is the whole reason this row stopped being a text box.
                //
                // `== 1` and not `!= 0`, which is what it was: with two kinds those were the
                // same test, and the day a third arrived an Art-Net row drew its host, its port,
                // its universe list *and* a MIDI device picker, all in a slot sized for two of
                // them. Caught in a render; nothing in the markup would have said so.
                if target.kind-index == 1 : ComboBox {
                  model: root.output-devices;
                  current-index: target.device-index;
                  horizontal-stretch: 1;
                  // The slot's own floor, for the reason the host box gives: the Fluent
                  // ComboBox's minimum would otherwise hold the slot wider than it can go.
                  min-width: 120px;
                  selected => {
                    root.output-device-picked(index, self.current-index);
                  }
                }

                // Where an Art-Net row has its universe list, on a row that has none — so the
                // host and port boxes line up under their headings in a mixed rig.
                if root.outputs-any-artnet && target.kind-index != 2 : Rectangle {
                  width: 56px;
                  horizontal-stretch: 0;
                }
              }

              // §5.5's latency offset, per target. The thing on the end of each cable has its own
              // lag — a media server is a frame or two behind and a robot that has to physically
              // move is far more — so one slider for the whole rig is the one adjustment that
              // cannot help. See `OutputTarget::delaySeconds`, including what "earlier" can mean
              // for a message about a beat that has already been heard.
              // **The one control on this row that is dragged**, so it is the one that gets the
              // width. It was 112 px for a range of two seconds — 18 ms a pixel, which is a third
              // of a frame at 60 Hz and far coarser than the offsets it is used to find. Stretched
              // rather than widened by a fixed amount: what the destination box gave up is a floor,
              // and a window dragged wider should spend the rest here too.
              if target.kind-index != 2 : Slider {
                minimum: -root.output-delay-limit-ms;
                maximum: root.output-delay-limit-ms;
                step: 1;
                enabled: target.enabled;
                value: target.delay-ms;
                // The floor the heading above it has, so the two give way together; 70 is what
                // fits a row with a universe list inside the window's minimum width.
                min-width: 70px;
                horizontal-stretch: 1;
                changed(v) => {
                  root.output-delay-changed(index, v);
                }
              }
              // **An Art-Net row has no offset of its own**, and says so where the slider would
              // be rather than offering one that does nothing (the audit's M9). A universe is a
              // stream of frames that never stops, so there is no message to hold back; what moves
              // with the latency is when an effect starts, and the rig's slider already does that.
              if target.kind-index == 2 : Text {
                text: "follows the rig's latency";
                color: Theme.dim;
                font-size: 12px;
                min-width: 70px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
              }

              // Two readouts, not one string, and the difference between them is the point.
              //
              // **The milliseconds are the setting.** A device's lag is a fixed number of
              // milliseconds — a media server takes as long to key a clip at 92 BPM as at 140 —
              // and this is where an operator types what they measured. It does not move when the
              // music does.
              //
              // The beat fraction beside it is a *consequence*, which is why it is dim: it is the
              // same offset expressed against the tempo now playing, useful for the other way of
              // thinking about this ("put the robot half a beat late") and misleading if read as
              // the thing being set. One offset shows as 0.46♩ at 92 BPM and 0.64♩ at 128, and
              // nothing about the rig has changed.
              HorizontalLayout {
                spacing: 6px;
                width: 116px;
                horizontal-stretch: 0;

                Text {
                  // The row's **total** offset: this target's own plus the whole-rig slider above,
                  // because that is what actually happens to this feed and a reader should not
                  // have to add two numbers on two sides of the window to find it.
                  property <float> total: (target.kind-index == 2 ? 0 : target.delay-ms)
                      + root.latency-ms;
                  text: (total > 0 ? "+" : "") + round(total) + " ms";
                  color: total != 0 ? Theme.text : Theme.dim;
                  font-size: 12px;
                  font-family: "Consolas";
                  width: 64px;
                  horizontal-alignment: right;
                  vertical-alignment: center;
                }

                Text {
                  property <float> total: (target.kind-index == 2 ? 0 : target.delay-ms)
                      + root.latency-ms;
                  // Blank rather than a fraction of nothing when no tempo is being published.
                  text: total != 0 && root.bpm > 0
                      ? round(total * root.bpm / 600.0) / 100.0 + "♩"
                      : "";
                  color: Theme.dim;
                  font-size: 12px;
                  font-family: "Consolas";
                  // Wide enough for "-0.46♩", which is the longest this gets: the slider stops at
                  // a second and the beat it is measured against never exceeds 1.1 s.
                  width: 46px;
                  horizontal-alignment: right;
                  vertical-alignment: center;
                }
              }
              Press {
                text: "−";
                // Shorter than a Press usually is: a row of these is a list, not a row of things
                // to hit in a hurry, and forty pixels each would push the trace off the window.
                min-height: 30px;
                min-width: 44px;
                clicked => {
                  // The keyboard back to the window **first**: this button is about to be
                  // destroyed with its row, and the focus it took on the click would go with it
                  // — leaving Escape reaching nothing until the next click (see `keys`). First,
                  // not after, because nothing may be touched once a handler's own row is gone.
                  keys.focus();
                  root.output-removed(index);
                }
              }
            }

            HorizontalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-bottom: 12px;
              spacing: 10px;

              Text {
                // The label lives on the first target row; with no rows there is none, and this
                // is the only line the word can be on.
                text: root.outputs-list.length == 0 ? "targets" : "";
                color: Theme.dim;
                font-size: 12px;
                width: 74px;
                vertical-alignment: center;
              }

              Press {
                text: "+ ADD OUTPUT";
                min-height: 30px;
                min-width: 168px;
                clicked => {
                  root.output-added();
                }
              }

              // Saving, which until 2026-09-12 happened only when the window closed. An operator
              // who had spent an hour on rules had no way to commit them and said so: "I am
              // scared of closing it". SAVE writes now; the save on exit is unchanged.
              Press {
                text: "SAVE";
                min-height: 30px;
                min-width: 82px;
                clicked => {
                  root.save-now();
                }
              }

              Press {
                text: "EXPORT";
                min-height: 30px;
                min-width: 90px;
                clicked => {
                  root.export-settings();
                }
              }

              Press {
                text: "IMPORT";
                min-height: 30px;
                min-width: 90px;
                clicked => {
                  root.import-settings();
                }
              }

              Text {
                text: root.outputs-list.length == 0
                    ? "nothing is being sent — add a media server or a lighting desk"
                    : "";
                color: Theme.dim;
                font-size: 12px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
              }
            }

            }
          }

          Rectangle {
            height: 1px;
            background: Theme.line;
            vertical-stretch: 0;
          }

          // --- §5.7's control row ---------------------------------------------------------
          // The mirror of the outputs row: that one says what is being sent, this one says what
          // is allowed to drive us. Two lines, because §5.7 has two surfaces — a box of buttons
          // on this desk, and a socket anything on the network can reach. Learn mode carries the
          // first: an operator picks the thing they want a button for, presses LEARN, then
          // presses the button.
          Rectangle {
            background: Theme.panel;
            vertical-stretch: 0;

            // A layout, not two loose children: a Rectangle positions its children itself, so a
            // second HorizontalLayout beside the first would be drawn on top of it rather than
            // under it — silently, which is §6's standing warning about Slint layout bugs.
            VerticalLayout {

            HorizontalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-top: 10px;
              padding-bottom: 10px;
              spacing: 10px;

              Text {
                text: "control";
                color: root.control-on ? Theme.text : Theme.dim;
                font-size: 12px;
                width: 56px;
                vertical-alignment: center;
              }

              // Index 0 of the model reads "select input" rather than being blank — see
              // `midi-in-ports`. A ComboBox has no placeholder, so an empty first entry left this
              // looking like an empty box somebody had failed to fill in rather than like a list
              // nothing has been picked from yet.
              control-picker := ComboBox {
                model: root.midi-in-ports;
                current-index <=> root.midi-in-port-index;
                horizontal-stretch: 1;
                selected => {
                  root.midi-in-picked(self.current-index);
                }
              }

              learn-picker := ComboBox {
                model: root.learn-actions;
                current-index <=> root.learn-action-index;
                enabled: root.control-on;
                horizontal-stretch: 1;
                selected => {
                  root.learn-action-picked(self.current-index);
                }
              }

              // Lit while armed, in the green a held LOCK uses: both mean "this is waiting on
              // you". Pressing it again gives up rather than stranding the operator in a mode
              // with no way out.
              learn-button := Press {
                text: root.learning ? "PRESS IT" : "LEARN";
                active: root.learning;
                enabled: root.control-on;
                min-width: 116px;
                clicked => {
                  root.learn-clicked();
                }
              }

              forget-button := Press {
                text: "FORGET";
                enabled: root.control-on;
                min-width: 96px;
                clicked => {
                  root.forget-clicked();
                }
              }

              Text {
                text: root.control-reading;
                color: Theme.dim;
                font-size: 12px;
                font-family: "Consolas";
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
              }
            }

            // The OSC half of the same row, on its own line: a socket rather than a port, and
            // three separate decisions — listen at all, on which port, and whether past this
            // machine. Kept visually inside the control panel because it answers the same
            // question the line above does: what is allowed to drive us.
            HorizontalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-bottom: 10px;
              spacing: 10px;

              Text {
                text: "OSC in";
                color: root.osc-control-on ? Theme.text : Theme.dim;
                font-size: 12px;
                width: 56px;
                vertical-alignment: center;
              }

              osc-control-check := CheckBox {
                checked <=> root.osc-control-on;
                text: "listen";
                toggled => {
                  root.osc-control-toggled(self.checked);
                }
              }

              osc-control-port-field := Field {
                text <=> root.osc-control-port;
                placeholder-text: "port";
                font-size: 12px;
                // A port is five characters. Fixed rather than stretched so the reading beside
                // it — which is the part that changes and the part an operator is watching —
                // gets the room instead.
                width: 84px;
                horizontal-stretch: 0;
                // `accepted`, not `edited`, for the reason the OSC target field gives: a
                // keystroke at a time would rebind the socket on every digit.
                accepted(text) => {
                  self.leave();
                  root.osc-control-port-edited(text);
                }
                // And when the operator clicks away instead of pressing
                // Enter, which is finishing rather than cancelling. Without
                // this, what they typed sat in the box until the next
                // publish wrote over it, and the edit was silently lost.
                changed has-focus => {
                  if (!self.has-focus) {
                    root.osc-control-port-edited(self.text);
                  }
                }
              }

              osc-control-network-check := CheckBox {
                checked <=> root.osc-control-network;
                // Spelled as what it *allows* rather than as "local only", so the checked state
                // is the permissive one. A negative box that is safe when ticked reads backwards
                // in a hurry, and this is a decision worth reading correctly.
                text: "allow other machines";
                toggled => {
                  root.osc-control-network-toggled(self.checked);
                }
              }

              Text {
                text: root.osc-control-reading;
                color: Theme.dim;
                font-size: 12px;
                font-family: "Consolas";
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
              }
            }

            }
          }
        }
      }

      // The top edge of what does not scroll. Below it the triggers row and the status bar
      // are pinned: PANIC is pressed in a hurry — §5.9 keeps it out of the editor for that
      // reason, and having to find it by scrolling would give the reason back — and the
      // status line is where an error and the build number are said.
      Rectangle {
        height: 1px;
        background: Theme.line;
        vertical-stretch: 0;
      }

      // --- §5.9's TRIGGERS row -------------------------------------------------------
      // "TRIGGERS  4 active                                  [ PANIC ]" — the sketch's own
      // line. The editor opens from here; PANIC does not, because a halt that needed a
      // window opened first would not be a halt.
      Rectangle {
        background: Theme.panel;
        vertical-stretch: 0;

        HorizontalLayout {
          padding-left: 24px;
          padding-right: 24px;
          padding-top: 10px;
          padding-bottom: 10px;
          spacing: 10px;

          Text {
            text: "triggers";
            color: root.rules-active > 0 ? Theme.text : Theme.dim;
            font-size: 12px;
            width: 56px;
            vertical-alignment: center;
          }

          Press {
            text: root.rules-total == 0 ? "ADD A RULE"
              : root.rules-active + " OF " + root.rules-total + " ACTIVE";
            min-width: 176px;
            clicked => {
              root.rules-clicked();
            }
          }

          // The lighting patch, beside the rules because a DMX rule is meaningless without one
          // — it aims at fixtures by name, and the names live there. The button says how many
          // there are so an operator can tell "no patch" from "patch not open", which is the
          // difference between a rule that cannot work and one that is simply idle.
          Press {
            text: root.fixtures-total == 0 ? "PATCH LIGHTS"
              : root.fixtures-total + (root.fixtures-total == 1 ? " FIXTURE" : " FIXTURES");
            min-width: 148px;
            clicked => {
              root.fixtures-clicked();
            }
          }

          Text {
            // What just went out, so the main window says whether the rig is being driven
            // without the editor being open. §5.9's last-fired line, one rig-wide copy.
            text: root.rules-last-fired;
            color: Theme.dim;
            font-size: 12px;
            font-family: "Consolas";
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
          }

          // **PANIC only ever engages; RELEASE is its own button** — the audit's H18. It was a
          // plain toggle, so a double-click on PANIC, which is exactly how a button is hit in a
          // hurry, engaged it and let go again before anybody saw it light.
          //
          // RELEASE appears to the *left*, so PANIC does not move when it does: the second click
          // of a double-click lands on PANIC again, which is already engaged, and does nothing.
          // Appearing on the right would have slid PANIC out from under the pointer and put
          // RELEASE where the second click lands — the same bug by another route.
          if root.panicked : Press {
            text: "RELEASE";
            min-width: 116px;
            clicked => {
              // The keyboard back to the window first, because this button goes the moment it
              // works and would take the focus with it — and the next Escape, the one that
              // matters, would then reach nothing. Measured: it did, before this line.
              keys.focus();
              root.panic-released();
            }
          }

          Press {
            text: root.panicked ? "PANICKED" : "PANIC";
            hint: "Esc";
            active: root.panicked;
            min-width: 150px;
            clicked => {
              root.panic-clicked();
            }
          }
        }
      }

      Rectangle {
        height: 1px;
        background: Theme.line;
        vertical-stretch: 0;
      }

      // --- the status line ------------------------------------------------------------
      Rectangle {
        background: Theme.panel;
        vertical-stretch: 0;
        height: 34px;

        Text {
          x: 16px;
          // Stops short of the version and ABOUT, which never change and so must never be
          // the thing that gets elided.
          width: parent.width - 32px - build.width - 16px - about.width - 10px;
          height: 100%;
          text: root.status;
          color: root.status-is-error ? Theme.holding : Theme.dim;
          font-size: 12px;
          vertical-alignment: center;
          // Two lines before it elides — the bar is tall enough for them. One line cut every
          // longer message off, and the longest are the ones that say what to do: an ASIO
          // interface held by another program, a port taken, every output that cannot be
          // reached (the audit's M25).
          wrap: word-wrap;
          overflow: elide;
        }

        build := Text {
          x: parent.width - self.width - 16px;
          height: 100%;
          text: root.version;
          color: Theme.dim;
          font-size: 12px;
          vertical-alignment: center;
        }

        // The licence, the source and the notices of what is built in (GPLv3 §5(d)). Beside
        // the version, which is where anyone looking for "what is this" looks. A `Press` like
        // every other button, so a click here finishes an edit as they all do; placed by hand
        // at the bar's height rather than laid out at a button's.
        about := Press {
          x: build.x - self.width - 10px;
          y: (parent.height - self.height) / 2;
          // Its own width, said outright: outside a layout an element takes its parent's
          // whole width, and this one first drew as a bar across the status line, hiding it
          // (caught by "a short window scrolls rather than losing its bottom row").
          width: self.preferred-width;
          height: 24px;
          text: "ABOUT";
          font: 11px;
          pad: 8px;
          clicked => { root.about-opened(); }
        }
      }
    }
  }
}
