// The main window — HANDOFF §5.9.
//
// §5.9 sketches one window: device and channel pickers along the top, the BPM readout
// and lock state in the middle, a bar indicator that draws however many beats the
// tracker reports, the ÷2 / ×2 / TAP controls beside it, and along the bottom the two
// things the handoff says carry this UI — the scrolling activation trace and the input
// meter. All of that is here, with §5.5's manual downbeat, octave-fold window and
// latency offset alongside.
//
// What is deliberately not here yet: the outputs row (it waits on the output thread),
// the trigger cards and PANIC (Phase 6), and §5.1's two-channel input options.
//
// Every control here *sends* through engine::BeatEngine::post(), and none of them talks
// to the tracker directly. The controller behind this window is the only thing that
// touches the engine; see window_controller.cpp for why a posted change is not read
// straight back.
//
// Nothing in this file assumes a meter of four. `beats-per-bar` comes from the particle
// filter's downbeat stage and the bar indicator is drawn from it, as §5.5 requires.

import { CheckBox, ComboBox, Palette, Slider } from "std-widgets.slint";

/// One 50 Hz frame of the activation trace. The network's two probabilities, and
/// whether the tracker actually called a beat on this frame — which is the difference
/// between "the model saw something" and "the filter agreed", and the whole reason the
/// trace is diagnostic rather than decorative.
export struct TracePoint {
  beat: float,
  downbeat: float,
  called: bool,
}

// A dark window, whatever the desktop is set to. This is read across a booth, and the
// std-widgets are pinned to the same scheme so the pickers do not come up white.
global Theme {
  out property <color> background: #121316;
  out property <color> panel: #191b1f;
  out property <color> line: #2b2f36;
  out property <color> text: #e9ebee;
  out property <color> dim: #878d97;
  out property <color> accent: #60cdff;   // fluent's own dark accent, so the pickers agree
  out property <color> locked: #4ade80;
  out property <color> holding: #fbbf24;
  out property <color> trace: #3f596b;

  // The pressable controls. Lighter than the panel they sit on, so a button reads as a
  // button, and their labels are plain white rather than the body text's off-white —
  // these are hit in a dark room, at a glance, while something else is going on.
  out property <color> control: #2b313a;
  out property <color> controlEdge: #4a525f;
  out property <color> controlPrimary: #17567a;
  out property <color> label: #ffffff;
  // A disabled button keeps its shape: it sits between the panel and an active control
  // rather than sinking into the background, because on a freshly opened window every
  // one of these is disabled and a row of holes is not what the app should look like.
  out property <color> controlOff: #21252b;
}

/// A button, built here rather than taken from std-widgets.
///
/// `Button` exposes `text`, `icon`, `primary`, `enabled` and `checkable` — and no
/// `font-size` or `font-weight`. Its label therefore comes out at the widget set's own
/// size in the widget set's own foreground colour, which on this dark panel is grey on
/// grey and too small to read at a glance. These are the controls an operator hits in a
/// booth, mid-set, while looking at something else, so the type is 17px, bold, and plain
/// white. It also settles `÷2`: at the std size the dots of U+00F7 all but vanish and the
/// glyph reads as `+`.
///
/// What is given up is the Fluent look and its focus ring. The pickers and sliders are
/// still std widgets, so the window keeps that vocabulary everywhere it does not cost
/// legibility.
component Press inherits Rectangle {
  in property <string> text;
  in property <bool> enabled: true;
  /// The one action in a row that should be reached for first.
  in property <bool> primary;
  callback clicked;

  private property <color> face: root.primary ? Theme.controlPrimary : Theme.control;

  min-height: 40px;
  horizontal-stretch: 0;
  border-radius: 5px;
  border-width: 1px;
  border-color: !root.enabled ? Theme.line
    : root.primary ? Theme.accent
    : touch.has-hover ? Theme.accent
    : Theme.controlEdge;
  background: !root.enabled ? Theme.controlOff
    : touch.pressed ? root.face.darker(0.3)
    : touch.has-hover ? root.face.brighter(0.25)
    : root.face;

  HorizontalLayout {
    padding-left: 16px;
    padding-right: 16px;

    Text {
      text: root.text;
      // Plain white, not Theme.text: this is the one thing in the window that has to
      // survive being glanced at rather than read.
      color: root.enabled ? Theme.label : Theme.dim;
      font-size: 17px;
      font-weight: 700;
      horizontal-alignment: center;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    enabled: root.enabled;
    clicked => {
      root.clicked();
    }
  }
}

/// A horizontal level bar with a label and a reading beside it.
component Bar inherits HorizontalLayout {
  in property <string> label;
  in property <float> value;      // 0 to 1
  in property <string> reading;
  in property <color> fill: Theme.accent;

  spacing: 10px;

  Text {
    text: root.label;
    color: Theme.dim;
    font-size: 12px;
    width: 74px;
    vertical-alignment: center;
  }

  Rectangle {
    background: Theme.panel;
    border-radius: 3px;
    vertical-stretch: 0;
    height: 10px;
    y: (parent.height - self.height) / 2;
    clip: true;

    Rectangle {
      x: 0;
      width: parent.width * clamp(root.value, 0.0, 1.0);
      height: 100%;
      background: root.fill;
      border-radius: 3px;
    }
  }

  Text {
    text: root.reading;
    color: Theme.text;
    font-size: 12px;
    font-family: "Consolas";
    width: 76px;
    horizontal-alignment: right;
    vertical-alignment: center;
  }
}

/// A setting the operator drags: the same label and reading columns as `Bar`, so a
/// control and a meter line up down the window.
///
/// `value` is two-way bound all the way down to the Slider, which is what lets the C++
/// side move the control when something other than a drag changes the setting — a tap
/// moves the fold window, and the window has to follow it (§7 deviation 8).
component Setting inherits HorizontalLayout {
  in property <string> label;
  in-out property <float> value;
  in property <float> minimum;
  in property <float> maximum;
  in property <float> step: 1;
  in property <string> reading;
  /// Blank column between the label and the slider, so a row with no switch in it lines
  /// its slider up with a row that has one.
  in property <length> indent: 0px;
  callback moved(float);

  spacing: 10px;

  Text {
    text: root.label;
    color: Theme.dim;
    font-size: 12px;
    width: 74px;
    vertical-alignment: center;
  }

  Rectangle { width: root.indent; }

  Slider {
    minimum: root.minimum;
    maximum: root.maximum;
    step: root.step;
    value <=> root.value;
    // A slider sends the value it now has, never a nudge. The control queue coalesces
    // settings changes, so two relative steps arriving in one round would collapse into
    // one and lose a step; an absolute value does not have the question.
    changed(v) => {
      root.moved(v);
    }
  }

  Text {
    text: root.reading;
    color: Theme.text;
    font-size: 12px;
    font-family: "Consolas";
    width: 76px;
    horizontal-alignment: right;
    vertical-alignment: center;
  }
}

export component MainWindow inherits Window {
  title: "takt4";
  preferred-width: 900px;
  preferred-height: 640px;
  min-width: 720px;
  min-height: 560px;
  background: Theme.background;
  init => {
    Palette.color-scheme = ColorScheme.dark;
  }

  // Everything below is written by the C++ side and read by nothing else — `in` would
  // say that better. They are `in-out` because Slint generates a getter only for those,
  // and without one `takt4_ui_tests` could set a property but never check what the
  // window made of it. Nothing in this file writes to them.
  //
  // --- the input, chosen ---------------------------------------------------------
  in-out property <[string]> devices;
  in-out property <[string]> channels;
  in-out property <int> device-index;
  in-out property <int> channel-index;
  in-out property <bool> running;

  // --- what the tracker says -----------------------------------------------------
  in-out property <float> bpm;
  in-out property <bool> locked;
  in-out property <bool> holding;
  in-out property <bool> refined;
  in-out property <float> confidence;
  in-out property <int> beats-per-bar;
  in-out property <int> beat-in-bar;
  in-out property <int> bars;

  // --- §5.5's octave fold, made visible (§7 deviation 4) and now settable ---------
  in-out property <bool> fold-on;
  in-out property <float> fold-min;
  in-out property <float> fold-max;
  in-out property <float> raw-bpm;

  // §5.5's latency offset: "one slider in milliseconds, applied to beat event
  // timestamps so events fire early enough". Negative is the useful direction.
  in-out property <float> latency-ms;

  // Taps in the set being counted in and taps needed before a tempo is offered, so
  // the TAP button can say that a press registered. 0 when no set is in progress.
  in-out property <int> tap-count;
  in-out property <int> tap-needs;

  // How far the two settings above can be dragged. The values here are only a sane
  // starting point for a preview: the C++ side sets all four at startup from the
  // constants it also clamps against (ui/window_state.hpp), so a slider can never
  // offer a value the controller would refuse.
  in-out property <float> fold-limit-min: 40;
  in-out property <float> fold-limit-max: 220;
  in-out property <float> fold-least-span: 5;
  in-out property <float> latency-limit-ms: 250;

  // --- the two displays that carry the window ------------------------------------
  in-out property <[TracePoint]> trace;
  in-out property <float> input-level;   // 0 to 1, mapped from dBFS by the caller
  in-out property <float> input-peak;
  in-out property <string> input-reading;

  in-out property <string> status;
  in-out property <bool> status-is-error;

  callback device-picked(int);
  callback channel-picked(int);
  callback toggle-run();

  // §5.5's manual half. Each one is a `post` on the engine's control queue; none of
  // them touches the tracker from this thread.
  callback halve();
  callback redouble();
  callback tap();
  callback snap-downbeat();
  callback fold-on-changed(bool);
  callback fold-min-changed(float);
  callback fold-max-changed(float);
  callback latency-changed(float);

  VerticalLayout {
    padding: 0;
    spacing: 0;

    // --- top bar: what we are listening to --------------------------------------
    Rectangle {
      background: Theme.panel;
      vertical-stretch: 0;

      HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;

        // Named so `takt4_ui_tests` can find them: Slint's testing backend addresses
        // elements as "MainWindow::<id>", and a test that clicks the real button is what
        // proves the callback below is wired to the controller at all.
        device-picker := ComboBox {
          model: root.devices;
          current-index <=> root.device-index;
          enabled: !root.running;
          horizontal-stretch: 2;
          selected => {
            root.device-picked(self.current-index);
          }
        }

        channel-picker := ComboBox {
          model: root.channels;
          current-index <=> root.channel-index;
          enabled: !root.running;
          horizontal-stretch: 1;
          selected => {
            root.channel-picked(self.current-index);
          }
        }

        run-button := Press {
          text: root.running ? "STOP" : "START";
          primary: !root.running;
          enabled: root.devices.length > 0;
          min-width: 116px;
          clicked => {
            root.toggle-run();
          }
        }
      }
    }

    Rectangle {
      height: 1px;
      background: Theme.line;
      vertical-stretch: 0;
    }

    // --- the readouts ------------------------------------------------------------
    // The readouts take the height they need; the trace below gets the rest, because
    // it is the one thing here that is worth more when it is bigger.
    HorizontalLayout {
      padding: 24px;
      spacing: 24px;
      vertical-stretch: 0;

      // tempo, and the bar. Centred rather than stretched: a VerticalLayout's
      // default alignment spreads the leftover height *between* children that
      // cannot stretch, which pushed these forty pixels apart.
      VerticalLayout {
        spacing: 4px;
        horizontal-stretch: 1;
        alignment: center;

        HorizontalLayout {
          spacing: 8px;
          alignment: start;
          vertical-stretch: 0;

          Text {
            // Two decimals: the refined tempo resolves to a fraction of a BPM,
            // and rounding it to a whole number would throw that away.
            text: root.bpm > 0 ? round(root.bpm * 100) / 100 : "--";
            color: Theme.text;
            font-size: 64px;
            font-weight: 300;
            font-family: "Consolas";
          }

          Text {
            // Sat on the baseline of the number beside it. A layout owns its
            // children's y, so this is vertical-alignment and not a y binding —
            // that one was silently ignored and left the label up in the air.
            text: "BPM";
            color: Theme.dim;
            font-size: 14px;
            vertical-alignment: bottom;
          }
        }

        Text {
          // Where the number comes from. Before the lock it is the particle
          // cloud's tempo interval, which steps in whole 20 ms frames — 5.4 BPM
          // apart at 130. After it, the spacing of the beats themselves.
          text: root.bpm <= 0 ? ""
            : root.refined ? "from beat spacing"
            : "from the filter's tempo interval";
          color: Theme.dim;
          font-size: 11px;
          vertical-stretch: 0;
        }

        Rectangle { height: 12px; vertical-stretch: 0; }

        // The bar indicator. However many beats the tracker reports — three,
        // four, five, seven. §5.5: nothing here hardcodes four.
        HorizontalLayout {
          spacing: 10px;
          alignment: start;
          vertical-stretch: 0;
          height: 20px;

          for beat in root.beats-per-bar : Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 2px;
            border-color: beat == 0 ? Theme.text : Theme.dim;
            background: beat + 1 == root.beat-in-bar
              ? (beat == 0 ? Theme.text : Theme.accent)
              : transparent;
          }

          Rectangle { width: 8px; }

          Text {
            text: root.beats-per-bar > 0 ? root.beats-per-bar + "/4" : "--";
            color: Theme.dim;
            font-size: 14px;
            font-family: "Consolas";
            vertical-alignment: center;
          }

          Text {
            text: root.bars > 0 ? "bar " + root.bars : "";
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
          }
        }
      }

      // lock, confidence, and the fold window
      VerticalLayout {
        spacing: 10px;
        horizontal-stretch: 1;
        alignment: center;

        HorizontalLayout {
          spacing: 8px;
          alignment: end;
          vertical-stretch: 0;

          Rectangle {
            width: 10px;
            height: 10px;
            y: 6px;
            border-radius: 5px;
            background: !root.running ? Theme.line
              : root.holding ? Theme.holding
              : root.locked ? Theme.locked
              : Theme.dim;
          }

          Text {
            text: !root.running ? "STOPPED"
              : root.holding ? "HOLDING"
              : root.locked ? "LOCKED"
              : "HUNTING";
            color: !root.running ? Theme.dim
              : root.holding ? Theme.holding
              : root.locked ? Theme.locked
              : Theme.dim;
            font-size: 18px;
            letter-spacing: 2px;
          }
        }

        Bar {
          label: "confidence";
          value: root.confidence;
          reading: round(root.confidence * 100) / 100;
          // §5.5's confidence gate: below it the tempo above is the last good
          // one being held, not a fresh reading, and the colour says so.
          fill: root.holding ? Theme.holding : Theme.accent;
        }

        Rectangle { height: 4px; vertical-stretch: 0; }

        // §7 deviation 4: the fold window is measured to help inside it and to fail
        // hard outside it, so an operator has to be able to see it and see what it
        // did to the number above. The window itself is on the sliders below — this
        // is the half of that they cannot show, which is the fold having *moved*
        // the reading.
        Text {
          // Only when folding actually moved the number, which is exactly when an
          // operator would otherwise mistrust the readout.
          //
          // The test is the *ratio*, not the difference. A fold is a halving or a
          // doubling, so it leaves the two numbers a factor of two apart; a plain
          // difference also catches the tenth-of-a-BPM gap between the cloud's
          // tempo interval and the refined tempo (§6: 5.4 BPM apart at 130), which
          // is not a fold and must not be announced as one.
          text: (root.fold-on && root.raw-bpm > 0 && root.bpm > 0
                 && (root.raw-bpm > root.bpm * 1.5 || root.raw-bpm < root.bpm * 0.67))
            ? "folded from " + round(root.raw-bpm * 10) / 10 + " BPM"
            : "";
          color: Theme.holding;
          font-size: 12px;
          horizontal-alignment: right;
          vertical-stretch: 0;
        }
      }
    }

    Rectangle {
      height: 1px;
      background: Theme.line;
      vertical-stretch: 0;
    }

    // --- the controls -----------------------------------------------------------
    // §5.9 draws ÷2, ×2 and TAP beside the bar indicator; they are gathered here
    // instead, with §5.5's manual downbeat beside them and its octave-fold window and
    // latency offset below. The sketch predates all three, and the four buttons read
    // as one row of things the operator presses rather than as an afterthought to the
    // readouts.
    Rectangle {
      background: Theme.panel;
      vertical-stretch: 0;

      VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 12px;

        // The performance controls. Live only while the tracker is running: every one
        // of them corrects a tempo or a bar phase that is being tracked *now*, and a
        // ÷2 with nothing to halve is a button that lies about doing something.
        HorizontalLayout {
          spacing: 10px;
          alignment: start;
          vertical-stretch: 0;

          Press {
            text: "÷2";
            enabled: root.running;
            min-width: 72px;
            clicked => {
              root.halve();
            }
          }

          Press {
            text: "×2";
            enabled: root.running;
            min-width: 72px;
            clicked => {
              root.redouble();
            }
          }

          // Counts the operator in: three taps before there is a tempo, and a press
          // that registered has to look different from one that did not.
          Press {
            text: root.tap-count > 0 ? "TAP  " + root.tap-count + "/" + root.tap-needs : "TAP";
            enabled: root.running;
            min-width: 128px;
            clicked => {
              root.tap();
            }
          }

          Rectangle { width: 16px; }

          // §5.5: "Big keyboard / MIDI / OSC downbeat now ... Non-negotiable — the best
          // online downbeat tracker in the world scores 56% F1, and being two beats out
          // is worse than one tap." So it is the widest thing in the row.
          Press {
            text: "DOWNBEAT";
            primary: root.running;
            enabled: root.running;
            min-width: 196px;
            clicked => {
              root.snap-downbeat();
            }
          }
        }

        // The settings, live whether or not anything is running: an operator sets the
        // fold window for their material before pressing Start, and the engine applies
        // what was posted while it was stopped to the run about to begin.
        HorizontalLayout {
          spacing: 10px;
          vertical-stretch: 0;

          Text {
            text: "octave fold";
            color: Theme.dim;
            font-size: 12px;
            width: 74px;
            vertical-alignment: center;
          }

          // Unlabelled, because the column to its left is the label — which is what
          // lines this row's slider up with the latency row's.
          CheckBox {
            checked <=> root.fold-on;
            width: 36px;
            // The new state, not a flip: what the operator sees is what gets sent.
            toggled => {
              root.fold-on-changed(self.checked);
            }
          }

          Slider {
            minimum: root.fold-limit-min;
            // The two cannot cross. `foldInto` quietly returns the tempo unfolded when
            // the window is inverted, which would look like the fold having no effect
            // rather than like a setting being wrong.
            maximum: root.fold-max - root.fold-least-span;
            step: 1;
            enabled: root.fold-on;
            value <=> root.fold-min;
            changed(v) => {
              root.fold-min-changed(v);
            }
          }

          Text {
            text: round(root.fold-min) + " to";
            color: root.fold-on ? Theme.text : Theme.dim;
            font-size: 12px;
            font-family: "Consolas";
            width: 66px;
            horizontal-alignment: right;
            vertical-alignment: center;
          }

          Slider {
            minimum: root.fold-min + root.fold-least-span;
            maximum: root.fold-limit-max;
            step: 1;
            enabled: root.fold-on;
            value <=> root.fold-max;
            changed(v) => {
              root.fold-max-changed(v);
            }
          }

          Text {
            text: round(root.fold-max) + " BPM";
            color: root.fold-on ? Theme.text : Theme.dim;
            font-size: 12px;
            font-family: "Consolas";
            width: 76px;
            horizontal-alignment: right;
            vertical-alignment: center;
          }
        }

        Setting {
          label: "latency";
          // The width of the fold row's switch, so the two sliders share a left edge.
          indent: 36px;
          value <=> root.latency-ms;
          minimum: -root.latency-limit-ms;
          maximum: root.latency-limit-ms;
          // The sign is the whole point of this control — negative fires early — so it
          // is shown rather than left to be inferred from a thumb position.
          reading: (root.latency-ms > 0 ? "+" : "") + round(root.latency-ms) + " ms";
          moved(v) => {
            root.latency-changed(v);
          }
        }
      }
    }

    Rectangle {
      height: 1px;
      background: Theme.line;
      vertical-stretch: 0;
    }

    // --- the activation trace ------------------------------------------------------
    VerticalLayout {
      padding-left: 24px;
      padding-right: 24px;
      padding-top: 8px;
      padding-bottom: 8px;
      spacing: 8px;
      vertical-stretch: 1;

      HorizontalLayout {
        spacing: 10px;
        vertical-stretch: 1;

        Text {
          text: "activation";
          color: Theme.dim;
          font-size: 12px;
          width: 74px;
          vertical-alignment: center;
        }

        Rectangle {
          background: Theme.panel;
          border-radius: 3px;
          min-height: 88px;
          clip: true;

          // One column per 50 Hz frame, oldest at the left. One repeater, not two,
          // so the model is tracked once however many marks a column carries.
          for point[i] in root.trace : Rectangle {
            width: parent.width / root.trace.length;
            x: i * self.width;
            height: 100%;
            y: 0;

            // P(beat), from the bottom — and in the lock colour on the frames the
            // filter actually called a beat, which is the difference between the
            // network seeing something and the filter agreeing.
            Rectangle {
              width: 100%;
              height: parent.height * clamp(point.beat, 0.0, 1.0);
              y: parent.height - self.height;
              background: point.called ? Theme.locked : Theme.trace;
            }

            // P(downbeat), as a mark at its own height. This is the weakest signal
            // in the whole chain — 56.51 F1 in §A.1, the reason §5.5 calls a manual
            // downbeat non-negotiable — so it is worth being able to watch it.
            Rectangle {
              width: 100%;
              height: 2px;
              y: (parent.height - 2px) * (1.0 - clamp(point.downbeat, 0.0, 1.0));
              background: point.downbeat > 0.02 ? Theme.accent.with-alpha(0.7) : transparent;
            }
          }
        }
      }

      Bar {
        label: "input";
        value: root.input-level;
        reading: root.input-reading;
        // Peaking is the one thing an input meter must not be quiet about.
        fill: root.input-peak >= 0.99 ? Theme.holding : Theme.accent;
      }
    }

    Rectangle {
      height: 1px;
      background: Theme.line;
      vertical-stretch: 0;
    }

    // --- the status line ------------------------------------------------------------
    Rectangle {
      background: Theme.panel;
      vertical-stretch: 0;
      height: 34px;

      Text {
        x: 16px;
        width: parent.width - 32px;
        height: 100%;
        text: root.status;
        color: root.status-is-error ? Theme.holding : Theme.dim;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
      }
    }
  }
}
