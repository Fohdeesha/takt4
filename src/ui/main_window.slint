// The main window — HANDOFF §5.9, in the Weltformat-dark look of §0.5 (2026-09-29).
//
// Top to bottom, each section a flat sheet on the page: what is being listened to; the tempo,
// with its confidence, lock and bar; the activation trace and the input meter; the controls an
// operator corrects the tracker with; the inputs that drive takt4 from outside, and the outputs
// it drives — both of which fold away — and, pinned below everything that scrolls, the triggers
// row with PANIC and the status bar. Every size and colour is the approved mockup's
// (`design/weltformat-dark/`), measured off its renders; the controls themselves are
// weltformat.slint's.
//
// Every control here *sends* through engine::BeatEngine::post(), and none of them talks
// to the tracker directly. The controller behind this window is the only thing that
// touches the engine; see window_controller.cpp for why a posted change is not read
// straight back. **And none of them sets its own value**: each says what the operator asked for,
// and shows what the controller then holds (see weltformat.slint).
//
// Nothing in this file assumes a meter of four. `beats-per-bar` comes from the decoder's
// bar position — the forward filter's, by default — and the bar indicator is drawn from it,
// as §5.5 requires.

import { Palette } from "std-widgets.slint";
import { Btn, Entry, Keycap, Meter, Pick, Reading, Scroller, SectionHead, SpanTrack, Tick, Track, Wf } from "weltformat.slint";

// §5.9's rule editor is a window of its own (rules_window.slint), re-exported through here
// so the Slint compiler produces one generated header for both. See src/ui/CMakeLists.txt.
export { RulesWindow, RuleRow, SlotRow } from "rules_window.slint";
// And the patch editor, for the same reason — see src/ui/CMakeLists.txt on why there is one
// generated header rather than one per window.
export { FixturesWindow, FixtureRow, ChannelRow } from "fixtures_window.slint";
export { AboutWindow } from "about_window.slint";
// One of each of weltformat.slint's controls, for the UI tests and `takt4-shot --widgets`; here
// for the same reason as the windows above.
export { WidgetBench, BenchRow } from "widget_bench.slint";

/// One 50 Hz frame of the activation trace. The network's two probabilities, and
/// whether the tracker actually called a beat on this frame — which is the difference
/// between "the model saw something" and "the filter agreed", and the whole reason the
/// trace is diagnostic rather than decorative.
export struct TracePoint {
  beat: float,
  downbeat: float,
  called: bool,
}

/// One of §5.6's simultaneous targets, as the row that edits it holds it.
///
/// **A row each, and the destination asked for as the destination is shaped.** A target is one of
/// several kinds and each kind has its own question: a host and a port for OSC and Art-Net, a list
/// of this machine's own devices for MIDI and a MIDI clock, nothing at all for Link — so the kind
/// is picked first and the row then asks that kind's question.
export struct OutputRow {
  /// What rules are routed to it by — `output::OutputTarget::id`. Never shown and never
  /// edited: it is what lets the name be changed without un-routing every rule.
  id: string,
  /// What the operator calls it. Left empty, the target is named after its address, which is
  /// what this field meant before names existed.
  name: string,
  /// `output::OutputTarget::Kind`: 0 is OSC, 1 is MIDI, 2 is Art-Net, 3 is a MIDI clock and
  /// 4 is Link. The index into `output-kinds`, which offers the first four: there is one Link,
  /// always in the list, and nothing can be switched to it or from it.
  kind-index: int,
  /// OSC and Art-Net: where to send it, in two boxes because they are two facts and one of
  /// them has a sane default (9000, or Art-Net's own 6454) while the other does not.
  host: string,
  port: string,
  /// MIDI and MIDI clock: which device, as an index into `output-devices` — 0 being that list's own
  /// "not chosen yet" label. A name would be the same trap the single address box was.
  device-index: int,
  /// "127.0.0.1:7000", "midi Some Device" or "link" — `output::formatOutputAddress`. Not shown any
  /// more; kept because it is still the one string that says the whole destination, which is
  /// what a settings file holds and what a pasted rig arrives as.
  address: string,
  /// §5.6's per-target enabled state. Off sends nothing and keeps the address.
  enabled: bool,
  /// Why this output is reaching nothing, while that is so — a host that will not resolve, a
  /// MIDI device that is not here or that another program holds, sends that are failing — or
  /// empty. Shown under the row in the alarm colour, for as long as it is true: the status
  /// line said it once and the next message wrote it away.
  problem: string,
  /// How long everything to this target is held back, in milliseconds — `OutputTarget::
  /// delaySeconds`. Milliseconds here rather than seconds because that is what the slider
  /// moves in and what the row reads out; the C++ side owns the conversion.
  delay-ms: float,
}

/// One Link peer as SHOW PEERS lists it: what the peer announces on the network.
export struct LinkPeer {
  /// Where it is, as it announced itself: "192.168.1.20".
  address: string,
  /// The tempo it is at: "128.00 BPM".
  tempo: string,
  /// Whether it is in takt4's session — following the same timeline — or a session of its own.
  same-session: bool,
  /// "playing", "stopped", or empty for a peer that does not share start and stop.
  transport: string,
}

/// A small label beside a control: "port", "action", "audio in".
component Label inherits Text {
  color: Wf.ink2;
  font-family: Wf.sans;
  font-size: 14px;
  vertical-alignment: center;
  horizontal-stretch: 0;
}

/// A line saying why something is not working, for as long as it is not, under the row it is
/// about — a port that will not open, a host that will not resolve. The status line says each
/// once, and the next thing it says writes it away (2026-09-28: *"it should say so in the UI so
/// it doesn't just silently fail"*).
component Alarm inherits Text {
  color: Wf.alarm;
  font-family: Wf.sans;
  font-size: 13px;
  vertical-alignment: center;
  overflow: elide;
}

export component MainWindow inherits Window {
  title: root.version == "" ? "takt4" : "takt4 " + root.version;
  // 800 wide (HANDOFF §0.5), and no narrower: every row in the outputs table is laid out for it,
  // and every box and dropdown in it reads whole at it. `kMainWindowWidth` opens it there.
  preferred-width: 800px;
  preferred-height: 934px;
  min-width: 800px;
  // The floor is what has to be *on screen*, not what the window holds: the body scrolls,
  // so everything below this height is reachable rather than lost. What is left at it is the
  // pinned triggers row and status bar, the top bar, and some scrollable body between them.
  min-height: 420px;
  background: Wf.page;
  default-font-family: Wf.sans;
  default-font-size: 15px;
  default-font-weight: 500;
  init => {
    // Nothing in this window is a std widget any more, but the About box is, and it takes the
    // scheme from here.
    Palette.color-scheme = ColorScheme.dark;
  }

  // Everything below is written by the C++ side and read by nothing else — `in` would
  // say that better. They are `in-out` because Slint generates a getter only for those,
  // and without one `takt4_ui_tests` could set a property but never check what the
  // window made of it.
  //
  // --- the input, chosen ---------------------------------------------------------
  in-out property <[string]> devices;
  in-out property <[string]> channels;
  in-out property <int> device-index;
  in-out property <int> channel-index;
  /// One input rather than a stereo pair — see `mono-check`. `channels` lists single inputs
  /// when this is true and pairs when it is not.
  in-out property <bool> input-mono;
  in-out property <bool> running;
  /// The input has stopped delivering audio, or is being reopened after it did — the audit's
  /// C4. While this is true the readouts are the last ones before the audio stopped, and the
  /// lock readout says "no audio" rather than "locked" at a tempo nothing is producing any more.
  in-out property <bool> input-lost;
  /// What went missing between the input and the beats — "3 input overflows", "12 hops
  /// dropped — the model fell behind the audio" — or empty. Shown under the meter, because a
  /// device dropping input, or a machine too busy to keep up, is otherwise visible nowhere.
  in-out property <string> input-trouble;
  /// Look for input devices and MIDI ports again: an interface switched on after takt4
  /// started, a controller plugged in later. Only while stopped.
  callback rescan-clicked();

  // --- what the tracker says -----------------------------------------------------
  in-out property <float> bpm;
  in-out property <bool> locked;
  /// The operator is holding the lock up; see TempoTracker::setLockPinned.
  in-out property <bool> pinned;
  in-out property <bool> holding;
  /// The tempo is read from the spacing of the beats themselves (`refineNeedsBeats` gaps are
  /// in), rather than from the filter's tempo interval.
  in-out property <bool> refined;
  in-out property <float> confidence;
  in-out property <int> beats-per-bar;
  in-out property <int> beat-in-bar;
  in-out property <int> bars;
  /// How many of the filter's beats go to one published beat — `TempoState::beatDivisor`.
  /// One while the tempo below has been halved is the state worth seeing: the readout has
  /// moved and the beats have not.
  in-out property <int> beat-divisor: 1;

  // --- §5.5's octave fold, made visible (§7 deviation 4) and settable -------------
  in-out property <bool> fold-on;
  in-out property <float> fold-min;
  in-out property <float> fold-max;
  in-out property <float> raw-bpm;
  /// The rate the filter is calling beats at — `TempoState::calledBpm`, which is `raw-bpm`
  /// unless the filter is contradicting itself. What the fold worked on, so what the
  /// "halved from" note compares against: a cloud at 214 calling beats at 107 under
  /// a 70-140 window has been folded from 107 to 107, which is nothing, and saying "halved
  /// from 214 — beats still at 214" of it would be wrong twice.
  in-out property <float> called-bpm;

  // §5.5's latency offset: "one slider in milliseconds, applied to beat event
  // timestamps so events fire early enough". Negative is the useful direction.
  in-out property <float> latency-ms;

  /// Whether a ÷2 or ×2 carries on into the next track — `TempoTracker::Options::
  /// keepOctaveShift`. Off by default: the next record is dropped back to the tempo the
  /// tracker hears.
  in-out property <bool> keep-shift;

  // Taps in the set being counted in and taps needed before a tempo is offered, so
  // the TAP button can say that a press registered. 0 when no set is in progress.
  in-out property <int> tap-count;
  in-out property <int> tap-needs;
  /// A downbeat snap posted and not yet landed. See the DOWNBEAT button.
  in-out property <bool> snap-pending;

  // How far the settings can be dragged. The values here are only a sane starting point for
  // a preview: the C++ side sets all of them at startup from the constants it also clamps
  // against (ui/window_state.hpp), so a slider can never offer a value the controller would
  // refuse.
  in-out property <float> fold-limit-min: 40;
  in-out property <float> fold-limit-max: 220;
  in-out property <float> fold-least-span: 5;
  in-out property <float> latency-limit-ms: 250;
  /// How far a single output's delay slider goes, in milliseconds — `kMaxOutputDelaySeconds`.
  in-out property <float> output-delay-limit-ms: 1000;

  // --- the two displays that carry the window ------------------------------------
  in-out property <[TracePoint]> trace;
  in-out property <float> input-level;   // 0 to 1, mapped from dBFS by the caller
  in-out property <float> input-peak;
  in-out property <string> input-reading;

  // --- §5.9's outputs --------------------------------------------------------------
  // What is being sent, and what it is being sent to. Each row's tick box is what the
  // operator asked for; `link-peers` and `beats-sent` are what actually happened, which is
  // the difference between a tick box and a working rig.
  in-out property <int> link-peers;
  /// Whether the Link row's list of peers is open under it, and what is in it.
  in-out property <bool> link-peers-shown;
  in-out property <[LinkPeer]> link-peer-list;
  callback link-peers-toggled();

  /// §5.6's targets, one row each, Link's first.
  in-out property <[OutputRow]> outputs-list;
  /// How many of them are switched on, and how many are reaching nothing — for the line the
  /// Outputs heading reads while the section is folded, which cannot count a model itself.
  in-out property <int> outputs-on;
  in-out property <int> outputs-failing;
  /// What kinds of target there are, in `output::OutputTarget::Kind` order.
  in-out property <[string]> output-kinds;
  /// Every MIDI output on this machine, with a "pick one" label at index 0 — what a MIDI or
  /// MIDI clock row's device dropdown offers. Picked by index, never by name.
  in-out property <[string]> output-devices;
  in-out property <int> beats-sent;
  /// What has gone wrong on the way out that nothing else on screen says — "3 rule messages
  /// reached no output", "12 MIDI clock ticks skipped" — or empty (the audit's M12). Shown
  /// under the outputs heading, for the reason `input-trouble` is under the meter.
  in-out property <string> output-trouble;

  // --- §5.7's control input --------------------------------------------------------
  // What drives the app from outside it. The port is a fact about this desk and lives in
  // machine settings; the bindings are *learned* rather than typed, because nobody knows
  // what their controller's pad 3 sends and a box asking for a note number is a worse
  // question than "press it now".
  in-out property <[string]> midi-in-ports;
  /// Which of them, as an index — 0 being that list's own "select input" label.
  in-out property <int> midi-in-port-index;
  in-out property <bool> control-on;
  /// One per ControlAction, in kControlActions order, as labelOf() writes them.
  in-out property <[string]> learn-actions;
  in-out property <int> learn-action-index;
  in-out property <bool> learning;
  /// What the selected action is bound to, or what just arrived unbound. The second is
  /// what tells an operator their controller is on a channel nothing is listening to,
  /// which otherwise looks exactly like a broken cable.
  in-out property <string> control-reading;
  /// The reading is a state in words — "not bound", "off — pick a port" — rather than a control
  /// ("note 36 ch 10"), so it is set in Archivo, as every other state in the window is, and not in
  /// DM Mono, which is for numbers and addresses (the operator, 2026-09-30: "off" in DM Mono
  /// "looks weird").
  in-out property <bool> control-reading-words;
  /// The reading is saying why the port picked is not open — not on the machine, or another
  /// program has it — rather than what arrived. Drawn in the alarm colour on a line of its own.
  in-out property <bool> control-error;

  callback midi-in-picked(int);
  callback learn-action-picked(int);
  /// Arms learn mode for the selected action, or disarms it when it already is.
  callback learn-clicked();
  callback forget-clicked();

  /// §5.7's other surface: a listening UDP socket, so a Stream Deck or Bitfocus Companion
  /// can drive this without touching the laptop. Off until asked — OSC carries no
  /// authentication and takt4 invents none, so opening the socket, and opening it past
  /// loopback, are two separate decisions and both are the operator's.
  in-out property <bool> osc-control-on;
  /// The port actually bound, as text, or what has been typed while it is off. Not always
  /// the port that was asked for: 0 means "any free one" and the operator needs the real
  /// number to point a surface at.
  in-out property <string> osc-control-port;
  in-out property <bool> osc-control-network;
  /// The last address that arrived — or, with nothing arriving, the state: "off", the address
  /// to aim at, or why it is not listening. What tells an operator their surface is aimed at
  /// the wrong prefix, which otherwise looks like a dead cable.
  in-out property <string> osc-control-reading;
  /// The reading is "off", a word and not an address: set in Archivo (see `control-reading-words`).
  in-out property <bool> osc-control-reading-words;
  /// Where the last one came from ("from 192.168.1.40"), and under both how many were acted on
  /// and how many ignored — a wrong prefix and a dead cable need different fixes. Empty until
  /// something has arrived.
  in-out property <string> osc-control-from;
  in-out property <string> osc-control-counts;
  /// Listening was asked for and the port would not bind: the reading says why, and that it is
  /// being tried again. The tick stays ticked — it is what was asked for, and what is saved.
  in-out property <bool> osc-control-error;

  callback osc-control-toggled(bool);
  callback osc-control-port-edited(string);
  callback osc-control-network-toggled(bool);

  /// §5.9's TRIGGERS row. The editor is a window of its own (rules_window.slint), so what
  /// belongs here is only what an operator needs while watching the tracker: how many rules
  /// are armed, what just fired, and PANIC — which has to be reachable without opening
  /// anything, because it is pressed in a hurry.
  in-out property <int> rules-active;
  in-out property <int> rules-total;
  in-out property <string> rules-last-fired;
  in-out property <bool> panicked;

  callback rules-clicked();
  /// ABOUT in the status line: the licence, the source and the notices.
  callback about-opened();
  /// How many fixtures are patched, for the button that opens the patch editor. Zero is a rig
  /// with no lights on it, and the button says "patch lights" rather than "0 fixtures".
  in-out property <int> fixtures-total;
  callback fixtures-clicked();
  callback panic-clicked();

  in-out property <string> status;
  in-out property <bool> status-is-error;

  // What this build is, kept where it cannot be scrolled or overwritten: the title bar and
  // the corner of the status bar.
  in-out property <string> version;
  /// The same, short, for the status bar's corner, always on two lines (the operator, 2026-09-29):
  /// the version, and under it "release" or "dev". A dev build's full label — "0.9.9
  /// (v0.9.9-1-g16611d86d-dirty)", 257 px — left the status line 215 px, and neither of its lines
  /// fits that (measured); it is in the title bar and the About box.
  in-out property <string> version-short;

  callback device-picked(int);
  callback channel-picked(int);
  callback input-mono-toggled(bool);
  callback toggle-run();
  /// START or STOP has been pressed and is being carried out, or has only just been — an ASIO
  /// driver can take seconds to open, and the window cannot draw while it does (the audit's
  /// M23). The button takes no press until it is over.
  in-out property <bool> run-busy;
  /// What the button says while the press is being carried out — "OPENING…", "STOPPING…" —
  /// or empty once it has been.
  in-out property <string> run-busy-text;

  // §5.5's manual half. Each one is a `post` on the engine's control queue; none of
  // them touches the tracker from this thread.
  callback halve();
  callback redouble();
  callback tap();
  callback snap-downbeat();
  /// Fires every rule whose trigger is "manual hotkey" — the M key. The same thing
  /// `/ctl/manual` and a learned MIDI pad do.
  callback manual-fired();
  /// The state being asked for, not a toggle: the button already shows the current one,
  /// and sending the intention is what makes two quick presses land as two changes.
  callback pin-changed(bool);
  callback fold-on-changed(bool);
  callback fold-min-changed(float);
  callback fold-max-changed(float);
  callback latency-changed(float);
  /// A number typed into the latency reading, as typed — see `Reading`. The C++ side reads
  /// it, clamps it and moves the slider.
  callback latency-typed(string);
  /// The new state of the "keep for the next track" box, not a flip.
  callback keep-shift-changed(bool);

  /// A keystroke in one box of row N: remembered, not applied. Applying opens and closes a
  /// socket, and doing that once per character would rebuild it halfway through an address.
  /// The `-accepted` half is the edit finished — Enter, a click away, or Escape.
  callback output-name-edited(int, string);
  callback output-name-accepted(int, string);
  callback output-host-edited(int, string);
  callback output-host-accepted(int, string);
  callback output-port-edited(int, string);
  callback output-port-accepted(int, string);
  callback output-added();

  /// Write the settings now rather than on the way out, and the two file-picker routes
  /// beside it. See `WindowController::saveNow` for why a button had to exist.
  callback save-now();
  callback export-settings();
  callback import-settings();
  callback output-removed(int);
  callback output-enabled-changed(int, bool);
  /// Row N is an OSC target or a MIDI one. Applied at once, like the tick and unlike the
  /// text boxes: it changes which question the row is asking, so nothing is half-typed yet.
  callback output-kind-changed(int, int);
  /// Row N's MIDI device, as an index into `output-devices`. Applied at once for the same
  /// reason: it is a pick from a list, so there is nothing to wait for Enter about.
  callback output-device-picked(int, int);
  /// Row N's delay slider, in milliseconds. Applied as it moves, like the enabled tick and
  /// unlike the two text boxes: dragging it is how an operator finds the offset by ear.
  callback output-delay-changed(int, float);
  /// A number typed into row N's delay reading, as typed — the same as `latency-typed`.
  callback output-delay-typed(int, string);

  /// PANIC let go of — the RELEASE button beside PANIC, which is the only way back. See
  /// `panic-clicked`, which only ever engages.
  callback panic-released();

  // --- folding (HANDOFF §0.5) --------------------------------------------------------
  /// Inputs and Outputs fold down to their heading. Both start open. A fold takes the section's
  /// height off the *window* and the trace keeps its height, so the C++ side resizes the window
  /// on each fold and unfold — `fold-clicked` is the arrow, and the controller sets these.
  in-out property <bool> inputs-folded;
  in-out property <bool> outputs-folded;
  /// 0 is Inputs, 1 is Outputs.
  callback fold-clicked(int);
  /// What the controller needs to size the window round a fold, read straight after it sets one
  /// of the two above (a layout is worked out when it is read): the least height the scrolling
  /// part's content can have; the height of what is pinned below it; the lowest folded
  /// heading's bottom edge, in the content's own coordinates, which must stay on screen so the
  /// arrow that opens it again can be reached; and the height the window is laid out at now.
  ///
  /// `fold-keep` is where that edge is with the content at its *least* height — Outputs is the
  /// content's last sheet, with nothing under it. Not the sheets' `y`: in a window taller than
  /// the content the trace takes what is spare, which pushes every sheet below it to the window's
  /// bottom, so the heading's `y` said the window could not shrink at all.
  out property <length> content-least: content.min-height;
  out property <length> pinned-height: pinned.min-height;
  out property <length> fold-keep: root.outputs-folded ? content.min-height
    : root.inputs-folded ? content.min-height - outputs-sheet.min-height - content.spacing : 0px;
  out property <length> shown-width: root.width;
  out property <length> shown-height: root.height;

  // The keyboard's resting place, so a shortcut works the moment the window opens.
  forward-focus: keys;

  // **The keyboard shortcuts** — the audit's H18. HANDOFF calls PANIC by keyboard
  // "non-negotiable for live use".
  //
  // A key reaches this by bubbling up from whatever holds the focus, which is why everything
  // in the window is inside it and why nothing here ever leaves the focus nowhere (see
  // `FocusSink`). Printable keys are taken by a text box before they get this far, so T and D
  // cannot fire while somebody types a name; Escape is taken by the box too, and by an open
  // list, so Escape there leaves the box or closes the list and panics nothing.
  //
  // A held key repeats; only its first press counts. TAP from a key held down would otherwise
  // tap at the keyboard's repeat rate — 30 a second — and seed an absurd tempo.
  keys := FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;

    key-pressed(event) => {
      if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
        return reject;
      }
      if (event.text == Key.Escape) {
        if (!event.repeat) {
          root.panic-clicked();
        }
        return accept;
      }
      // TAP and DOWNBEAT only while running, exactly like their buttons: each corrects a
      // tempo or a bar that is being tracked now.
      if (event.text == "t" || event.text == "T") {
        if (root.running && !event.repeat) {
          root.tap();
        }
        return accept;
      }
      if (event.text == "d" || event.text == "D") {
        if (root.running && !event.repeat) {
          root.snap-downbeat();
        }
        return accept;
      }
      // The "manual hotkey" trigger's hotkey (the audit's M7). Whether or not the tracker is
      // running: the outputs are, and a manual cue is the operator's own.
      if (event.text == "m" || event.text == "M") {
        if (!event.repeat) {
          root.manual-fired();
        }
        return accept;
      }
      return reject;
    }

    // **Somewhere for a click on nothing to go.** A text box in this window commits when it
    // loses the keyboard, and a click on a heading, a sheet or the page between them used to
    // move the focus nowhere — so the box stayed lit and what was typed stayed uncommitted.
    // First in the window, so it is *behind* everything: a click any real control wants is
    // taken by that control and never reaches here.
    TouchArea {
      clicked => {
        keys.focus();
      }
    }

    VerticalLayout {
      padding: 0;
      spacing: 0;

      // Everything above the triggers row scrolls. The window opens at 934 px with a scroll bar
      // rather than sized to its content (HANDOFF §0.5); when it is taller than the content, the
      // trace takes what is spare.
      body := Scroller {
        vertical-stretch: 1;

        content := VerticalLayout {
          padding-left: 10px;
          padding-right: 10px;
          padding-top: 10px;
          padding-bottom: 0px;
          spacing: 10px;

          // --- what we are listening to ------------------------------------------------
          Rectangle {
            background: Wf.sheet;
            vertical-stretch: 0;

            HorizontalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: 12px;
              padding-bottom: 12px;
              spacing: 10px;

              // Labelled above rather than beside, so the pickers keep the width (HANDOFF §0.5).
              VerticalLayout {
                spacing: 3px;
                horizontal-stretch: 1.25;
                Label {
                  text: "audio in";
                  font-size: 13px;
                  height: 16px;
                }
                device-picker := Pick {
                  model: root.devices;
                  current-index: root.device-index;
                  locked: root.running;
                  selected(index) => {
                    root.device-index = index;
                    root.device-picked(index);
                  }
                }
              }

              VerticalLayout {
                spacing: 3px;
                horizontal-stretch: 1;
                Label {
                  text: "channels";
                  font-size: 13px;
                  height: 16px;
                }
                channel-picker := Pick {
                  model: root.channels;
                  current-index: root.channel-index;
                  locked: root.running;
                  selected(index) => {
                    root.channel-index = index;
                    root.channel-picked(index);
                  }
                }
              }

              // **Stereo unless asked otherwise** (2026-09-28): the picker offers pairs of
              // inputs — 1 + 2, 11 + 12 — heard as the average of the two. Ticked, it offers
              // single inputs, for a feed that really is on one of them.
              VerticalLayout {
                alignment: end;
                horizontal-stretch: 0;
                mono-check := Tick {
                  text: "mono";
                  checked: root.input-mono;
                  locked: root.running;
                  height: 34px;
                  horizontal-stretch: 0;
                  toggled(on) => {
                    root.input-mono = on;
                    root.input-mono-toggled(on);
                  }
                }
              }

              // RESCAN could only ever be pressed while stopped; while running, the note in its
              // place says why everything to its left is locked (HANDOFF §0.5). One width for
              // both, so STOP does not move when it is pressed.
              Rectangle {
                horizontal-stretch: 0;
                min-width: max(note-width.preferred-width + 8px, rescan-width.preferred-width + 36px);
                note-width := Text {
                  visible: false;
                  text: "stop to change";
                  font-size: 14px;
                }
                rescan-width := Text {
                  visible: false;
                  text: "rescan";
                  font-size: 19px;
                  font-weight: 700;
                }
                if root.running: Label {
                  x: 4px;
                  y: parent.height - 34px;
                  height: 34px;
                  text: "stop to change";
                }
                if !root.running: Btn {
                  x: 0;
                  y: parent.height - 17px - self.height / 2;
                  width: parent.width;
                  height: 40px;
                  text: "rescan";
                  font-size: 19px;
                  pad: 16px;
                  clicked => {
                    root.rescan-clicked();
                  }
                }
              }

              Rectangle {
                horizontal-stretch: 0;
                min-width: max(78px, run-button.preferred-width);
                run-button := Btn {
                  x: 0;
                  y: parent.height - 17px - self.height / 2;
                  width: parent.width;
                  height: 40px;
                  text: root.run-busy-text != "" ? root.run-busy-text.to-lowercase()
                    : root.running ? "stop" : "start";
                  primary: !root.running;
                  enabled: root.devices.length > 0 && !root.run-busy;
                  font-size: 19px;
                  pad: 16px;
                  clicked => {
                    root.toggle-run();
                  }
                }
              }
            }
          }

          // --- the tempo ---------------------------------------------------------------
          // A black sheet with a faint paper grid behind the number: the one thing read from
          // across the room. Two halves, placed by hand: the tempo and where it comes from on
          // the left; the confidence, the lock and the bar from the middle of the sheet.
          // Baselines where the approved render has them (measured: the digits' ink runs 16 to
          // 62 px down a 98 px sheet).
          tempo-sheet := Rectangle {
            height: 98px;
            vertical-stretch: 0;
            background: Wf.tempo-sheet;
            clip: true;

            // The two halves of the sheet inside its 22 px padding, and where the right one starts.
            property <length> half: (self.width - 44px) / 2;
            property <length> right-x: 22px + self.half;
            // Whether the fold moved the number: see the line under the tempo.
            property <bool> folded-note: root.fold-on && root.called-bpm > 0 && root.bpm > 0
              && (root.called-bpm > root.bpm * 1.5 || root.called-bpm < root.bpm * 0.67);
            // "no audio" before anything else: with the input dead the tracker is frozen on its
            // last state, and "locked" at that tempo was the window lying about a rig that had
            // stopped hearing the music.
            property <color> state-color: !root.running ? Wf.tempo-ink2
              : root.input-lost ? Wf.alarm
              : root.holding ? Wf.holding
              : root.locked ? Wf.locked
              : Wf.tempo-ink2;

            // The paper: a 10 px grid, and a 50 px one over it.
            for i in ceil(self.width / 10px): Rectangle {
              x: i * 10px;
              width: 1px;
              height: parent.height;
              background: Wf.paper-fine;
            }
            for i in ceil(self.height / 10px): Rectangle {
              y: i * 10px;
              width: parent.width;
              height: 1px;
              background: Wf.paper-fine;
            }
            for i in ceil(self.width / 50px): Rectangle {
              x: i * 50px;
              width: 1px;
              height: parent.height;
              background: Wf.paper-coarse;
            }
            for i in ceil(self.height / 50px): Rectangle {
              y: i * 50px;
              width: parent.width;
              height: 1px;
              background: Wf.paper-coarse;
            }

            digits := Text {
              x: 22px;
              y: 62px - self.font-metrics.ascent;
              // Two decimals, always: the refined tempo resolves to a fraction of a BPM, and a
              // reading whose length changed as it moved would shift everything after it. With no
              // tempo, a dash — an en dash: at 62 px an em dash is a slab, and "--" two of them.
              text: root.bpm > 0 ? root.bpm.to-fixed(2) : "–";
              color: root.bpm > 0 ? Wf.tempo-ink : Wf.tempo-ink2;
              font-family: Wf.sans;
              font-size: 62px;
              font-weight: 800;
              letter-spacing: -2.48px;
            }

            Text {
              x: digits.x + digits.width + 8px;
              y: 62px - self.font-metrics.ascent;
              text: "bpm";
              color: Wf.tempo-ink2;
              font-family: Wf.sans;
              font-size: 14px;
              font-weight: 800;
            }

            // Where the number comes from: before `refineNeedsBeats` beat gaps are in, the
            // filter's tempo interval, which steps in whole frames; after, the spacing of the
            // beats themselves.
            if !tempo-sheet.folded-note && root.bpm > 0: Rectangle {
              x: 22px;
              y: 84px - truth-key.font-metrics.ascent;
              width: truth-key.width + 4px + truth-value.width;
              height: truth-key.height;
              truth-key := Text {
                x: 0;
                y: 0;
                text: "truth source:";
                color: Wf.tempo-ink2;
                font-family: Wf.sans;
                font-size: 13px;
              }
              truth-value := Text {
                x: truth-key.width + 4px;
                y: 0;
                text: root.refined ? "beat spacing" : "tempo filter";
                color: Wf.tempo-ink;
                font-family: Wf.sans;
                font-size: 13px;
              }
            }

            // **Unless the fold moved it**, which is then the thing to know about the number, and
            // takes that line (the banner has no room for a second one): §7 deviation 4 — the fold
            // window is measured to help inside it and to fail hard outside it, so an operator has
            // to be able to see it act. Only when it actually moved the number, and the test is the
            // ratio, not the difference: a fold is a halving or a doubling, and the tenth of a BPM
            // between the filter's interval and the refined tempo is not one.
            //
            // **And whether the beats came with it.** Halving the number without halving the grid
            // is a real state — see `TempoState::beatDivisor` — and the one thing here that is
            // otherwise invisible: the readout says 92 and every output fires at 184. Against
            // `called-bpm`, the grid the filter is calling beats on, not `raw-bpm`, its cloud.
            if tempo-sheet.folded-note: Text {
              x: 22px;
              y: 84px - self.font-metrics.ascent;
              width: tempo-sheet.half - 8px;
              text: (root.called-bpm > root.bpm ? "halved from " : "doubled from ")
                + root.called-bpm.to-fixed(1) + " BPM"
                + (root.called-bpm > root.bpm && root.beat-divisor <= 1
                   ? " — beats still at " + round(root.called-bpm) : "");
              color: Wf.holding;
              font-family: Wf.sans;
              font-size: 13px;
              overflow: elide;
            }

            // The right half: confidence and the lock, the meter, the bar.
            Text {
              x: tempo-sheet.right-x;
              y: 27px - self.font-metrics.ascent;
              text: "confidence";
              color: Wf.tempo-ink;
              font-family: Wf.sans;
              font-size: 14px;
              font-weight: 700;
            }

            lock-state := Text {
              x: tempo-sheet.right-x + tempo-sheet.half - self.width;
              y: 27px - self.font-metrics.ascent;
              text: !root.running ? "stopped"
                : root.input-lost ? "no audio"
                : root.holding ? "holding"
                : root.locked ? "locked"
                : "hunting";
              color: tempo-sheet.state-color;
              font-family: Wf.sans;
              font-size: 15px;
              font-weight: 800;
            }
            // The dot: a circle drawn, since neither face has a "●".
            Rectangle {
              x: lock-state.x - 8px - self.width;
              y: 27px - 0.36 * 15px - self.height / 2;
              width: 10px;
              height: 10px;
              border-radius: 5px;
              background: tempo-sheet.state-color;
            }

            Meter {
              x: tempo-sheet.right-x;
              y: 41px;
              width: tempo-sheet.half - 64px;
              height: 9px;
              value: root.confidence;
              track: Wf.tempo-meter-track;
              // §5.5's confidence gate: below it the tempo is the last good one being held,
              // not a fresh reading, and the colour says so.
              fill: root.holding ? Wf.holding : Wf.tempo-ink;
            }
            Text {
              x: tempo-sheet.right-x + tempo-sheet.half - 52px;
              y: 51px - self.font-metrics.ascent;
              width: 52px;
              text: root.confidence.to-fixed(2);
              color: Wf.tempo-ink;
              font-family: Wf.mono;
              font-size: 14px;
              horizontal-alignment: right;
            }

            // The bar indicator: however many beats the tracker reports — three, four, five,
            // seven. §5.5: nothing here hardcodes four. The current beat a red disc, the
            // downbeat's circle off-white.
            for beat in root.beats-per-bar: Rectangle {
              x: tempo-sheet.right-x + beat * 34px;
              y: 62px;
              width: 24px;
              height: 24px;
              border-radius: 12px;
              border-width: 1.5px;
              border-color: beat + 1 == root.beat-in-bar ? Wf.beat-disc
                : beat == 0 ? Wf.tempo-ink : Wf.beat-edge;
              background: beat + 1 == root.beat-in-bar ? Wf.beat-disc : transparent;

              Text {
                text: beat + 1;
                color: beat + 1 == root.beat-in-bar ? #ffffff : Wf.ink;
                font-family: Wf.sans;
                font-size: 13px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
              }
            }
            meter-text := Text {
              x: tempo-sheet.right-x + max(0, root.beats-per-bar) * 34px - 2px;
              y: 74px + 0.36 * 15px - self.font-metrics.ascent;
              text: root.beats-per-bar > 0 ? root.beats-per-bar + "/4" : "";
              color: root.beats-per-bar > 0 ? Wf.tempo-ink : Wf.tempo-ink2;
              font-family: Wf.sans;
              font-size: 15px;
              font-weight: 800;
            }
            Text {
              x: meter-text.x + meter-text.width + 10px;
              y: 74px + 0.36 * 15px - self.font-metrics.ascent;
              text: root.bars > 0 ? "bar " + root.bars : "";
              color: Wf.tempo-ink2;
              font-family: Wf.sans;
              font-size: 13px;
            }
          }

          // --- 01 activation -----------------------------------------------------------
          // The trace is the one thing here worth more when it is bigger, so when the window is
          // taller than what it holds, this takes the height that is spare.
          Rectangle {
            background: Wf.sheet;
            vertical-stretch: 1;

            VerticalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: 8px;
              padding-bottom: 8px;
              spacing: 0px;

              HorizontalLayout {
                height: 24px;
                spacing: 16px;
                SectionHead {
                  number: "01";
                  title: "activation";
                  horizontal-stretch: 1;
                }
                // The plot never had a key.
                for item in [
                  { label: "beat likelihood", swatch: Wf.plot-bar, tall: true },
                  { label: "beat called", swatch: Wf.fill, tall: true },
                  { label: "downbeat likelihood", swatch: Wf.red, tall: false },
                ]: HorizontalLayout {
                  spacing: 6px;
                  horizontal-stretch: 0;
                  alignment: end;
                  Rectangle {
                    width: 12px;
                    Rectangle {
                      y: (parent.height - self.height) / 2 + 1px;
                      height: item.tall ? 12px : 3px;
                      background: item.swatch;
                    }
                  }
                  Text {
                    text: item.label;
                    color: Wf.ink2;
                    font-size: 13px;
                    vertical-alignment: center;
                  }
                }
              }

              Rectangle { height: 14px; }

              // One column per 50 Hz frame, oldest at the left: P(beat) from the bottom, lit
              // off-white on the frames the filter called a beat — the difference between the
              // network seeing something and the filter agreeing — and P(downbeat) as a red mark
              // at its own height, the weakest signal in the chain (56.51 F1, §A.1).
              plot := Rectangle {
                min-height: 72px;
                vertical-stretch: 1;
                background: Wf.plot;
                clip: true;

                property <length> field: self.height - 2px;

                for q in 4: Rectangle {
                  y: q * parent.field / 4;
                  height: 1px;
                  background: Wf.plot-grid;
                }

                for point[i] in root.trace: Rectangle {
                  x: i * parent.width / root.trace.length;
                  width: parent.width / root.trace.length + 0.02px;
                  height: parent.field;
                  y: 0;

                  if point.beat > 0.005: Rectangle {
                    y: parent.height - self.height;
                    height: parent.height * clamp(point.beat, 0.0, 1.0);
                    background: point.called ? Wf.fill : Wf.plot-bar;
                  }
                  if point.downbeat > 0.02: Rectangle {
                    y: (parent.height - 3px) * (1.0 - clamp(point.downbeat, 0.0, 1.0));
                    height: 3px;
                    background: Wf.red;
                  }
                }

                // The baseline, off-white, under everything.
                Rectangle {
                  y: parent.height - 2px;
                  height: 2px;
                  background: Wf.fill;
                }
              }

              Rectangle { height: 6px; }

              HorizontalLayout {
                height: 18px;
                spacing: 12px;
                Text {
                  text: "input";
                  width: 64px;
                  color: Wf.ink;
                  font-size: 14px;
                  font-weight: 700;
                  vertical-alignment: center;
                }
                VerticalLayout {
                  alignment: center;
                  Meter {
                    value: root.input-level;
                    // Peaking is the one thing an input meter must not be quiet about.
                    fill: root.input-peak >= 0.99 ? Wf.holding : Wf.fill;
                  }
                }
                Text {
                  text: root.input-reading;
                  width: 80px;
                  color: Wf.ink;
                  font-family: Wf.mono;
                  font-size: 14px;
                  horizontal-alignment: right;
                  vertical-alignment: center;
                }
              }

              // The input's own complaints, under the meter they are about. An explicit height,
              // because an `if` row in a vertical layout otherwise takes a share of the spare
              // height — measured: `vertical-stretch: 0` does not stop it.
              if root.input-trouble != "": Text {
                height: 20px;
                text: root.input-trouble;
                color: Wf.holding;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: bottom;
                overflow: elide;
              }
            }
          }

          // --- the controls ------------------------------------------------------------
          // ÷2, ×2, TAP, LOCK and DOWNBEAT, live only while the tracker runs: each corrects a
          // tempo or a bar phase being tracked *now*. Under them the settings, live whether or
          // not anything is running: the fold window as one slider with two handles, and the
          // rig's latency.
          Rectangle {
            background: Wf.sheet;
            vertical-stretch: 0;

            VerticalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: 10px;
              padding-bottom: 10px;
              spacing: 10px;

              HorizontalLayout {
                height: 32px;
                spacing: 10px;

                // 18 px so the ÷ does not read as + (HANDOFF §0.5).
                Btn {
                  text: "÷2";
                  font-size: 18px;
                  enabled: root.running;
                  clicked => {
                    root.halve();
                  }
                }
                Btn {
                  text: "×2";
                  font-size: 18px;
                  enabled: root.running;
                  clicked => {
                    root.redouble();
                  }
                }
                // Counts the operator in: three taps before there is a tempo, and a press that
                // registered has to look different from one that did not.
                Btn {
                  text: root.tap-count > 0 ? "tap " + root.tap-count + "/" + root.tap-needs : "tap";
                  hint: "T";
                  enabled: root.running;
                  clicked => {
                    root.tap();
                  }
                }
                // §5.7's lock, pinned rather than set: the tracker goes on tracking and simply
                // is not allowed to let go of the tempo. Lit while held.
                Btn {
                  text: "lock";
                  active: root.pinned;
                  enabled: root.running;
                  clicked => {
                    root.pin-changed(!root.pinned);
                  }
                }
                // §5.5: "Big keyboard / MIDI / OSC downbeat now ... Non-negotiable". The one to
                // reach for, so filled; lit green from the press until the next beat, which is
                // when the correction reaches the outputs.
                Btn {
                  text: "downbeat";
                  hint: "D";
                  primary: root.running;
                  active: root.snap-pending;
                  enabled: root.running;
                  clicked => {
                    root.snap-downbeat();
                  }
                }

                Rectangle { width: 4px; }

                // What ÷2 and ×2 do when the record changes. A setting, so it is live while
                // stopped; the audit's H2, and the operator's call of 2026-09-23 that the default
                // is to drop a shift at the next track.
                keep-shift-box := Tick {
                  text: "keep half/double settings for next track";
                  box-size: 16px;
                  font-size: 14px;
                  checked: root.keep-shift;
                  toggled(keep) => {
                    root.keep-shift = keep;
                    root.keep-shift-changed(keep);
                  }
                }
              }

              HorizontalLayout {
                height: 24px;
                spacing: 12px;

                // **Not "octave fold"**, which nobody outside the code knows the meaning of: the
                // label says what the setting does to the number. Read with the reading beside it,
                // the row says "keep BPM in 70 to 140 BPM".
                Label {
                  text: "keep BPM in";
                  color: Wf.ink;
                }
                HorizontalLayout {
                  width: 20px;
                  alignment: center;
                  Tick {
                    box-size: 16px;
                    checked: root.fold-on;
                    toggled(on) => {
                      root.fold-on = on;
                      root.fold-on-changed(on);
                    }
                  }
                }
                // One slider with two handles: the two ends cannot cross, because `foldInto`
                // quietly returns the tempo unfolded when the window is inverted, which would look
                // like the fold having no effect rather than like a setting being wrong.
                SpanTrack {
                  low: root.fold-min;
                  high: root.fold-max;
                  minimum: root.fold-limit-min;
                  maximum: root.fold-limit-max;
                  least-span: root.fold-least-span;
                  step: 1;
                  enabled: root.fold-on;
                  low-moved(v) => {
                    root.fold-min = v;
                    root.fold-min-changed(v);
                  }
                  high-moved(v) => {
                    root.fold-max = v;
                    root.fold-max-changed(v);
                  }
                }
                Text {
                  text: round(root.fold-min) + " to " + round(root.fold-max) + " BPM";
                  color: root.fold-on ? Wf.ink : Wf.ink-off;
                  font-family: Wf.mono;
                  font-size: 14px;
                  vertical-alignment: center;
                  horizontal-stretch: 0;
                }
                VerticalLayout {
                  alignment: center;
                  Rectangle {
                    width: 1px;
                    height: 18px;
                    background: Wf.line;
                  }
                }
                Label {
                  text: "latency";
                  color: Wf.ink;
                }
                // The same cell as every output's delay below: the slider, 12 px, and a reading
                // with room for "-250 ms", right-justified. The sign is the whole point — negative
                // fires early — and it moves every output, on top of each output's own delay.
                HorizontalLayout {
                  width: 239px;
                  spacing: 12px;
                  Track {
                    value: root.latency-ms;
                    minimum: -root.latency-limit-ms;
                    maximum: root.latency-limit-ms;
                    step: 1;
                    moved(v) => {
                      root.latency-ms = v;
                      root.latency-changed(v);
                    }
                  }
                  Reading {
                    width: 59px;
                    align: left;
                    text: (root.latency-ms > 0 ? "+" : "") + round(root.latency-ms) + " ms";
                    value-text: round(root.latency-ms);
                    committed(text) => {
                      root.latency-typed(text);
                    }
                  }
                }
              }
            }
          }

          // --- 02 inputs ---------------------------------------------------------------
          // What is allowed to drive takt4 from outside: a box of buttons on this desk (MIDI) and
          // a socket anything on the network can reach (OSC). Learn mode carries the first: pick
          // the thing a button is for, press learn, then press the button.
          inputs-sheet := Rectangle {
            background: Wf.sheet;
            vertical-stretch: 0;

            // What the section holds, in one line, for its heading while it is folded — and in
            // the alarm colour when something in it is not working, which a fold must not hide.
            property <bool> failing: root.control-error || root.osc-control-error;
            property <string> summary: (root.control-error ? "MIDI: not open"
                : root.control-on && root.midi-in-port-index > 0 && root.midi-in-port-index < root.midi-in-ports.length
                  ? "MIDI: " + root.midi-in-ports[root.midi-in-port-index]
                : "MIDI: no port chosen")
              + " · "
              + (root.osc-control-error ? "OSC: not listening"
                : root.osc-control-on ? "OSC: listening on port " + root.osc-control-port
                : "OSC: off");

            VerticalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: root.inputs-folded ? 6px : 10px;
              padding-bottom: root.inputs-folded ? 6px : 12px;
              spacing: 0px;

              SectionHead {
                number: "02";
                title: "inputs";
                folds: true;
                folded: root.inputs-folded;
                summary: inputs-sheet.summary;
                summary-color: inputs-sheet.failing ? Wf.alarm : Wf.ink2;
                fold-clicked => {
                  root.fold-clicked(0);
                }
              }

              // **Folded, the body is clipped away, not removed.** A box being typed in commits a
              // turn of the event loop after it loses the keyboard — which the click on the arrow
              // takes — and an `if` would have destroyed it before then, and its edit with it.
              // Kept, it commits; clipped to nothing, nothing in it can be clicked.
              Rectangle {
                height: root.inputs-folded ? 0px : inputs-body.preferred-height;
                clip: true;
              inputs-body := VerticalLayout {
                y: 0;
                width: parent.width;
                padding-top: 18px;
                spacing: 10px;

                // MIDI: each control with its word beside it (the audit of 2026-09-25, L33): once
                // a port is picked the first dropdown shows a device's name and the second an
                // action's, and nothing said which was which.
                HorizontalLayout {
                  height: 34px;
                  spacing: 10px;
                  Text {
                    text: "MIDI";
                    width: 42px;
                    color: Wf.ink;
                    font-size: 18px;
                    font-weight: 800;
                    vertical-alignment: center;
                  }
                  Label { text: "port"; }
                  // Index 0 reads "select input" rather than being blank: a list nothing has been
                  // picked from, not an empty box somebody failed to fill in.
                  control-picker := Pick {
                    model: root.midi-in-ports;
                    current-index: root.midi-in-port-index;
                    min-width: 120px;
                    preferred-width: 190px;
                    max-width: 190px;
                    selected(index) => {
                      root.midi-in-port-index = index;
                      root.midi-in-picked(index);
                    }
                  }
                  Label { text: "action"; }
                  learn-picker := Pick {
                    model: root.learn-actions;
                    current-index: root.learn-action-index;
                    enabled: root.control-on;
                    min-width: 120px;
                    preferred-width: 190px;
                    max-width: 190px;
                    selected(index) => {
                      root.learn-action-index = index;
                      root.learn-action-picked(index);
                    }
                  }
                  // Lit green while armed, as a held LOCK is: both mean "this is waiting on you".
                  // Pressing it again gives up rather than stranding the operator in a mode.
                  learn-button := Btn {
                    text: root.learning ? "press it" : "learn";
                    active: root.learning;
                    enabled: root.control-on;
                    y: 1px;
                    clicked => {
                      root.learn-clicked();
                    }
                  }
                  forget-button := Btn {
                    text: "forget";
                    enabled: root.control-on;
                    y: 1px;
                    clicked => {
                      root.forget-clicked();
                    }
                  }
                  // What arrived, or what the picked action is bound to. Why the port is not open
                  // goes on a line of its own below.
                  Text {
                    text: root.control-error ? "" : root.control-reading;
                    color: Wf.ink;
                    font-family: root.control-reading-words ? Wf.sans : Wf.mono;
                    font-size: 14px;
                    horizontal-stretch: 0;
                    min-width: 40px;
                    vertical-alignment: center;
                    overflow: elide;
                  }
                  Rectangle { horizontal-stretch: 1; }
                }

                // **Why the port picked is not open, for as long as it is not** — a controller left
                // at home, or one another program holds — under the row it is about.
                if root.control-error: Alarm {
                  height: 18px;
                  text: root.control-reading;
                }

                // OSC: three separate decisions — listen at all, on which port, and whether past
                // this machine — and what is arriving, at the far right.
                HorizontalLayout {
                  height: 38px;
                  spacing: 10px;
                  Text {
                    text: "OSC";
                    width: 42px;
                    color: Wf.ink;
                    font-size: 18px;
                    font-weight: 800;
                    vertical-alignment: center;
                  }
                  osc-control-check := Tick {
                    text: "listen";
                    checked: root.osc-control-on;
                    horizontal-stretch: 0;
                    toggled(on) => {
                      root.osc-control-on = on;
                      root.osc-control-toggled(on);
                    }
                  }
                  Label { text: "port"; }
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    // A port is five characters. Committed when finished with — Enter, a click
                    // away — never a keystroke at a time, which would rebind the socket on every
                    // digit.
                    osc-control-port-field := Entry {
                      width: 70px;
                      value: root.osc-control-port;
                      placeholder: "port";
                      font-family: Wf.mono;
                      committed(text) => {
                        root.osc-control-port-edited(text);
                      }
                    }
                  }
                  // Spelled as what it *allows*, so the checked state is the permissive one: a
                  // negative box that is safe when ticked reads backwards in a hurry.
                  osc-control-network-check := Tick {
                    text: "allow other machines";
                    checked: root.osc-control-network;
                    horizontal-stretch: 0;
                    toggled(on) => {
                      root.osc-control-network = on;
                      root.osc-control-network-toggled(on);
                    }
                  }
                  VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 40px;
                    alignment: center;
                    HorizontalLayout {
                      height: 19px;
                      spacing: 8px;
                      alignment: end;
                      Text {
                        text: root.osc-control-error ? "" : root.osc-control-reading;
                        color: Wf.ink;
                        font-family: root.osc-control-reading-words ? Wf.sans : Wf.mono;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                      }
                      if !root.osc-control-error && root.osc-control-from != "": Text {
                        text: root.osc-control-from;
                        color: Wf.ink2;
                        font-family: Wf.mono;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                      }
                    }
                    if !root.osc-control-error && root.osc-control-counts != "": Text {
                      height: 19px;
                      text: root.osc-control-counts;
                      color: Wf.ink;
                      font-family: Wf.mono;
                      font-size: 14px;
                      horizontal-alignment: right;
                      vertical-alignment: center;
                      overflow: elide;
                    }
                  }
                }

                // Why listening was asked for and is not happening — a port another program
                // holds — on a line of its own.
                if root.osc-control-error: Alarm {
                  height: 18px;
                  text: root.osc-control-reading;
                }
              }
              }
            }
          }

          // --- 03 outputs --------------------------------------------------------------
          // Everything takt4 sends to, one row each and every row the same shape: Link and the
          // MIDI clocks are rows like any OSC, MIDI or Art-Net target. A row's tick is what the
          // operator asked for; the peer count and the beat count are what is happening, and an
          // output that is on with nothing at the other end is the failure to see at a gig.
          outputs-sheet := Rectangle {
            background: Wf.sheet;
            vertical-stretch: 0;

            property <bool> link-on: root.outputs-list.length > 0 && root.outputs-list[0].kind-index == 4
              && root.outputs-list[0].enabled;
            property <string> summary: (root.outputs-failing > 0
                ? root.outputs-failing + (root.outputs-failing == 1 ? " output" : " outputs") + " reaching nothing · "
                : "")
              + root.outputs-on + " of " + root.outputs-list.length + " on · Link: "
              + (!self.link-on ? "off" : root.link-peers == 1 ? "1 peer" : root.link-peers + " peers")
              + " · " + root.beats-sent + " beats sent";

            VerticalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: root.outputs-folded ? 6px : 10px;
              padding-bottom: root.outputs-folded ? 6px : 12px;
              spacing: 0px;

              SectionHead {
                number: "03";
                title: "outputs";
                folds: true;
                folded: root.outputs-folded;
                summary: outputs-sheet.summary;
                summary-color: root.outputs-failing > 0 ? Wf.alarm : Wf.ink2;
                fold-clicked => {
                  root.fold-clicked(1);
                }
              }

              // Clipped away when folded, not removed: see Inputs.
              Rectangle {
                height: root.outputs-folded ? 0px : outputs-body.preferred-height;
                clip: true;
              outputs-body := VerticalLayout {
                y: 0;
                width: parent.width;
                padding-top: 8px;
                spacing: 8px;

                // What went wrong on the way out, under the heading it is about.
                if root.output-trouble != "": Text {
                  height: 18px;
                  text: root.output-trouble;
                  color: Wf.holding;
                  font-size: 13px;
                  horizontal-alignment: right;
                  vertical-alignment: center;
                  overflow: elide;
                }

                // **The column headings, and they are not decoration** — a filled-in row is
                // "RDM10", "127.0.0.1", "6454" with nothing saying which is which (2026-09-16:
                // "LABEL UI ELEMENTS!! humans arent psychcic"). Centred over their columns, which
                // have the rows' own widths: on 30 · name 90 · protocol 106 · host / device the
                // rest · port 58 · delay 239 · delete 24, 6 px apart (HANDOFF §0.5).
                if root.outputs-list.length > 0: HorizontalLayout {
                  height: 18px;
                  spacing: 6px;
                  for heading in [
                    { text: "on", width: 30px },
                    { text: "name", width: 90px },
                    { text: "protocol", width: 106px },
                  ]: Text {
                    width: heading.width;
                    text: heading.text;
                    color: Wf.ink2;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                  }
                  Text {
                    horizontal-stretch: 1;
                    min-width: 100px;
                    text: "host / device";
                    color: Wf.ink2;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                  }
                  Text {
                    width: 58px;
                    text: "port";
                    color: Wf.ink2;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                  }
                  Text {
                    width: 239px;
                    text: "this output's own delay";
                    color: Wf.ink2;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                  }
                  Rectangle { width: 24px; }
                }

                for target[index] in root.outputs-list: VerticalLayout {
                  spacing: 0px;

                  HorizontalLayout {
                    height: target.kind-index == 4 ? 28px : 34px;
                    spacing: 6px;

                    // §5.6's per-target switch: off keeps the row and its address, because an
                    // operator killing one feed mid-set wants it back afterwards.
                    HorizontalLayout {
                      width: 30px;
                      alignment: center;
                      Tick {
                        checked: target.enabled;
                        toggled(on) => {
                          root.output-enabled-changed(index, on);
                        }
                      }
                    }

                    // **Link's row is fixed**: there is only ever one Link, so its name and its
                    // protocol are words rather than boxes, and it has no remove button.
                    if target.kind-index == 4: Text {
                      width: 90px;
                      text: "Link";
                      color: Wf.ink;
                      font-size: 15px;
                      horizontal-alignment: center;
                      vertical-alignment: center;
                    }
                    if target.kind-index != 4: Entry {
                      width: 90px;
                      value: target.name;
                      placeholder: "name";
                      font-size: 14px;
                      pad: 8px;
                      typed(text) => {
                        root.output-name-edited(index, text);
                      }
                      committed(text) => {
                        root.output-name-accepted(index, text);
                      }
                    }

                    if target.kind-index == 4: Text {
                      width: 106px;
                      text: "Link";
                      color: Wf.ink;
                      font-size: 15px;
                      horizontal-alignment: center;
                      vertical-alignment: center;
                    }
                    // The kind, asked first, because it decides what the rest of the row asks.
                    // The chevron pulled in so "MIDI clock" fits 106 px whole.
                    if target.kind-index != 4: Pick {
                      width: 106px;
                      model: root.output-kinds;
                      current-index: target.kind-index;
                      font-size: 14px;
                      pad-left: 8px;
                      pad-right: 26px;
                      chevron-right: 10px;
                      selected(kind) => {
                        root.output-kind-changed(index, kind);
                      }
                    }

                    // The destination. `if`, not `visible`: a hidden element still takes its
                    // layout space, so each shape would reserve room for the other.
                    if target.kind-index == 0 || target.kind-index == 2: Entry {
                      horizontal-stretch: 1;
                      min-width: 100px;
                      value: target.host;
                      placeholder: "127.0.0.1";
                      font-family: Wf.mono;
                      font-size: 14px;
                      pad: 8px;
                      typed(text) => {
                        root.output-host-edited(index, text);
                      }
                      committed(text) => {
                        root.output-host-accepted(index, text);
                      }
                    }
                    if target.kind-index == 0 || target.kind-index == 2: Entry {
                      width: 58px;
                      value: target.port;
                      placeholder: target.kind-index == 2 ? "6454" : "9000";
                      font-family: Wf.mono;
                      font-size: 14px;
                      pad: 6px;
                      typed(text) => {
                        root.output-port-edited(index, text);
                      }
                      committed(text) => {
                        root.output-port-accepted(index, text);
                      }
                    }

                    // The machine's own devices, never a name to be typed: nobody knows what
                    // their interface enumerated as, and a mistyped one sends nowhere.
                    if target.kind-index == 1 || target.kind-index == 3: Pick {
                      horizontal-stretch: 1;
                      min-width: 100px;
                      model: root.output-devices;
                      current-index: target.device-index;
                      font-size: 14px;
                      pad-left: 8px;
                      pad-right: 26px;
                      chevron-right: 10px;
                      selected(device) => {
                        root.output-device-picked(index, device);
                      }
                    }
                    if target.kind-index == 1 || target.kind-index == 3: Rectangle { width: 58px; }

                    // Link has no destination to ask for: it finds its peers by itself. What goes
                    // here is how many, because "on with nobody there" is the state to see — and
                    // the button that lists them under the row.
                    if target.kind-index == 4: HorizontalLayout {
                      horizontal-stretch: 1;
                      min-width: 100px;
                      padding-left: 9px;
                      spacing: 10px;
                      alignment: start;
                      Text {
                        text: !target.enabled ? "off"
                          : root.link-peers == 0 ? "no peers"
                          : root.link-peers == 1 ? "1 peer"
                          : root.link-peers + " peers";
                        color: root.link-peers > 0 && target.enabled ? Wf.locked : Wf.ink2;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                      }
                      VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Btn {
                          text: root.link-peers-shown ? "hide peers" : "show peers";
                          // Always closable once open, even when the last peer has just left.
                          enabled: target.enabled && (root.link-peers > 0 || root.link-peers-shown);
                          height: 28px;
                          font-size: 13px;
                          pad: 10px;
                          clicked => {
                            root.link-peers-toggled();
                          }
                        }
                      }
                    }
                    if target.kind-index == 4: Rectangle { width: 58px; }

                    // §5.5's latency offset, per target: the thing on the end of each cable has its
                    // own lag. The slider, and what it is set to beside it — clicked, it takes a
                    // typed number, because a slider is how an offset is found by ear and a number
                    // is how one is copied from a spec sheet.
                    HorizontalLayout {
                      width: 239px;
                      spacing: 12px;
                      Track {
                        value: target.delay-ms;
                        minimum: -root.output-delay-limit-ms;
                        maximum: root.output-delay-limit-ms;
                        step: 1;
                        enabled: target.enabled;
                        moved(v) => {
                          root.output-delay-changed(index, v);
                        }
                      }
                      Reading {
                        width: 59px;
                        text: (target.delay-ms > 0 ? "+" : "") + round(target.delay-ms) + " ms";
                        value-text: round(target.delay-ms);
                        enabled: target.enabled;
                        committed(text) => {
                          root.output-delay-typed(index, text);
                        }
                      }
                    }

                    // Link is switched off, never removed; its column keeps its width so the rows
                    // below line up.
                    if target.kind-index == 4: Rectangle { width: 24px; }
                    if target.kind-index != 4: VerticalLayout {
                      width: 24px;
                      alignment: center;
                      Btn {
                        text: "×";
                        width: 24px;
                        height: 24px;
                        font-size: 14px;
                        pad: 0px;
                        clicked => {
                          // The keyboard back to the window **first**: this button is about to be
                          // destroyed with its row, and the focus it took would go with it —
                          // leaving Escape reaching nothing until the next click.
                          keys.focus();
                          root.output-removed(index);
                        }
                      }
                    }
                  }

                  // **Why this output reaches nothing, under it, for as long as that is so.**
                  // Under the name column, so it reads as the row's. An explicit height: an `if`
                  // in a vertical layout otherwise takes a share of the spare height.
                  if target.problem != "": HorizontalLayout {
                    height: 22px;
                    padding-left: 36px;
                    Alarm {
                      text: target.problem;
                    }
                  }

                  // The peers, under the Link row while "show peers" is lit: what each announces —
                  // an address, a tempo, whether it is in this session, and whether it is playing
                  // (only a peer that shares start and stop says so). From the table's left edge,
                  // each column only as wide as what is in it and 28 px apart, so the list ends
                  // before the delay sliders begin (HANDOFF §0.5) — a grid, which sizes a column to
                  // its widest cell, beside a spacer that takes the rest of the row. A peer with
                  // several addresses has them elided at 180 px rather than pushing the list on.
                  if target.kind-index == 4 && root.link-peers-shown: HorizontalLayout {
                    padding-top: 10px;
                    padding-bottom: 8px;
                    height: 10px + 16px + root.link-peer-list.length * 21px + 8px;

                    GridLayout {
                      horizontal-stretch: 0;
                      spacing-horizontal: 28px;
                      spacing-vertical: 3px;

                      Row {
                        Text { text: "address"; height: 16px; color: Wf.ink2; font-size: 13px; vertical-alignment: center; }
                        Text { text: "tempo"; height: 16px; color: Wf.ink2; font-size: 13px; vertical-alignment: center; }
                        Text { text: "session"; height: 16px; color: Wf.ink2; font-size: 13px; vertical-alignment: center; }
                        Text { text: "transport"; height: 16px; color: Wf.ink2; font-size: 13px; vertical-alignment: center; }
                      }

                      for peer in root.link-peer-list: Row {
                        Text { text: peer.address; height: 18px; max-width: 180px; color: Wf.ink; font-family: Wf.mono; font-size: 14px; vertical-alignment: center; overflow: elide; }
                        Text { text: peer.tempo; height: 18px; color: Wf.ink; font-family: Wf.mono; font-size: 14px; vertical-alignment: center; }
                        Text {
                          text: peer.same-session ? "this session" : "another session";
                          height: 18px;
                          color: peer.same-session ? Wf.locked : Wf.holding;
                          font-size: 14px;
                          vertical-alignment: center;
                        }
                        Text { text: peer.transport; height: 18px; color: Wf.ink; font-size: 14px; vertical-alignment: center; }
                      }
                    }
                    Rectangle { horizontal-stretch: 1; }
                  }
                }

                HorizontalLayout {
                  padding-top: 4px;
                  height: 32px;
                  spacing: 12px;
                  VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Btn {
                      text: "+ add output";
                      height: 28px;
                      font-size: 13px;
                      pad: 10px;
                      clicked => {
                        root.output-added();
                      }
                    }
                  }
                  Text {
                    text: root.outputs-list.length == 0
                      ? "nothing is being sent — add a media server or a lighting desk" : "";
                    color: Wf.ink2;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                  }
                  // What has actually gone out. Nothing else on screen tells an output that is
                  // configured from one that is working.
                  Text {
                    text: root.beats-sent > 0 ? root.beats-sent + " beats sent" : "";
                    color: Wf.ink2;
                    font-family: Wf.mono;
                    font-size: 14px;
                    horizontal-stretch: 0;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                  }
                }
              }
              }
            }
          }
        }
      }

      // --- pinned: the triggers row and the status bar --------------------------------
      // PANIC is pressed in a hurry — §5.9 keeps it out of the editor for that reason, and
      // having to find it by scrolling would give the reason back — and the status line is
      // where an error and the build number are said.
      pinned := VerticalLayout {
        vertical-stretch: 0;
        spacing: 0px;

        // --- 04 triggers ---------------------------------------------------------------
        // No heading: the row starts with its own name. The editor opens from here; PANIC
        // does not, because a halt that needed a window opened first would not be a halt.
        HorizontalLayout {
          padding-left: 10px;
          padding-right: 10px;
          padding-top: 10px;

          Rectangle {
            height: 66px;
            background: Wf.sheet;

            HorizontalLayout {
              padding-left: 16px;
              padding-right: 16px;
              padding-top: 10px;
              padding-bottom: 10px;
              spacing: 10px;

              HorizontalLayout {
                spacing: 10px;
                horizontal-stretch: 0;
                padding-right: 4px;
                Text {
                  text: "04";
                  color: Wf.red;
                  font-size: 14px;
                  font-weight: 800;
                  vertical-alignment: center;
                }
                Text {
                  text: "triggers";
                  color: Wf.ink;
                  font-size: 18px;
                  font-weight: 800;
                  letter-spacing: -0.36px;
                  vertical-alignment: center;
                }
              }

              // **A button says what it does; the count beside it is a reading** (a
              // readout is not a setting). These were the counts themselves, "2 of 3 active" and
              // "5 fixtures", so nothing on screen said where the rule editor or the patch was —
              // the README's "click add a rule" matched no button an operator with rules could
              // see (2026-09-30). "add a rule" while there are none, because then it adds one.
              VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                rules-button := Btn {
                  text: root.rules-total == 0 ? "add a rule" : "edit rules";
                  font-size: 14px;
                  pad: 12px;
                  clicked => {
                    root.rules-clicked();
                  }
                }
              }
              if root.rules-total > 0: Text {
                text: root.rules-active + " of " + root.rules-total + " active";
                color: Wf.ink2;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 0;
              }

              // The lighting patch, beside the rules because a DMX rule is meaningless without one.
              // It says how many fixtures there are, so "no patch" and "patch not open" differ.
              VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                fixtures-button := Btn {
                  text: "patch lights";
                  font-size: 14px;
                  pad: 12px;
                  clicked => {
                    root.fixtures-clicked();
                  }
                }
              }
              if root.fixtures-total > 0: Text {
                text: root.fixtures-total + (root.fixtures-total == 1 ? " fixture" : " fixtures");
                color: Wf.ink2;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 0;
              }

              // What just went out, so the main window says whether the rig is being driven
              // without the editor being open. §5.9's last-fired line, one rig-wide copy.
              Text {
                text: root.rules-last-fired;
                color: Wf.ink;
                font-family: Wf.mono;
                font-size: 14px;
                horizontal-stretch: 1;
                min-width: 40px;
                vertical-alignment: center;
                overflow: elide;
              }

              // **PANIC only ever engages; RELEASE is its own button** — the audit's H18. It
              // appears to the *left*, so PANIC does not move when it does: the second click of
              // a double-click lands on PANIC again, which is already engaged, and does nothing.
              if root.panicked: Btn {
                text: "release";
                height: 46px;
                font-size: 19px;
                pad: 16px;
                clicked => {
                  // The keyboard back to the window first, because this button goes the moment
                  // it works and would take the focus with it — and the next Escape, the one
                  // that matters, would then reach nothing.
                  keys.focus();
                  root.panic-released();
                }
              }

              panic-button := Btn {
                text: root.panicked ? "panicked" : "panic";
                hint: "Esc";
                danger: true;
                engaged: root.panicked;
                height: 46px;
                min-width: 160px;
                font-size: 22px;
                pad: 16px;
                keycap-size: 20px;
                clicked => {
                  root.panic-clicked();
                }
              }
            }
          }
        }

        // --- the status bar ------------------------------------------------------------
        // Two lines, always, so the rows above do not move as the status changes length: what
        // the input is on the first, and the latency figures on a line of their own (asked for
        // on 2026-09-29). The version and the buttons about the whole rig at the right.
        status-bar := Rectangle {
          height: 51px;
          background: Wf.page;

          HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 9px;
            spacing: 8px;

            Text {
              horizontal-stretch: 1;
              min-width: 60px;
              text: root.status;
              color: root.status-is-error ? Wf.holding : Wf.ink2;
              font-size: 13px;
              vertical-alignment: center;
              // Two lines before it elides; the longest messages are the ones that say what to do.
              // The first line is always the one kept (the audit of 2026-09-25, M12).
              wrap: word-wrap;
              max-lines: 2;
              overflow: elide;
            }

            Text {
              text: root.version-short != "" ? root.version-short : root.version;
              color: Wf.ink2;
              font-family: Wf.mono;
              font-size: 13px;
              horizontal-stretch: 0;
              horizontal-alignment: left;
              vertical-alignment: center;
            }

            // Saving, which until 2026-09-12 happened only when the window closed ("I am scared
            // of closing it"), and the two file routes. With ABOUT, one size, in the corner.
            for action[i] in ["save", "export", "import", "about"]: VerticalLayout {
              alignment: center;
              horizontal-stretch: 0;
              Btn {
                text: action;
                height: 28px;
                font-size: 13px;
                pad: 10px;
                clicked => {
                  if (i == 0) {
                    root.save-now();
                  } else if (i == 1) {
                    root.export-settings();
                  } else if (i == 2) {
                    root.import-settings();
                  } else {
                    root.about-opened();
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
